.version 8.8
.target sm_120
.address_size 64

// Float to integer in each rounding, unsigned and signed, flushed or not:
// ptxas's F2I always carries .NTZ (NaN to 0; without it the RTX 5070
// gives NaN as 0x80000000, signed or not).
.visible .entry ops_cvt_int(.param .u64 io)
{
    .reg .b32 %r<18>;
    .reg .b64 %rd<5>;
    .reg .f32 %f<2>;

    ld.param.u64 %rd1, [io];
    mov.u32 %r1, %tid.x;
    mul.wide.u32 %rd2, %r1, 64;
    add.s64 %rd3, %rd1, %rd2;
    ld.global.f32 %f1, [%rd3];
    cvt.rni.sat.u32.f32 %r2, %f1;
    cvt.rzi.sat.u32.f32 %r3, %f1;
    cvt.rmi.sat.u32.f32 %r4, %f1;
    cvt.rpi.sat.u32.f32 %r5, %f1;
    cvt.rni.sat.s32.f32 %r6, %f1;
    cvt.rzi.sat.s32.f32 %r7, %f1;
    cvt.rmi.sat.s32.f32 %r8, %f1;
    cvt.rpi.sat.s32.f32 %r9, %f1;
    cvt.rni.ftz.sat.u32.f32 %r10, %f1;
    cvt.rzi.ftz.sat.u32.f32 %r11, %f1;
    cvt.rmi.ftz.sat.u32.f32 %r12, %f1;
    cvt.rpi.ftz.sat.u32.f32 %r13, %f1;
    cvt.rni.ftz.sat.s32.f32 %r14, %f1;
    cvt.rzi.ftz.sat.s32.f32 %r15, %f1;
    cvt.rmi.ftz.sat.s32.f32 %r16, %f1;
    cvt.rpi.ftz.sat.s32.f32 %r17, %f1;
    st.global.v4.u32 [%rd3+0], {%r2, %r3, %r4, %r5};
    st.global.v4.u32 [%rd3+16], {%r6, %r7, %r8, %r9};
    st.global.v4.u32 [%rd3+32], {%r10, %r11, %r12, %r13};
    st.global.v4.u32 [%rd3+48], {%r14, %r15, %r16, %r17};
    ret;
}
