    0x01ee54 << 2 | 1, 0x01ee55 << 2 | 0, 0x01ee57 << 2 | 1, 0x01ee58 << 2 | 0, 0x01ee59 << 2 | 1, 0x01ee5a << 2 | 0,
    0x01ee5b << 2 | 1, 0x01ee5c << 2 | 0, 0x01ee5d << 2 | 1, 0x01ee5e << 2 | 0, 0x01ee5f << 2 | 1, 0x01ee60 << 2 | 0,
    0x01ee61 << 2 | 1, 0x01ee63 << 2 | 0, 0x01ee64 << 2 | 1, 0x01ee65 << 2 | 0, 0x01ee67 << 2 | 1, 0x01ee6b << 2 | 0,
