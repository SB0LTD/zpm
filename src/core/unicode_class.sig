    0x01f100 << 2 | 2, 0x01f10d << 2 | 0, 0x01fbf0 << 2 | 2, 0x01fbfa << 2 | 0, 0x020000 << 2 | 1, 0x02a6e0 << 2 | 0,
    0x02a700 << 2 | 1, 0x02b73a << 2 | 0, 0x02b740 << 2 | 1, 0x02b81e << 2 | 0, 0x02b820 << 2 | 1, 0x02cea2 << 2 | 0,
    0x02ceb0 << 2 | 1, 0x02ebe1 << 2 | 0, 0x02ebf0 << 2 | 1, 0x02ee5e << 2 | 0, 0x02f800 << 2 | 1, 0x02fa1e << 2 | 0,
