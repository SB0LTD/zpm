pub const Class = enum(u2) { other = 0, letter = 1, number = 2 };

pub const MAX_CODEPOINT: u32 = 0x10ffff;

/// Class of a scalar value. Values past MAX_CODEPOINT are `other`.
pub fn classify(codepoint: u32) Class {
    if (codepoint > MAX_CODEPOINT) return .other;
