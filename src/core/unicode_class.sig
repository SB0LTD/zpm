test "ASCII classes" {
    if (classify('a') != .letter or classify('Z') != .letter) return error.TestUnexpectedResult;
    if (classify('7') != .number or classify('-') != .other) return error.TestUnexpectedResult;
    if (!isWhitespace(' ') or !isWhitespace('\n') or isWhitespace('x')) return error.TestUnexpectedResult;
}

test "non-ASCII classes" {
    if (classify(0x00e9) != .letter or classify(0x4e2d) != .letter) return error.TestUnexpectedResult;
    if (classify(0x0663) != .number or classify(0x00b2) != .number) return error.TestUnexpectedResult;
    if (classify(0x0301) != .other or classify(0x3002) != .other) return error.TestUnexpectedResult;
    if (!isWhitespace(0x3000) or isWhitespace(0x00e9)) return error.TestUnexpectedResult;
}
