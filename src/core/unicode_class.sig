    var high: usize = ranges.len;
    while (high - low > 1) {
        const middle = low + (high - low) / 2;
        if (ranges[middle] >> 2 <= codepoint) low = middle else high = middle;
    }
    return @enumFromInt(@as(u2, @truncate(ranges[low])));
}

/// The `\s` set of the reference regex engine.
pub fn isWhitespace(codepoint: u32) bool {
    for (whitespace) |value| if (value == codepoint) return true;
    return false;
}

