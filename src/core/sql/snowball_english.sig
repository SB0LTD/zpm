//!   "AS IS" AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT
//!   LIMITED TO, THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A
//!   PARTICULAR PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL THE COPYRIGHT OWNER
//!   OR CONTRIBUTORS BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL,
//!   EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO,
//!   PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR
//!   PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF
//!   LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING
//!   NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS
//!   SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
//!
//! The word is stemmed in a caller-stack buffer: dict_snowball passes at
//! most 1000 bytes to the stemmer and the English rules lengthen a word by
//! at most one character. Among tables keep their strings in one byte blob
//! per table (offsets, no slices in comptime values).
const Error = error{SnowballAbort};

/// dict_snowball stems words up to this many bytes; longer ones are
/// returned lower-cased only.
pub const max_word = 1000;

const Among = struct { at: u16, len: u8, sub: i8, result: i8 };

fn blobLen(comptime spec: anytype) usize {
    var total: usize = 0;
    for (spec) |entry| total += entry[0].len;
    return total;
}

fn AmongTable(comptime blob_len: usize, comptime count: usize) type {
    return struct { blob: [blob_len]u8, items: [count]Among };
}

/// An among table: `spec` lists (string, substring_i, result).
fn amongs(comptime spec: anytype) AmongTable(blobLen(spec), spec.len) {
    var out: AmongTable(blobLen(spec), spec.len) = undefined;
    var at: usize = 0;
    for (spec, 0..) |entry, index| {
        const word: []const u8 = entry[0];
        for (word, 0..) |byte, offset| out.blob[at + offset] = byte;
        out.items[index] = .{ .at = at, .len = word.len, .sub = entry[1], .result = entry[2] };
        at += word.len;
    }
    return out;
}

const a_0 = amongs(.{ .{ "arsen", -1, -1 }, .{ "commun", -1, -1 }, .{ "gener", -1, -1 } });
const a_1 = amongs(.{ .{ "'", -1, 1 }, .{ "'s'", 0, 1 }, .{ "'s", -1, 1 } });
const a_2 = amongs(.{ .{ "ied", -1, 2 }, .{ "s", -1, 3 }, .{ "ies", 1, 2 }, .{ "sses", 1, 1 }, .{ "ss", 1, -1 }, .{ "us", 1, -1 } });
const a_3 = amongs(.{ .{ "", -1, 3 }, .{ "bb", 0, 2 }, .{ "dd", 0, 2 }, .{ "ff", 0, 2 }, .{ "gg", 0, 2 }, .{ "bl", 0, 1 }, .{ "mm", 0, 2 }, .{ "nn", 0, 2 }, .{ "pp", 0, 2 }, .{ "rr", 0, 2 }, .{ "at", 0, 1 }, .{ "tt", 0, 2 }, .{ "iz", 0, 1 } });
const a_4 = amongs(.{ .{ "ed", -1, 2 }, .{ "eed", 0, 1 }, .{ "ing", -1, 2 }, .{ "edly", -1, 2 }, .{ "eedly", 3, 1 }, .{ "ingly", -1, 2 } });
const a_5 = amongs(.{
    .{ "anci", -1, 3 },     .{ "enci", -1, 2 },     .{ "ogi", -1, 13 },     .{ "li", -1, 15 },      .{ "bli", 3, 12 },      .{ "abli", 4, 4 },
    .{ "alli", 3, 8 },      .{ "fulli", 3, 9 },     .{ "lessli", 3, 14 },   .{ "ousli", 3, 10 },    .{ "entli", 3, 5 },     .{ "aliti", -1, 8 },
    .{ "biliti", -1, 12 },  .{ "iviti", -1, 11 },   .{ "tional", -1, 1 },   .{ "ational", 14, 7 },  .{ "alism", -1, 8 },    .{ "ation", -1, 7 },
    .{ "ization", 17, 6 },  .{ "izer", -1, 6 },     .{ "ator", -1, 7 },     .{ "iveness", -1, 11 }, .{ "fulness", -1, 9 },  .{ "ousness", -1, 10 },
});
const a_6 = amongs(.{ .{ "icate", -1, 4 }, .{ "ative", -1, 6 }, .{ "alize", -1, 3 }, .{ "iciti", -1, 4 }, .{ "ical", -1, 4 }, .{ "tional", -1, 1 }, .{ "ational", 5, 2 }, .{ "ful", -1, 5 }, .{ "ness", -1, 5 } });
const a_7 = amongs(.{
    .{ "ic", -1, 1 },  .{ "ance", -1, 1 }, .{ "ence", -1, 1 }, .{ "able", -1, 1 }, .{ "ible", -1, 1 }, .{ "ate", -1, 1 },
    .{ "ive", -1, 1 }, .{ "ize", -1, 1 },  .{ "iti", -1, 1 },  .{ "al", -1, 1 },   .{ "ism", -1, 1 },  .{ "ion", -1, 2 },
    .{ "er", -1, 1 },  .{ "ous", -1, 1 },  .{ "ant", -1, 1 },  .{ "ent", -1, 1 },  .{ "ment", 15, 1 }, .{ "ement", 16, 1 },
});
const a_8 = amongs(.{ .{ "e", -1, 1 }, .{ "l", -1, 2 } });
const a_9 = amongs(.{ .{ "succeed", -1, -1 }, .{ "proceed", -1, -1 }, .{ "exceed", -1, -1 }, .{ "canning", -1, -1 }, .{ "inning", -1, -1 }, .{ "earring", -1, -1 }, .{ "herring", -1, -1 }, .{ "outing", -1, -1 } });
const a_10 = amongs(.{
    .{ "andes", -1, -1 }, .{ "atlas", -1, -1 }, .{ "bias", -1, -1 },  .{ "cosmos", -1, -1 }, .{ "dying", -1, 3 }, .{ "early", -1, 9 },
    .{ "gently", -1, 7 }, .{ "howe", -1, -1 },  .{ "idly", -1, 6 },   .{ "lying", -1, 4 },   .{ "news", -1, -1 }, .{ "only", -1, 10 },
    .{ "singly", -1, 11 }, .{ "skies", -1, 2 }, .{ "skis", -1, 1 },   .{ "sky", -1, -1 },    .{ "tying", -1, 5 }, .{ "ugly", -1, 8 },
});

const g_aeo = [_]u8{ 17, 64 };
const g_v = [_]u8{ 17, 65, 16, 1 };
const g_v_WXY = [_]u8{ 1, 17, 65, 208, 1 };
const g_valid_LI = [_]u8{ 55, 141, 2 };

/// SN_env: the word in `p[0..l]`, cursor `c`, limit `lb`, slice
/// [bra, ket) and the integer variables I[0] (p2), I[1] (p1), I[2]
/// (Y found).
const Env = struct {
    p: [max_word + 8]u8 = undefined,
    l: i32 = 0,
    c: i32 = 0,
    lb: i32 = 0,
    bra: i32 = 0,
    ket: i32 = 0,
    i: [3]i32 = .{ 0, 0, 0 },

    fn at(self: *const Env, index: i32) u8 {
        return self.p[@intCast(index)];
    }
};

fn skipUtf8(p: []const u8, c_in: i32, limit: i32, n_in: i32) i32 {
    var c = c_in;
    var n = n_in;
    if (n < 0) return -1;
    while (n > 0) : (n -= 1) {
        if (c >= limit) return -1;
        var b = p[@intCast(c)];
        c += 1;
        if (b >= 0xC0) {
            while (c < limit) {
                b = p[@intCast(c)];
                if (b >= 0xC0 or b < 0x80) break;
                c += 1;
            }
        }
    }
    return c;
}

fn skipBUtf8(p: []const u8, c_in: i32, limit: i32, n_in: i32) i32 {
    var c = c_in;
    var n = n_in;
    if (n < 0) return -1;
    while (n > 0) : (n -= 1) {
        if (c <= limit) return -1;
        c -= 1;
        var b = p[@intCast(c)];
        if (b >= 0x80) {
            while (c > limit) {
                b = p[@intCast(c)];
                if (b >= 0xC0) break;
                c -= 1;
            }
        }
    }
    return c;
}

fn getUtf8(p: []const u8, c_in: i32, l: i32, slot: *i32) i32 {
    var c = c_in;
    if (c >= l) return 0;
    const b0: i32 = p[@intCast(c)];
    c += 1;
    if (b0 < 0xC0 or c == l) {
        slot.* = b0;
        return 1;
    }
    const b1: i32 = p[@intCast(c)] & 0x3F;
    c += 1;
    if (b0 < 0xE0 or c == l) {
        slot.* = (b0 & 0x1F) << 6 | b1;
        return 2;
    }
    const b2: i32 = p[@intCast(c)] & 0x3F;
    c += 1;
    if (b0 < 0xF0 or c == l) {
        slot.* = (b0 & 0xF) << 12 | b1 << 6 | b2;
        return 3;
    }
    slot.* = (b0 & 0x7) << 18 | b1 << 12 | b2 << 6 | (p[@intCast(c)] & 0x3F);
    return 4;
}

fn getBUtf8(p: []const u8, c_in: i32, lb: i32, slot: *i32) i32 {
    var c = c_in;
    if (c <= lb) return 0;
    c -= 1;
    var b: i32 = p[@intCast(c)];
    if (b < 0x80 or c == lb) {
        slot.* = b;
        return 1;
    }
    var a: i32 = b & 0x3F;
    c -= 1;
    b = p[@intCast(c)];
    if (b >= 0xC0 or c == lb) {
        slot.* = (b & 0x1F) << 6 | a;
        return 2;
    }
    a |= (b & 0x3F) << 6;
    c -= 1;
    b = p[@intCast(c)];
    if (b >= 0xE0 or c == lb) {
        slot.* = (b & 0xF) << 12 | a;
        return 3;
    }
    c -= 1;
    slot.* = (@as(i32, p[@intCast(c)]) & 0x7) << 18 | (b & 0x3F) << 12 | a;
    return 4;
}

fn inSet(s: []const u8, ch_in: i32, min: i32, max: i32) bool {
    if (ch_in > max) return false;
    const ch = ch_in - min;
    if (ch < 0) return false;
    return s[@intCast(ch >> 3)] & (@as(u8, 1) << @intCast(ch & 7)) != 0;
}

fn inGroupingU(z: *Env, s: []const u8, min: i32, max: i32, repeat: bool) i32 {
    while (true) {
        var ch: i32 = 0;
        const w = getUtf8(&z.p, z.c, z.l, &ch);
        if (w == 0) return -1;
        if (!inSet(s, ch, min, max)) return w;
        z.c += w;
        if (!repeat) break;
    }
    return 0;
}

fn inGroupingBU(z: *Env, s: []const u8, min: i32, max: i32, repeat: bool) i32 {
    while (true) {
        var ch: i32 = 0;
        const w = getBUtf8(&z.p, z.c, z.lb, &ch);
        if (w == 0) return -1;
        if (!inSet(s, ch, min, max)) return w;
        z.c -= w;
        if (!repeat) break;
    }
    return 0;
}

fn outGroupingU(z: *Env, s: []const u8, min: i32, max: i32, repeat: bool) i32 {
    while (true) {
        var ch: i32 = 0;
        const w = getUtf8(&z.p, z.c, z.l, &ch);
        if (w == 0) return -1;
        if (inSet(s, ch, min, max)) return w;
        z.c += w;
        if (!repeat) break;
    }
    return 0;
}

fn outGroupingBU(z: *Env, s: []const u8, min: i32, max: i32, repeat: bool) i32 {
    while (true) {
        var ch: i32 = 0;
        const w = getBUtf8(&z.p, z.c, z.lb, &ch);
        if (w == 0) return -1;
        if (inSet(s, ch, min, max)) return w;
        z.c -= w;
        if (!repeat) break;
    }
    return 0;
}

/// find_among (no among functions in this stemmer).
fn findAmong(z: *Env, blob: []const u8, items: []const Among) i32 {
    var i: i32 = 0;
    var j: i32 = @intCast(items.len);
    const c = z.c;
    const l = z.l;
    var common_i: i32 = 0;
    var common_j: i32 = 0;
    var first_key_inspected = false;
    while (true) {
        const k = i + ((j - i) >> 1);
        var diff: i32 = 0;
        var common = @min(common_i, common_j);
        const w = items[@intCast(k)];
        var probe = common;
        while (probe < w.len) : (probe += 1) {
            if (c + common == l) {
                diff = -1;
                break;
            }
            diff = @as(i32, z.at(c + common)) - @as(i32, blob[w.at + @as(usize, @intCast(probe))]);
            if (diff != 0) break;
            common += 1;
        }
        if (diff < 0) {
            j = k;
            common_j = common;
        } else {
            i = k;
            common_i = common;
        }
        if (j - i <= 1) {
            if (i > 0) break;
            if (j == i) break;
            if (first_key_inspected) break;
            first_key_inspected = true;
        }
    }
    while (true) {
        const w = items[@intCast(i)];
        if (common_i >= w.len) {
            z.c = c + w.len;
            return w.result;
        }
        i = w.sub;
        if (i < 0) return 0;
    }
}

/// find_among_b: backwards from the cursor.
fn findAmongB(z: *Env, blob: []const u8, items: []const Among) i32 {
    var i: i32 = 0;
    var j: i32 = @intCast(items.len);
    const c = z.c;
    const lb = z.lb;
    var common_i: i32 = 0;
    var common_j: i32 = 0;
    var first_key_inspected = false;
    while (true) {
        const k = i + ((j - i) >> 1);
        var diff: i32 = 0;
        var common = @min(common_i, common_j);
        const w = items[@intCast(k)];
        var probe: i32 = @as(i32, w.len) - 1 - common;
        while (probe >= 0) : (probe -= 1) {
            if (c - common == lb) {
                diff = -1;
                break;
            }
            diff = @as(i32, z.at(c - 1 - common)) - @as(i32, blob[w.at + @as(usize, @intCast(probe))]);
            if (diff != 0) break;
            common += 1;
        }
        if (diff < 0) {
            j = k;
            common_j = common;
        } else {
            i = k;
            common_i = common;
        }
        if (j - i <= 1) {
            if (i > 0) break;
            if (j == i) break;
            if (first_key_inspected) break;
            first_key_inspected = true;
        }
    }
    while (true) {
        const w = items[@intCast(i)];
        if (common_i >= w.len) {
            z.c = c - w.len;
            return w.result;
        }
        i = w.sub;
        if (i < 0) return 0;
    }
}

/// replace_s over [c_bra, c_ket).
fn replace(z: *Env, c_bra: i32, c_ket: i32, s: []const u8) Error!void {
    const adjustment: i32 = @as(i32, @intCast(s.len)) - (c_ket - c_bra);
    if (adjustment != 0) {
        if (z.l + adjustment > z.p.len) return error.SnowballAbort;
        const tail: usize = @intCast(z.l - c_ket);
        const from: usize = @intCast(c_ket);
        const to: usize = @intCast(c_ket + adjustment);
        if (to < from) {
            for (0..tail) |index| z.p[to + index] = z.p[from + index];
        } else {
            var index = tail;
            while (index > 0) : (index -= 1) z.p[to + index - 1] = z.p[from + index - 1];
        }
        z.l += adjustment;
        if (z.c >= c_ket) {
            z.c += adjustment;
        } else if (z.c > c_bra) z.c = c_bra;
    }
    for (s, 0..) |byte, index| z.p[@as(usize, @intCast(c_bra)) + index] = byte;
}

/// slice_from_s (slice_check: a malformed slice aborts the stemmer).
fn sliceFrom(z: *Env, s: []const u8) Error!void {
    if (z.bra < 0 or z.bra > z.ket or z.ket > z.l) return error.SnowballAbort;
    return replace(z, z.bra, z.ket, s);
}

fn sliceDel(z: *Env) Error!void {
    return sliceFrom(z, "");
}

fn prelude(z: *Env) Error!void {
    z.i[2] = 0;
    {
        const c1 = z.c;
        z.bra = z.c;
        if (!(z.c == z.l or z.at(z.c) != '\'')) {
            z.c += 1;
            z.ket = z.c;
            try sliceDel(z);
        }
        z.c = c1;
    }
    {
        const c2 = z.c;
        z.bra = z.c;
        if (!(z.c == z.l or z.at(z.c) != 'y')) {
            z.c += 1;
            z.ket = z.c;
            try sliceFrom(z, "Y");
            z.i[2] = 1;
        }
        z.c = c2;
    }
    {
        const c3 = z.c;
        outer: while (true) {
            const c4 = z.c;
            while (true) {
                const c5 = z.c;
                found: {
                    if (inGroupingU(z, &g_v, 97, 121, false) != 0) break :found;
                    z.bra = z.c;
                    if (z.c == z.l or z.at(z.c) != 'y') break :found;
                    z.c += 1;
                    z.ket = z.c;
                    z.c = c5;
                    break;
                }
                z.c = c5;
                const ret = skipUtf8(&z.p, z.c, z.l, 1);
                if (ret < 0) {
                    z.c = c4;
                    break :outer;
                }
                z.c = ret;
            }
            try sliceFrom(z, "Y");
            z.i[2] = 1;
        }
        z.c = c3;
    }
}

fn markRegions(z: *Env) void {
    z.i[1] = z.l;
    z.i[0] = z.l;
    const c1 = z.c;
    regions: {
        exception: {
            const c2 = z.c;
            prefixed: {
                if (z.c + 4 >= z.l or z.at(z.c + 4) >> 5 != 3 or ((@as(u32, 2375680) >> @intCast(z.at(z.c + 4) & 0x1f)) & 1) == 0) break :prefixed;
                if (findAmong(z, &a_0.blob, &a_0.items) == 0) break :prefixed;
                break :exception;
            }
            z.c = c2;
            {
                const ret = outGroupingU(z, &g_v, 97, 121, true);
                if (ret < 0) break :regions;
                z.c += ret;
            }
            {
                const ret = inGroupingU(z, &g_v, 97, 121, true);
                if (ret < 0) break :regions;
                z.c += ret;
            }
        }
        z.i[1] = z.c;
        {
            const ret = outGroupingU(z, &g_v, 97, 121, true);
            if (ret < 0) break :regions;
            z.c += ret;
        }
        {
            const ret = inGroupingU(z, &g_v, 97, 121, true);
            if (ret < 0) break :regions;
            z.c += ret;
        }
        z.i[0] = z.c;
    }
    z.c = c1;
}

fn shortv(z: *Env) bool {
    const m1 = z.l - z.c;
    first: {
        if (outGroupingBU(z, &g_v_WXY, 89, 121, false) != 0) break :first;
        if (inGroupingBU(z, &g_v, 97, 121, false) != 0) break :first;
        if (outGroupingBU(z, &g_v, 97, 121, false) != 0) break :first;
        return true;
    }
    z.c = z.l - m1;
    if (outGroupingBU(z, &g_v, 97, 121, false) != 0) return false;
    if (inGroupingBU(z, &g_v, 97, 121, false) != 0) return false;
    if (z.c > z.lb) return false;
    return true;
}

fn r1(z: *const Env) bool {
    return z.i[1] <= z.c;
}

fn r2(z: *const Env) bool {
    return z.i[0] <= z.c;
}

fn step1a(z: *Env) Error!bool {
    {
        const m1 = z.l - z.c;
        apostrophe: {
            z.ket = z.c;
            if (z.c <= z.lb or (z.at(z.c - 1) != 39 and z.at(z.c - 1) != 115)) {
                z.c = z.l - m1;
                break :apostrophe;
            }
            if (findAmongB(z, &a_1.blob, &a_1.items) == 0) {
                z.c = z.l - m1;
                break :apostrophe;
            }
            z.bra = z.c;
            try sliceDel(z);
        }
    }
    z.ket = z.c;
    if (z.c <= z.lb or (z.at(z.c - 1) != 100 and z.at(z.c - 1) != 115)) return false;
    const among_var = findAmongB(z, &a_2.blob, &a_2.items);
    if (among_var == 0) return false;
    z.bra = z.c;
    switch (among_var) {
        1 => try sliceFrom(z, "ss"),
        2 => {
            const m2 = z.l - z.c;
            const ret = skipBUtf8(&z.p, z.c, z.lb, 2);
            if (ret >= 0) {
                z.c = ret;
                try sliceFrom(z, "i");
            } else {
                z.c = z.l - m2;
                try sliceFrom(z, "ie");
            }
        },
        3 => {
            {
                const ret = skipBUtf8(&z.p, z.c, z.lb, 1);
                if (ret < 0) return false;
                z.c = ret;
            }
            {
                const ret = outGroupingBU(z, &g_v, 97, 121, true);
                if (ret < 0) return false;
                z.c -= ret;
            }
            try sliceDel(z);
        },
        else => {},
    }
    return true;
}

fn step1b(z: *Env) Error!bool {
    z.ket = z.c;
    if (z.c - 1 <= z.lb or z.at(z.c - 1) >> 5 != 3 or ((@as(u32, 33554576) >> @intCast(z.at(z.c - 1) & 0x1f)) & 1) == 0) return false;
    var among_var = findAmongB(z, &a_4.blob, &a_4.items);
    if (among_var == 0) return false;
    z.bra = z.c;
    switch (among_var) {
        1 => {
            if (!r1(z)) return false;
            try sliceFrom(z, "ee");
        },
        2 => {
            {
                const m_test1 = z.l - z.c;
                const ret = outGroupingBU(z, &g_v, 97, 121, true);
                if (ret < 0) return false;
                z.c -= ret;
                z.c = z.l - m_test1;
            }
            try sliceDel(z);
            z.ket = z.c;
            z.bra = z.c;
            {
                const m_test2 = z.l - z.c;
                if (z.c - 1 <= z.lb or z.at(z.c - 1) >> 5 != 3 or ((@as(u32, 68514004) >> @intCast(z.at(z.c - 1) & 0x1f)) & 1) == 0) {
                    among_var = 3;
                } else among_var = findAmongB(z, &a_3.blob, &a_3.items);
                switch (among_var) {
                    1 => {
                        try sliceFrom(z, "e");
                        return false;
                    },
                    2 => {
                        const m3 = z.l - z.c;
                        single: {
                            if (inGroupingBU(z, &g_aeo, 97, 111, false) != 0) break :single;
                            if (z.c > z.lb) break :single;
                            return false;
                        }
                        z.c = z.l - m3;
                    },
                    3 => {
                        if (z.c != z.i[1]) return false;
                        {
                            const m_test4 = z.l - z.c;
                            if (!shortv(z)) return false;
                            z.c = z.l - m_test4;
                        }
                        try sliceFrom(z, "e");
                        return false;
                    },
                    else => {},
                }
                z.c = z.l - m_test2;
            }
            z.ket = z.c;
            {
                const ret = skipBUtf8(&z.p, z.c, z.lb, 1);
                if (ret < 0) return false;
                z.c = ret;
            }
            z.bra = z.c;
            try sliceDel(z);
        },
        else => {},
    }
    return true;
}

fn step1c(z: *Env) Error!bool {
    z.ket = z.c;
    {
        const m1 = z.l - z.c;
        if (!(z.c <= z.lb or z.at(z.c - 1) != 'y')) {
            z.c -= 1;
        } else {
            z.c = z.l - m1;
            if (z.c <= z.lb or z.at(z.c - 1) != 'Y') return false;
            z.c -= 1;
        }
    }
    z.bra = z.c;
    if (outGroupingBU(z, &g_v, 97, 121, false) != 0) return false;
    if (!(z.c > z.lb)) return false;
    try sliceFrom(z, "i");
    return true;
}

fn step2(z: *Env) Error!bool {
    z.ket = z.c;
    if (z.c - 1 <= z.lb or z.at(z.c - 1) >> 5 != 3 or ((@as(u32, 815616) >> @intCast(z.at(z.c - 1) & 0x1f)) & 1) == 0) return false;
    const among_var = findAmongB(z, &a_5.blob, &a_5.items);
    if (among_var == 0) return false;
    z.bra = z.c;
    if (!r1(z)) return false;
    switch (among_var) {
        1 => try sliceFrom(z, "tion"),
        2 => try sliceFrom(z, "ence"),
        3 => try sliceFrom(z, "ance"),
        4 => try sliceFrom(z, "able"),
        5 => try sliceFrom(z, "ent"),
        6 => try sliceFrom(z, "ize"),
        7 => try sliceFrom(z, "ate"),
        8 => try sliceFrom(z, "al"),
        9 => try sliceFrom(z, "ful"),
        10 => try sliceFrom(z, "ous"),
        11 => try sliceFrom(z, "ive"),
        12 => try sliceFrom(z, "ble"),
        13 => {
            if (z.c <= z.lb or z.at(z.c - 1) != 'l') return false;
            z.c -= 1;
            try sliceFrom(z, "og");
        },
        14 => try sliceFrom(z, "less"),
        15 => {
            if (inGroupingBU(z, &g_valid_LI, 99, 116, false) != 0) return false;
            try sliceDel(z);
        },
        else => {},
    }
    return true;
}

fn step3(z: *Env) Error!bool {
    z.ket = z.c;
    if (z.c - 2 <= z.lb or z.at(z.c - 1) >> 5 != 3 or ((@as(u32, 528928) >> @intCast(z.at(z.c - 1) & 0x1f)) & 1) == 0) return false;
    const among_var = findAmongB(z, &a_6.blob, &a_6.items);
    if (among_var == 0) return false;
    z.bra = z.c;
    if (!r1(z)) return false;
    switch (among_var) {
        1 => try sliceFrom(z, "tion"),
        2 => try sliceFrom(z, "ate"),
        3 => try sliceFrom(z, "al"),
        4 => try sliceFrom(z, "ic"),
        5 => try sliceDel(z),
        6 => {
            if (!r2(z)) return false;
            try sliceDel(z);
        },
        else => {},
    }
    return true;
}

fn step4(z: *Env) Error!bool {
    z.ket = z.c;
    if (z.c - 1 <= z.lb or z.at(z.c - 1) >> 5 != 3 or ((@as(u32, 1864232) >> @intCast(z.at(z.c - 1) & 0x1f)) & 1) == 0) return false;
    const among_var = findAmongB(z, &a_7.blob, &a_7.items);
    if (among_var == 0) return false;
    z.bra = z.c;
    if (!r2(z)) return false;
    switch (among_var) {
        1 => try sliceDel(z),
        2 => {
            const m1 = z.l - z.c;
            if (!(z.c <= z.lb or z.at(z.c - 1) != 's')) {
                z.c -= 1;
            } else {
                z.c = z.l - m1;
                if (z.c <= z.lb or z.at(z.c - 1) != 't') return false;
                z.c -= 1;
            }
            try sliceDel(z);
        },
        else => {},
    }
    return true;
}

fn step5(z: *Env) Error!bool {
    z.ket = z.c;
    if (z.c <= z.lb or (z.at(z.c - 1) != 101 and z.at(z.c - 1) != 108)) return false;
    const among_var = findAmongB(z, &a_8.blob, &a_8.items);
    if (among_var == 0) return false;
    z.bra = z.c;
    switch (among_var) {
        1 => {
            if (!r2(z)) {
                if (!r1(z)) return false;
                const m1 = z.l - z.c;
                if (shortv(z)) return false;
                z.c = z.l - m1;
            }
            try sliceDel(z);
        },
        2 => {
            if (!r2(z)) return false;
            if (z.c <= z.lb or z.at(z.c - 1) != 'l') return false;
            z.c -= 1;
            try sliceDel(z);
        },
        else => {},
    }
    return true;
}

fn exception2(z: *Env) bool {
    z.ket = z.c;
    if (z.c - 5 <= z.lb or (z.at(z.c - 1) != 100 and z.at(z.c - 1) != 103)) return false;
    if (findAmongB(z, &a_9.blob, &a_9.items) == 0) return false;
    z.bra = z.c;
    if (z.c > z.lb) return false;
    return true;
}

fn exception1(z: *Env) Error!bool {
    z.bra = z.c;
    if (z.c + 2 >= z.l or z.at(z.c + 2) >> 5 != 3 or ((@as(u32, 42750482) >> @intCast(z.at(z.c + 2) & 0x1f)) & 1) == 0) return false;
    const among_var = findAmong(z, &a_10.blob, &a_10.items);
    if (among_var == 0) return false;
    z.ket = z.c;
    if (z.c < z.l) return false;
    switch (among_var) {
        1 => try sliceFrom(z, "ski"),
        2 => try sliceFrom(z, "sky"),
        3 => try sliceFrom(z, "die"),
        4 => try sliceFrom(z, "lie"),
        5 => try sliceFrom(z, "tie"),
        6 => try sliceFrom(z, "idl"),
        7 => try sliceFrom(z, "gentl"),
        8 => try sliceFrom(z, "ugli"),
        9 => try sliceFrom(z, "earli"),
        10 => try sliceFrom(z, "onli"),
        11 => try sliceFrom(z, "singl"),
        else => {},
    }
    return true;
}

fn postlude(z: *Env) Error!void {
    if (z.i[2] == 0) return;
    outer: while (true) {
        const c1 = z.c;
        while (true) {
            const c2 = z.c;
            z.bra = z.c;
            if (!(z.c == z.l or z.at(z.c) != 'Y')) {
                z.c += 1;
                z.ket = z.c;
                z.c = c2;
                break;
            }
            z.c = c2;
            const ret = skipUtf8(&z.p, z.c, z.l, 1);
            if (ret < 0) {
                z.c = c1;
                break :outer;
            }
            z.c = ret;
        }
        try sliceFrom(z, "y");
    }
}

/// english_UTF_8_stem.
fn stemEnv(z: *Env) Error!void {
    const c1 = z.c;
    if (try exception1(z)) return;
    z.c = c1;
    // Words of fewer than three characters are left alone.
    if (skipUtf8(&z.p, z.c, z.l, 3) < 0) return;
    z.c = c1;
    try prelude(z);
    markRegions(z);
    z.lb = z.c;
    z.c = z.l;
    {
        const m3 = z.l - z.c;
        _ = try step1a(z);
        z.c = z.l - m3;
    }
    const m4 = z.l - z.c;
    if (!exception2(z)) {
        z.c = z.l - m4;
        inline for (.{ step1b, step1c, step2, step3, step4, step5 }) |step| {
            const m = z.l - z.c;
            _ = try step(z);
            z.c = z.l - m;
        }
    }
    z.c = z.lb;
    {
        const c11 = z.c;
        try postlude(z);
        z.c = c11;
    }
}

/// The stem of `word` (lower case, at most max_word bytes) in `out`;
/// dict_snowball keeps the word when the stemmer leaves nothing.
pub fn stem(word: []const u8, out: []u8) []const u8 {
    var z: Env = .{};
    @memcpy(z.p[0..word.len], word);
    z.l = @intCast(word.len);
    stemEnv(&z) catch {};
    const length: usize = @intCast(z.l);
    if (length == 0) {
        @memcpy(out[0..word.len], word);
        return out[0..word.len];
    }
    @memcpy(out[0..length], z.p[0..length]);
    return out[0..length];
}

/// The english stop-word list (src/backend/snowball/stopwords/english.stop),
/// sorted for binary search as searchstoplist does.
pub const stop_words = [_][]const u8{
    "a",         "about",      "above",    "after",    "again",    "against",  "all",      "am",       "an",
    "and",       "any",        "are",      "as",       "at",       "be",       "because",  "been",     "before",
    "being",     "below",      "between",  "both",     "but",      "by",       "can",      "did",      "do",
    "does",      "doing",      "don",      "down",     "during",   "each",     "few",      "for",      "from",
    "further",   "had",        "has",      "have",     "having",   "he",       "her",      "here",     "hers",
    "herself",   "him",        "himself",  "his",      "how",      "i",        "if",       "in",       "into",
    "is",        "it",         "its",      "itself",   "just",     "me",       "more",     "most",     "my",
    "myself",    "no",         "nor",      "not",      "now",      "of",       "off",      "on",       "once",
    "only",      "or",         "other",    "our",      "ours",     "ourselves", "out",     "over",     "own",
    "s",         "same",       "she",      "should",   "so",       "some",     "such",     "t",        "than",
    "that",      "the",        "their",    "theirs",   "them",     "themselves", "then",   "there",    "these",
    "they",      "this",       "those",    "through",  "to",       "too",      "under",    "until",    "up",
    "very",      "was",        "we",       "were",     "what",     "when",     "where",    "which",    "while",
    "who",       "whom",       "why",      "will",     "with",     "you",      "your",     "yours",    "yourself",
    "yourselves",
};
