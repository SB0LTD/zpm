//! PostgreSQL identities for the built-in operator signatures supported here.
//! SQL binding and evaluation remain in binder.sig and expr.sig. Every
//! published signature is executed against native PostgreSQL by the stock
//! tooling qualification. This table excludes unimplemented signatures
//! and PostgreSQL's polymorphic pseudo-type entries.
pub const Operator = struct {
    oid: u32,
    name: []const u8,
    left: u32,
    right: u32,
    result: u32,
    function_oid: u32,
    function_name: []const u8,
    strict: bool = true,
    volatility: u8 = 'i',
    commutator: u32 = 0,
    negator: u32 = 0,
};

pub const internal_language_oid: u32 = 12;

