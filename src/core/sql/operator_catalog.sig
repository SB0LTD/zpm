/// One metadata row per implementation even when multiple operators share
/// the function. Resolve duplicates at compile time.
pub const functions = blk: {
    @setEvalBranchQuota(500000);
    var list: [operators.len]Operator = undefined;
    var count: usize = 0;
    for (operators) |operator| {
        for (list[0..count]) |existing| {
            if (existing.function_oid == operator.function_oid) break;
        } else {
            list[count] = operator;
            count += 1;
        }
    }
    break :blk list[0..count].*;
};
