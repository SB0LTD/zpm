//! Unicode case mapping of the database's ctype (Layer 0, wave 4 text-json
//! lane): towupper / towlower / iswalnum of glibc's C.UTF-8 locale, the
//! default ctype of a PostgreSQL 18 database created with C.UTF-8 under
//! the libc provider. upper, lower and initcap map non-ASCII characters
//! with these simple (one character to one character) mappings; ASCII
//! keeps the C mappings (identical). The tables were extracted from native
//! PostgreSQL 18.7 (upper(chr(c)), lower(chr(c)) and chr(c) ~
//! '[[:alnum:]]' for every code point) and are stored as runs: code points
//! start, start + stride, ... end map to code point + delta.

pub const Run = struct { start: u32, end: u32, delta: i32, stride: u8 };

fn mapped(runs: []const Run, cp: u32) u32 {
    var low: usize = 0;
    var high: usize = runs.len;
    while (low < high) {
        const mid = (low + high) / 2;
        if (runs[mid].start <= cp) low = mid + 1 else high = mid;
    }
    // Stride-2 runs interleave: the four runs starting at or before cp.
    var k = low;
    var checked: usize = 0;
    while (k > 0 and checked < 4) : (checked += 1) {
        k -= 1;
        const run = runs[k];
        if (cp >= run.start and cp <= run.end and (cp - run.start) % run.stride == 0) return @intCast(@as(i64, cp) + run.delta);
    }
    return cp;
}

/// towupper (C.UTF-8).
pub fn toUpper(cp: u32) u32 {
    if (cp < 0x80) return if (cp >= 'a' and cp <= 'z') cp - 32 else cp;
    return mapped(&upper_runs, cp);
}

/// towlower (C.UTF-8).
pub fn toLower(cp: u32) u32 {
    if (cp < 0x80) return if (cp >= 'A' and cp <= 'Z') cp + 32 else cp;
    return mapped(&lower_runs, cp);
}

/// iswalnum (C.UTF-8).
pub fn isAlnum(cp: u32) bool {
    if (cp < 0x80) return (cp >= 'a' and cp <= 'z') or (cp >= 'A' and cp <= 'Z') or (cp >= '0' and cp <= '9');
    var low: usize = 0;
    var high: usize = alnum_ranges.len;
    while (low < high) {
        const mid = (low + high) / 2;
        if (alnum_ranges[mid][1] < cp) {
            low = mid + 1;
        } else if (alnum_ranges[mid][0] > cp) {
            high = mid;
        } else return true;
    }
    return false;
}

