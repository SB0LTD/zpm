//! Unicode normalization for normalize() and IS [NOT] [form] NORMALIZED
//! (Layer 0, B11): NFC, NFD, NFKC and NFKD per UAX #15 with the Unicode 16.0
//! data PostgreSQL 18 uses (unicode_tables.sig, generated by
//! tools/gen_unicode_normalization.py), Hangul syllables algorithmically.
//!
//! The text streams through one segment (a starter and its following
//! combining marks) at a time: decompose, canonically order the marks, then
//! compose into the segment's starter. A segment holds at most `segment_limit`
//! code points; longer runs of combining marks are 54000. Input must be valid
//! UTF-8 (22021). Output goes to a caller-owned buffer (54000 beyond it), and
//! every input character passes the execution checkpoint.
const types = @import("types.sig");
const tables = @import("unicode_tables.sig");
const lexer = @import("lexer.sig");
const Error = types.Error;

pub const Form = enum { nfc, nfd, nfkc, nfkd };

pub const segment_limit = 512;

/// The form named by normalize()'s second argument (case-insensitive).
pub fn formOf(name: []const u8) ?Form {
    const names = [_][]const u8{ "nfc", "nfd", "nfkc", "nfkd" };
    for (names, 0..) |candidate, index| {
        if (candidate.len != name.len) continue;
        var same = true;
        for (candidate, name) |a, b| {
            const lowered = if (b >= 'A' and b <= 'Z') b + 32 else b;
            if (a != lowered) same = false;
        }
        if (same) return @enumFromInt(index);
    }
    return null;
}

const s_base: u21 = 0xAC00;
const l_base: u21 = 0x1100;
const v_base: u21 = 0x1161;
const t_base: u21 = 0x11A7;
const l_count: u21 = 19;
const v_count: u21 = 21;
const t_count: u21 = 28;
const n_count: u21 = v_count * t_count;
const s_count: u21 = l_count * n_count;

/// Canonical combining class.
pub fn combiningClass(code: u21) u8 {
    var low: usize = 0;
    var high: usize = tables.combining.len;
    while (low < high) {
        const middle = (low + high) / 2;
        const entry = tables.combining[middle];
        const first: u21 = @intCast(entry >> 29);
        const last: u21 = @intCast((entry >> 8) & 0x1FFFFF);
        if (code < first) {
            high = middle;
        } else if (code > last) {
            low = middle + 1;
        } else return @intCast(entry & 0xFF);
    }
    return 0;
}

/// The single-level decomposition mapping of `code`, if any applies.
fn mappingOf(code: u21, compat: bool) ?[]const u21 {
    var low: usize = 0;
    var high: usize = tables.decompositions.len;
    while (low < high) {
        const middle = (low + high) / 2;
        const entry = tables.decompositions[middle];
        const key: u21 = @intCast(entry >> 22);
        if (code < key) {
            high = middle;
        } else if (code > key) {
            low = middle + 1;
        } else {
            const is_compat = (entry >> 21) & 1 == 1;
            if (is_compat and !compat) return null;
            const start: usize = @intCast((entry >> 5) & 0xFFFF);
            const len: usize = @intCast(entry & 0x1F);
            return tables.mapping[start..][0..len];
        }
    }
    return null;
}

/// The primary composite of a pair, if one exists.
fn compose(first: u21, second: u21) ?u21 {
    // Hangul LV and LVT.
    if (first >= l_base and first < l_base + l_count and second >= v_base and second < v_base + v_count)
        return s_base + ((first - l_base) * v_count + (second - v_base)) * t_count;
    if (first >= s_base and first < s_base + s_count and (first - s_base) % t_count == 0 and second > t_base and second < t_base + t_count)
        return first + (second - t_base);
    const key = (@as(u64, first) << 21) | second;
    var low: usize = 0;
    var high: usize = tables.compositions.len;
    while (low < high) {
        const middle = (low + high) / 2;
        const entry = tables.compositions[middle];
        const pair = entry >> 21;
        if (key < pair) {
            high = middle;
        } else if (key > pair) {
            low = middle + 1;
        } else return @intCast(entry & 0x1FFFFF);
    }
    return null;
}

/// Accumulates one segment and writes UTF-8 output.
const Normalizer = struct {
    out: []u8,
    len: usize = 0,
    compose: bool,
    compat: bool,
    segment: [segment_limit]u21 = undefined,
    count: usize = 0,

    fn emit(self: *Normalizer, code: u21) Error!void {
        var bytes: [4]u8 = undefined;
        const width: usize = if (code < 0x80) 1 else if (code < 0x800) 2 else if (code < 0x10000) 3 else 4;
        switch (width) {
            1 => bytes[0] = @intCast(code),
            2 => {
                bytes[0] = @intCast(0xC0 | (code >> 6));
                bytes[1] = @intCast(0x80 | (code & 0x3F));
            },
            3 => {
                bytes[0] = @intCast(0xE0 | (code >> 12));
                bytes[1] = @intCast(0x80 | ((code >> 6) & 0x3F));
                bytes[2] = @intCast(0x80 | (code & 0x3F));
            },
            else => {
                bytes[0] = @intCast(0xF0 | (code >> 18));
                bytes[1] = @intCast(0x80 | ((code >> 12) & 0x3F));
                bytes[2] = @intCast(0x80 | ((code >> 6) & 0x3F));
                bytes[3] = @intCast(0x80 | (code & 0x3F));
            },
        }
        if (width > self.out.len - self.len) return error.TextCapacity;
        @memcpy(self.out[self.len..][0..width], bytes[0..width]);
        self.len += width;
    }

    /// Canonical ordering of the marks, then composition into the starter.
    fn settle(self: *Normalizer) void {
        const marks_start: usize = if (self.count != 0 and combiningClass(self.segment[0]) == 0) 1 else 0;
        // Stable insertion sort of the combining marks by class.
        var index = marks_start + 1;
        while (index < self.count) : (index += 1) {
            const code = self.segment[index];
            const class = combiningClass(code);
            var at = index;
            while (at > marks_start and combiningClass(self.segment[at - 1]) > class) : (at -= 1) self.segment[at] = self.segment[at - 1];
            self.segment[at] = code;
        }
        if (!self.compose or marks_start == 0) return;
        // A mark composes with the starter unless blocked by an earlier
        // retained mark of the same or a higher class.
        var kept: usize = 1;
        var last_class: u8 = 0;
        for (self.segment[1..self.count]) |code| {
            const class = combiningClass(code);
            if ((kept == 1 or last_class < class)) {
                if (compose(self.segment[0], code)) |composite| {
                    self.segment[0] = composite;
                    continue;
                }
            }
            self.segment[kept] = code;
            kept += 1;
            last_class = class;
        }
        self.count = kept;
    }

    fn flush(self: *Normalizer) Error!void {
        for (self.segment[0..self.count]) |code| try self.emit(code);
        self.count = 0;
    }

    fn push(self: *Normalizer, code: u21) Error!void {
        if (combiningClass(code) != 0) {
            if (self.count == segment_limit) return error.ProgramLimitExceeded;
            self.segment[self.count] = code;
            self.count += 1;
            return;
        }
        self.settle();
        // A new starter composes with the previous one when nothing remains
        // between them (Hangul LV + T, and a few canonical starter pairs).
        if (self.compose and self.count == 1 and combiningClass(self.segment[0]) == 0) {
            if (compose(self.segment[0], code)) |composite| {
                self.segment[0] = composite;
                return;
            }
        }
        try self.flush();
        self.segment[0] = code;
        self.count = 1;
    }

    /// Full (recursive) decomposition of one character into the segment.
    fn decompose(self: *Normalizer, code: u21, depth: u8) Error!void {
        if (code >= s_base and code < s_base + s_count) {
            const index = code - s_base;
            try self.push(l_base + index / n_count);
            try self.push(v_base + (index % n_count) / t_count);
            if (index % t_count != 0) try self.push(t_base + index % t_count);
            return;
        }
        if (depth < 8) if (mappingOf(code, self.compat)) |parts| {
            for (parts) |part| try self.decompose(part, depth + 1);
            return;
        };
        try self.push(code);
    }
};

/// normalize(text, form) into `out`; returns the output length.
pub fn normalize(text: []const u8, form: Form, out: []u8, control: ?*types.ExecutionControl) Error!usize {
    var check: lexer.Utf8Check = .{};
    for (text) |byte| check.feed(byte);
    if (!check.finish()) return error.CharacterNotInRepertoire;
    var state: Normalizer = .{ .out = out, .compose = form == .nfc or form == .nfkc, .compat = form == .nfkc or form == .nfkd };
    var at: usize = 0;
    while (at < text.len) {
        if (control) |active| try active.checkpoint();
        const lead = text[at];
        const width: usize = if (lead < 0x80) 1 else if (lead < 0xE0) 2 else if (lead < 0xF0) 3 else 4;
        var code: u21 = if (width == 1) lead else if (width == 2) lead & 0x1F else if (width == 3) lead & 0x0F else lead & 0x07;
        for (text[at + 1 .. at + width]) |byte| code = (code << 6) | (byte & 0x3F);
        try state.decompose(code, 0);
        at += width;
    }
    state.settle();
    try state.flush();
    return state.len;
}
