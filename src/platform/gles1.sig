//! Native mobile EGL + GLES 1.1 bindings. Fixed-function development renderer.
pub const Handle = ?*anyopaque;
pub extern "EGL" fn eglGetDisplay(?*anyopaque) Handle;
pub extern "EGL" fn eglInitialize(Handle, ?*i32, ?*i32) c_uint;
pub extern "EGL" fn eglChooseConfig(Handle, [*]const i32, *Handle, i32, *i32) c_uint;
pub extern "EGL" fn eglGetConfigAttrib(Handle, Handle, i32, *i32) c_uint;
pub extern "EGL" fn eglCreateWindowSurface(Handle, Handle, *anyopaque, ?[*]const i32) Handle;
pub extern "EGL" fn eglCreateContext(Handle, Handle, Handle, [*]const i32) Handle;
pub extern "EGL" fn eglMakeCurrent(Handle, Handle, Handle, Handle) c_uint;
pub extern "EGL" fn eglQuerySurface(Handle, Handle, i32, *i32) c_uint;
pub extern "EGL" fn eglSwapBuffers(Handle, Handle) c_uint;
pub extern "EGL" fn eglDestroySurface(Handle, Handle) c_uint;
pub extern "EGL" fn eglDestroyContext(Handle, Handle) c_uint;
pub extern "EGL" fn eglTerminate(Handle) c_uint;
pub extern "GLESv1_CM" fn glViewport(i32,i32,i32,i32) void;
pub extern "GLESv1_CM" fn glClearColor(f32,f32,f32,f32) void;
pub extern "GLESv1_CM" fn glClear(c_uint) void;
pub extern "GLESv1_CM" fn glEnable(c_uint) void;
pub extern "GLESv1_CM" fn glDisable(c_uint) void;
pub extern "GLESv1_CM" fn glEnableClientState(c_uint) void;
pub extern "GLESv1_CM" fn glVertexPointer(c_int,c_uint,c_int,*const anyopaque) void;
pub extern "GLESv1_CM" fn glColorPointer(c_int,c_uint,c_int,*const anyopaque) void;
pub extern "GLESv1_CM" fn glDrawArrays(c_uint,c_int,c_int) void;
pub extern "GLESv1_CM" fn glColor4f(f32,f32,f32,f32) void;
pub extern "GLESv1_CM" fn glMatrixMode(c_uint) void;
pub extern "GLESv1_CM" fn glLoadIdentity() void;
pub extern "GLESv1_CM" fn glFrustumf(f32,f32,f32,f32,f32,f32) void;
pub extern "GLESv1_CM" fn glTranslatef(f32,f32,f32) void;
pub extern "GLESv1_CM" fn glRotatef(f32,f32,f32,f32) void;
pub extern "GLESv1_CM" fn glScissor(i32,i32,i32,i32) void;
