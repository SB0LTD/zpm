    .{ .name = "number-constructor-coercion-throw-preserves-catch", .source = "var R=0;try{new Number({valueOf:function(){throw 6;}});R=100;}catch(e){R=e;}", .expected = 6 },
    .{ .name = "boolean-wrappers-retain-false-and-remain-truthy", .source = "var b=new Boolean(false),o=Object(true);var R=(b.valueOf()===false?1:0)+(b.toString()==='false'?2:0)+(Boolean(b)?4:0)+(b instanceof Boolean?8:0)+(Object.prototype.toString.call(b)==='[object Boolean]'?16:0)+(o.valueOf()===true?32:0)+(Boolean.prototype.valueOf()===false?64:0);", .expected = 127 },
    .{ .name = "number-string-conversions-preserve-fractions", .source = "var n=4.787105393778296;var R=(String(n)==='4.787105393778296'?1:0)+((''+n)==='4.787105393778296'?2:0)+(n.toString()==='4.787105393778296'?4:0)+([n].join('')==='4.787105393778296'?8:0)+(String(-0)==='0'?16:0);", .expected = 31 },
    .{ .name = "number-string-exponent-thresholds-match-js", .source = "var R=(String(1e21)==='1e+21'?1:0)+(String(1e20)==='100000000000000000000'?2:0)+(String(1e-6)==='0.000001'?4:0)+(String(1e-7)==='1e-7'?8:0)+(String(5e-324)==='5e-324'?16:0)+(String(1.7976931348623157e308)==='1.7976931348623157e+308'?32:0);", .expected = 63 },
    .{ .name = "character-table-keeps-codes-above-255", .source = "var s=String.fromCharCode(0,127,128,255,256,351,65535);var R=(s.length===7?1:0)+(s.charCodeAt(2)===128?2:0)+(s.charCodeAt(4)===256?4:0)+(s.charCodeAt(5)===351?8:0)+(s.charCodeAt(6)===65535?16:0);", .expected = 31 },
    .{ .name = "utf16-surrogate-units-and-canonical-equality", .source = "var s=String.fromCharCode(55357,56832);var R=(s.length===2?1:0)+(s==='😀'?2:0)+(s.charCodeAt(0)===55357?4:0)+(s.charCodeAt(1)===56832?8:0)+(s[0].length===1&&s[0].charCodeAt(0)===55357?16:0)+(s.slice(0,1)+s.slice(1)==='😀'?32:0);", .expected = 63 },
    .{ .name = "unicode-literal-escapes-share-code-unit-values", .source = "var R=('\\x80'.charCodeAt(0)===128?1:0)+('\\u0100'===String.fromCharCode(256)?2:0)+('\\ud83d\\ude00'==='😀'?4:0)+('\\ud800'.charCodeAt(0)===55296?8:0);", .expected = 15 },
    .{ .name = "latin1-base64-roundtrip-preserves-all-bytes", .source = "var s='';for(var i=0;i<256;i++)s+=String.fromCharCode(i);var t=atob(btoa(s));var R=t===s&&t.length===256?1:0;for(var i=0;i<256;i++)if(t.charCodeAt(i)!==i)R=1000;", .expected = 1 },
    .{ .name = "btoa-rejects-code-units-outside-latin1", .source = "var R=0;try{btoa(String.fromCharCode(256));}catch(e){R=e.name==='InvalidCharacterError'?1:100;}", .expected = 1 },
    .{ .name = "unicode-string-wrapper-indices-use-code-units", .source = "var s=new String('Ā😀');var R=(s.length===3?1:0)+(s[0]==='Ā'?2:0)+(s[1].charCodeAt(0)===55357?4:0)+(s[2].charCodeAt(0)===56832?8:0)+(Object.keys(s).join(',')==='0,1,2'?16:0);", .expected = 31 },
    .{ .name = "unicode-random-indexing-across-sparse-checkpoints", .source = "var s=String.fromCharCode(351).repeat(1000);var R=s.length===1000?1:0;for(var i=999;i>=0;i-=37)if(s.charCodeAt(i)!==351)R=1000;R+=s.slice(63,129).length===66?2:0;", .expected = 3 },
    .{ .name = "atob-decodes-unpadded-final-groups", .source = "var R=(atob('YQ')==='a'?1:0)+(atob('YWI')==='ab'?2:0)+(atob('YWJj')==='abc'?4:0)+(atob(' Y W I =\\n')==='ab'?8:0);", .expected = 15 },
    .{ .name = "atob-rejects-malformed-padding-and-alphabet", .source = "var R=0;for(var i=0;i<5;i++){try{atob(['Y','YQ=','YQ===','Y=Q=','Y_Q='][i]);R+=100;}catch(e){R+=e.name==='InvalidCharacterError'?1:1000;}}", .expected = 5 },
    .{ .name = "unicode-split-and-property-indices-use-code-units", .source = "var s='Ā😀',a=s.split('');var R=(a.length===3?1:0)+(a[0]==='Ā'?2:0)+(a[1].charCodeAt(0)===55357?4:0)+(s['2'].charCodeAt(0)===56832?8:0)+(!s.hasOwnProperty('3')?16:0);", .expected = 31 },
    .{ .name = "unicode-substring-and-search-use-code-unit-offsets", .source = "var s='Ā😀z';var R=(s.indexOf('z')===3?1:0)+(s.indexOf('😀',1)===1?2:0)+(s.indexOf('',99)===4?4:0)+(s.substring(3,1)==='😀'?8:0)+(s.substring(-1,1)==='Ā'?16:0)+(s.slice(1,undefined)==='😀z'?32:0);", .expected = 63 },
    .{ .name = "break-removes-escaped-catch-handlers", .source = "var R=0;try{for(var i=0;i<1;i++){try{break;}catch(e){R+=100;}}throw 7;}catch(e){R+=e;}", .expected = 7 },
    .{ .name = "continue-removes-escaped-catch-handlers", .source = "var R=0;try{for(var i=0;i<2;i++){try{continue;}catch(e){R+=100;}}throw 7;}catch(e){R+=e;}", .expected = 7 },
    .{ .name = "break-and-continue-run-finally", .source = "var R=0;for(var i=0;i<3;i++){try{if(i===0)continue;if(i===1)break;}finally{R+=i+1;}}", .expected = 3 },
    .{ .name = "return-runs-finally-and-finally-can-override", .source = "var R=0;function f(){try{return 7;}finally{R+=10;}}function g(){try{return 3;}finally{return 4;}}R=f()+R+g();", .expected = 21 },
    .{ .name = "nested-finally-preserves-pending-throw", .source = "var R=0;try{try{throw 7;}finally{try{throw 2;}catch(e){R+=e;}try{}finally{R+=10;}R+=100;}}catch(e){R+=e;}", .expected = 119 },
    .{ .name = "finally-callback-return-preserves-outer-throw", .source = "var R=0;function f(){return 3;}try{try{throw 7;}finally{R+=f();R+=10;}}catch(e){R+=e;}", .expected = 20 },
    .{ .name = "finally-return-overrides-throw", .source = "function f(){try{throw 7;}finally{return 4;}}var R=f();", .expected = 4 },
    .{ .name = "finally-throw-overrides-return", .source = "var R=0;function f(){try{return 7;}finally{throw 4;}}try{f();R=100;}catch(e){R=e;}", .expected = 4 },
    .{ .name = "nested-finally-order-on-labelled-break", .source = "var R=0;outer:while(true){try{try{break outer;}finally{R=R*10+1;}}finally{R=R*10+2;}}R=R*10+3;", .expected = 123 },
    .{ .name = "finally-loop-local-break-keeps-pending-throw", .source = "var R=0;try{try{throw 7;}finally{for(var i=0;i<2;i++){R++;break;}R+=10;}}catch(e){R+=e;}", .expected = 18 },
    .{ .name = "array-prototype-is-an-array", .source = "var R=(Array.isArray(Array.prototype)?1:0)+(Array.prototype.length===0?2:0)+(Object.getPrototypeOf(Array.prototype)===Object.prototype?4:0);Array.prototype.push(9);R+=Array.prototype[0]===9?8:0;", .expected = 15 },
    .{ .name = "function-prototype-is-callable-and-has-no-prototype", .source = "var p=Function.prototype;var R=(typeof p==='function'?1:0)+(p()===undefined?2:0)+(p.name===''&&p.length===0?4:0)+(p.prototype===undefined?8:0)+(Object.getPrototypeOf(function(){})===p?16:0)+(Object.getPrototypeOf(p)===Object.prototype?32:0);", .expected = 63 },
    .{ .name = "nonconstructible-function-prototype-and-arrow", .source = "var R=0;try{new Function.prototype();}catch(e){R+=e.name==='TypeError'?1:100;}var f=()=>1;R+=f.prototype===undefined?2:200;try{new f();}catch(e){R+=e.name==='TypeError'?4:400;}", .expected = 7 },
    .{ .name = "function-prototype-inheritance-and-instanceof", .source = "var f=function(){};var R=(f instanceof Function?1:0)+(!(Function.prototype instanceof Function)?2:0)+(Object.create(Function.prototype) instanceof Function?4:0);", .expected = 7 },
    .{ .name = "native-methods-do-not-create-constructor-prototypes", .source = "var getter=Object.getOwnPropertyDescriptor(Object.getPrototypeOf(navigator),'webdriver').get;var R=(Math.random.prototype===undefined?1:0)+(String.prototype.trim.prototype===undefined?2:0)+(getter.prototype===undefined?4:0);try{new Math.random();}catch(e){R+=e.name==='TypeError'?8:100;}", .expected = 15 },
    .{ .name = "constructor-can-return-a-function-object", .source = "function C(){return function(){return 7;};}var f=new C();var R=typeof f==='function'?f():100;", .expected = 7 },
    .{ .name = "new-function-returns-compiled-callable", .source = "var f=new Function('x','return x+3;');var R=typeof f==='function'?f(4):100;", .expected = 7 },
    .{ .name = "native-constructor-throw-preserves-caller-locals", .source = "var R=0;function f(){var a=3,b=4;try{new Array(-1);}catch(e){return a+b+(e.name==='RangeError'?10:100);}}R=f();", .expected = 17 },
    .{ .name = "shallow-array-snapshot-keeps-updated-closure-cell", .source = "var proto=Object.create(Object.prototype,{value:{value:{}}});function cell(J){var b=Object.create(proto);b.create=function(){return J;};b.concat=function(G){J=G;};return b;}var a=[];a[57]=cell(148924);a[57].concat(238320);var b=a.slice();a[57]=undefined;a[57]=cell(46720);a=b;var R=a[57].create();", .expected = 238320 },
    .{ .name = "chrome-utility-properties-participate-in-host-iteration", .source = "var keys='';for(var k in chrome)keys+=k+',';var R=(keys==='loadTimes,csi,app,'?1:0)+(Object.keys(chrome).length===3?2:0);", .expected = 3 },
};

const timer_cases = [_]Case{
    .{ .name = "iframe-load-runs-after-attachment-and-registration", .source = "var R=0,f=document.createElement('iframe');document.body.appendChild(f);f.addEventListener('load',function(e){R=e.target===f&&f.parentNode===document.body?1:100;});", .expected = 1 },
    .{ .name = "detached-iframe-does-not-fire-pending-load", .source = "var R=0,f=document.createElement('iframe');f.onload=function(){R++;};document.body.appendChild(f);document.body.removeChild(f);", .expected = 0 },
    .{ .name = "timer-cancellation-and-unique-handles", .source = "var R=0,a=setTimeout(function(){R+=100;},0),b=setTimeout(function(){R+=1;},0);R=a>0&&b>0&&a!==b?10:1000;clearTimeout(a);clearTimeout(999999);", .expected = 11 },
    .{ .name = "timer-passes-more-than-two-arguments", .source = "var R=0;setTimeout(function(a,b,c,d,e){R=a+b*10+c*100+d*1000+e*10000;},0,1,2,3,4,5);", .expected = 54321 },
    .{ .name = "timer-recycles-slots-across-recursive-callbacks", .source = "var R=0;function tick(){if(++R<600)setTimeout(tick,0);}setTimeout(tick,0);", .expected = 600 },
    .{ .name = "timer-orders-delay-before-registration", .source = "var R=0;setTimeout(function(){R=R*10+3;},200);setTimeout(function(){R=R*10+1;},0);setTimeout(function(){R=R*10+2;},50);", .expected = 123 },
    .{ .name = "microtasks-precede-timers-and-remain-fifo", .source = "var R=0;setTimeout(function(){R=R*10+4;},0);queueMicrotask(function(){R=R*10+1;queueMicrotask(function(){R=R*10+3;});});queueMicrotask(function(){R=R*10+2;});", .expected = 1234 },
    .{ .name = "interval-can-cancel-itself-through-clear-timeout", .source = "var R=0,id=setInterval(function(){R++;if(R===3)clearTimeout(id);},1);", .expected = 3 },
    .{ .name = "cancelled-task-storage-is-reusable", .source = "var R=0;for(var i=0;i<600;i++){var id=setTimeout(function(){R+=100;},0);clearInterval(id);}setTimeout(function(){R++;},0);", .expected = 1 },
    .{ .name = "timer-overflow-is-explicit-and-cancellation-recovers", .source = "var R=0,a=[];for(var i=0;i<256;i++)a.push(setTimeout(function(){R+=100;},0));try{setTimeout(function(){},0);}catch(e){R=e.name==='RangeError'?10:1000;}for(var i=0;i<a.length;i++)clearTimeout(a[i]);setTimeout(function(){R++;},0);", .expected = 11 },
};

pub const case_count: usize = cases.len + timer_cases.len + 3;

pub fn runAll(comptime report: fn ([]const u8, f64, f64) void) u32 {
    var failed: u32 = 0;
    for (cases) |case| {
        const result = jsvm.dbgEvalGlobalNumber(case.source, "R");
        report(case.name, result, case.expected);
        if (result != case.expected) failed += 1;
    }
    for (timer_cases) |case| {
        _ = jsvm.dbgEvalGlobalNumber(case.source, "R");
        jsvm.vm.drainTasks();
        const result = if (jsvm.vm.hasError()) -999996 else jsvm.vm.getGlobalVar("R").toNumber();
        report(case.name, result, case.expected);
        if (result != case.expected) failed += 1;
    }
    // Check persisted frame metadata as well as expression results: reserving
    // stale locals can remain invisible until an actual BotGuard frame stack
    // overlaps, and a receiver name read from source offset zero can masquerade
    // as an unrelated binding in a later eval.
    _ = jsvm.dbgEvalGlobalNumber("var R;function f(){eval('var a=1;var b=2;');R=eval('7');}f();", "R");
    const eval_id = compiler.lastEvalBodyFunc();
    const local_count: f64 = if (eval_id != 0xFFFF) @floatFromInt(compiler.getFunction(eval_id).local_count) else -1;
    report("eval-frame-local-reservation-resets", local_count, 1);
    if (local_count != 1) failed += 1;
    _ = jsvm.dbgEvalGlobalNumber("var R;function f(){return 1;}R=f();", "R");
    const receiver_name = compiler.funcLocalName(0, 0);
    const receiver_ok: f64 = if (receiver_name == values.internString("this")) 1 else 0;
    report("internal-receiver-name-is-persistent", receiver_ok, 1);
    if (receiver_ok != 1) failed += 1;
    // Awaiting the synchronous minter contract must not drain unrelated timers
    // between its two calls and mutate the callback's captured browser state.
    var response: [65536]u8 = undefined;
    var response_len: usize = 0;
    const protocol = "var pending=0;var trayride={a:function(p,setup){setup(function(cb,args){args[2][0]=function(i){return function(b){return [i[0],b[0],pending];};};setTimeout(function(){pending=99;},0);cb('ready');},function(){},function(){},function(){});return [function(){return 'fallback';}];}};";
    var minted: [16]u8 = undefined;
    const ready = jsvm.execute(protocol, "", "trayride", &response, &response_len);
    const mint_len = if (ready) jsvm.mintPoToken(&.{2}, "x", &minted) else 0;
    const coherent = mint_len == 3 and minted[0] == 2 and minted[1] == 'x' and minted[2] == 0;
    jsvm.vm.drainTasks();
    const minter_ok: f64 = if (coherent and jsvm.vm.getGlobalVar("pending").toNumber() == 99) 1 else 0;
    report("synchronous-minter-does-not-run-unrelated-timers", minter_ok, 1);
    if (minter_ok != 1) failed += 1;
    return failed;
}
