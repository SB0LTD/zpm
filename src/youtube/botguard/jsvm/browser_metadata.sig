pub fn installMissing(target: u32, fields: []const Field, native_id: u16) void {
    for (fields) |field| {
        const key = values.internString(field.name);
        if (objects.hasOwnProperty(target, key)) continue;
        const value: Value = switch (field.kind) {
            .function => blk: { const function = objects.createFunction(native_id); objects.setProperty(function, values.internString("name"), Value.string(key)); objects.setEnumerable(function, values.internString("name"), false); break :blk Value.function(function); },
            .string => Value.string(values.internString(field.text)),
            .number => Value.number(field.number),
            .boolean => if (field.boolean) Value.TRUE else Value.FALSE,
            .object => Value.object(objects.createObject()),
        };
        objects.setProperty(target, key, value);
    }
}
