//! @zpm/va vp9_tx — VP9's one-dimensional transforms as vpx_dsl functions:
//! the decoder's inverse DCT and ADST of 4, 8 and 16 points (libvpx's
//! vpx_dsp/inv_txfm.c, which the decoders the stream is checked against
//! compute bit for bit) and the encoder's forward ones (libvpx's
//! vp9/encoder/vp9_dct.c), translated mechanically from libvpx's C
//! (its all-zero shortcuts left out: they give what the full transform
//! gives). Generic over the backend: the CPU's and KIR.

/// ROUND_POWER_OF_TWO(x, 14): dct_const_round_shift, fdct_round_shift.
pub fn rs14(b: anytype, x: anytype) @TypeOf(x) {
    return b.sar(b.add(x, b.c(1 << 13)), b.c(14));
}

pub fn idct4(b: anytype, input_p: [4]@TypeOf(b.c(0))) [4]@TypeOf(b.c(0)) {
    const V = @TypeOf(b.c(0));
    var input = input_p;
    var output: [4]V = undefined;
    var step: [4]V = undefined;
    var temp1: V = undefined;
    var temp2: V = undefined;
    temp1 = b.mul(b.add(input[0], input[2]), b.c(11585));
    temp2 = b.mul(b.sub(input[0], input[2]), b.c(11585));
    step[0] = rs14(b, temp1);
    step[1] = rs14(b, temp2);
    temp1 = b.sub(b.mul(input[1], b.c(6270)), b.mul(input[3], b.c(15137)));
    temp2 = b.add(b.mul(input[1], b.c(15137)), b.mul(input[3], b.c(6270)));
    step[2] = rs14(b, temp1);
    step[3] = rs14(b, temp2);
    output[0] = b.add(step[0], step[3]);
    output[1] = b.add(step[1], step[2]);
    output[2] = b.sub(step[1], step[2]);
    output[3] = b.sub(step[0], step[3]);
    _ = .{ &input, &step, &temp1, &temp2 };
    return output;
}

pub fn iadst4(b: anytype, input_p: [4]@TypeOf(b.c(0))) [4]@TypeOf(b.c(0)) {
    const V = @TypeOf(b.c(0));
    var input = input_p;
    var output: [4]V = undefined;
    var s0: V = undefined;
    var s1: V = undefined;
    var s2: V = undefined;
    var s3: V = undefined;
    var s4: V = undefined;
    var s5: V = undefined;
    var s6: V = undefined;
    var s7: V = undefined;
    var x0: V = input[0];
    var x1: V = input[1];
    var x2: V = input[2];
    var x3: V = input[3];
    s0 = b.mul(b.c(5283), x0);
    s1 = b.mul(b.c(9929), x0);
    s2 = b.mul(b.c(13377), x1);
    s3 = b.mul(b.c(15212), x2);
    s4 = b.mul(b.c(5283), x2);
    s5 = b.mul(b.c(9929), x3);
    s6 = b.mul(b.c(15212), x3);
    s7 = b.add(b.sub(x0, x2), x3);
    s0 = b.add(b.add(s0, s3), s5);
    s1 = b.sub(b.sub(s1, s4), s6);
    s3 = s2;
    s2 = b.mul(b.c(13377), s7);
    output[0] = rs14(b, b.add(s0, s3));
    output[1] = rs14(b, b.add(s1, s3));
    output[2] = rs14(b, s2);
    output[3] = rs14(b, b.sub(b.add(s0, s1), s3));
    _ = .{ &input, &s0, &s1, &s2, &s3, &s4, &s5, &s6, &s7, &x0, &x1, &x2, &x3 };
    return output;
}

pub fn idct8(b: anytype, input_p: [8]@TypeOf(b.c(0))) [8]@TypeOf(b.c(0)) {
    const V = @TypeOf(b.c(0));
    var input = input_p;
    var output: [8]V = undefined;
    var step1: [8]V = undefined;
    var step2: [8]V = undefined;
    var temp1: V = undefined;
    var temp2: V = undefined;
    step1[0] = input[0];
    step1[2] = input[4];
    step1[1] = input[2];
    step1[3] = input[6];
    temp1 = b.sub(b.mul(input[1], b.c(3196)), b.mul(input[7], b.c(16069)));
    temp2 = b.add(b.mul(input[1], b.c(16069)), b.mul(input[7], b.c(3196)));
    step1[4] = rs14(b, temp1);
    step1[7] = rs14(b, temp2);
    temp1 = b.sub(b.mul(input[5], b.c(13623)), b.mul(input[3], b.c(9102)));
    temp2 = b.add(b.mul(input[5], b.c(9102)), b.mul(input[3], b.c(13623)));
    step1[5] = rs14(b, temp1);
    step1[6] = rs14(b, temp2);
    temp1 = b.mul(b.add(step1[0], step1[2]), b.c(11585));
    temp2 = b.mul(b.sub(step1[0], step1[2]), b.c(11585));
    step2[0] = rs14(b, temp1);
    step2[1] = rs14(b, temp2);
    temp1 = b.sub(b.mul(step1[1], b.c(6270)), b.mul(step1[3], b.c(15137)));
    temp2 = b.add(b.mul(step1[1], b.c(15137)), b.mul(step1[3], b.c(6270)));
    step2[2] = rs14(b, temp1);
    step2[3] = rs14(b, temp2);
    step2[4] = b.add(step1[4], step1[5]);
    step2[5] = b.sub(step1[4], step1[5]);
    step2[6] = b.add(b.neg(step1[6]), step1[7]);
    step2[7] = b.add(step1[6], step1[7]);
    step1[0] = b.add(step2[0], step2[3]);
    step1[1] = b.add(step2[1], step2[2]);
    step1[2] = b.sub(step2[1], step2[2]);
    step1[3] = b.sub(step2[0], step2[3]);
    step1[4] = step2[4];
    temp1 = b.mul(b.sub(step2[6], step2[5]), b.c(11585));
    temp2 = b.mul(b.add(step2[5], step2[6]), b.c(11585));
    step1[5] = rs14(b, temp1);
    step1[6] = rs14(b, temp2);
    step1[7] = step2[7];
    output[0] = b.add(step1[0], step1[7]);
    output[1] = b.add(step1[1], step1[6]);
    output[2] = b.add(step1[2], step1[5]);
    output[3] = b.add(step1[3], step1[4]);
    output[4] = b.sub(step1[3], step1[4]);
    output[5] = b.sub(step1[2], step1[5]);
    output[6] = b.sub(step1[1], step1[6]);
    output[7] = b.sub(step1[0], step1[7]);
    _ = .{ &input, &step1, &step2, &temp1, &temp2 };
    return output;
}

pub fn iadst8(b: anytype, input_p: [8]@TypeOf(b.c(0))) [8]@TypeOf(b.c(0)) {
    const V = @TypeOf(b.c(0));
    var input = input_p;
    var output: [8]V = undefined;
    var s0: V = undefined;
    var s1: V = undefined;
    var s2: V = undefined;
    var s3: V = undefined;
    var s4: V = undefined;
    var s5: V = undefined;
    var s6: V = undefined;
    var s7: V = undefined;
    var x0: V = input[7];
    var x1: V = input[0];
    var x2: V = input[5];
    var x3: V = input[2];
    var x4: V = input[3];
    var x5: V = input[4];
    var x6: V = input[1];
    var x7: V = input[6];
    s0 = b.add(b.mul(b.c(16305), x0), b.mul(b.c(1606), x1));
    s1 = b.sub(b.mul(b.c(1606), x0), b.mul(b.c(16305), x1));
    s2 = b.add(b.mul(b.c(14449), x2), b.mul(b.c(7723), x3));
    s3 = b.sub(b.mul(b.c(7723), x2), b.mul(b.c(14449), x3));
    s4 = b.add(b.mul(b.c(10394), x4), b.mul(b.c(12665), x5));
    s5 = b.sub(b.mul(b.c(12665), x4), b.mul(b.c(10394), x5));
    s6 = b.add(b.mul(b.c(4756), x6), b.mul(b.c(15679), x7));
    s7 = b.sub(b.mul(b.c(15679), x6), b.mul(b.c(4756), x7));
    x0 = rs14(b, b.add(s0, s4));
    x1 = rs14(b, b.add(s1, s5));
    x2 = rs14(b, b.add(s2, s6));
    x3 = rs14(b, b.add(s3, s7));
    x4 = rs14(b, b.sub(s0, s4));
    x5 = rs14(b, b.sub(s1, s5));
    x6 = rs14(b, b.sub(s2, s6));
    x7 = rs14(b, b.sub(s3, s7));
    s0 = x0;
    s1 = x1;
    s2 = x2;
    s3 = x3;
    s4 = b.add(b.mul(b.c(15137), x4), b.mul(b.c(6270), x5));
    s5 = b.sub(b.mul(b.c(6270), x4), b.mul(b.c(15137), x5));
    s6 = b.add(b.mul(b.neg(b.c(6270)), x6), b.mul(b.c(15137), x7));
    s7 = b.add(b.mul(b.c(15137), x6), b.mul(b.c(6270), x7));
    x0 = b.add(s0, s2);
    x1 = b.add(s1, s3);
    x2 = b.sub(s0, s2);
    x3 = b.sub(s1, s3);
    x4 = rs14(b, b.add(s4, s6));
    x5 = rs14(b, b.add(s5, s7));
    x6 = rs14(b, b.sub(s4, s6));
    x7 = rs14(b, b.sub(s5, s7));
    s2 = b.mul(b.c(11585), b.add(x2, x3));
    s3 = b.mul(b.c(11585), b.sub(x2, x3));
    s6 = b.mul(b.c(11585), b.add(x6, x7));
    s7 = b.mul(b.c(11585), b.sub(x6, x7));
    x2 = rs14(b, s2);
    x3 = rs14(b, s3);
    x6 = rs14(b, s6);
    x7 = rs14(b, s7);
    output[0] = x0;
    output[1] = b.neg(x4);
    output[2] = x6;
    output[3] = b.neg(x2);
    output[4] = x3;
    output[5] = b.neg(x7);
    output[6] = x5;
    output[7] = b.neg(x1);
    _ = .{ &input, &s0, &s1, &s2, &s3, &s4, &s5, &s6, &s7, &x0, &x1, &x2, &x3, &x4, &x5, &x6, &x7 };
    return output;
}

pub fn idct16(b: anytype, input_p: [16]@TypeOf(b.c(0))) [16]@TypeOf(b.c(0)) {
    const V = @TypeOf(b.c(0));
    var input = input_p;
    var output: [16]V = undefined;
    var step1: [16]V = undefined;
    var step2: [16]V = undefined;
    var temp1: V = undefined;
    var temp2: V = undefined;
    step1[0] = input[0];
    step1[1] = input[8];
    step1[2] = input[4];
    step1[3] = input[12];
    step1[4] = input[2];
    step1[5] = input[10];
    step1[6] = input[6];
    step1[7] = input[14];
    step1[8] = input[1];
    step1[9] = input[9];
    step1[10] = input[5];
    step1[11] = input[13];
    step1[12] = input[3];
    step1[13] = input[11];
    step1[14] = input[7];
    step1[15] = input[15];
    step2[0] = step1[0];
    step2[1] = step1[1];
    step2[2] = step1[2];
    step2[3] = step1[3];
    step2[4] = step1[4];
    step2[5] = step1[5];
    step2[6] = step1[6];
    step2[7] = step1[7];
    temp1 = b.sub(b.mul(step1[8], b.c(1606)), b.mul(step1[15], b.c(16305)));
    temp2 = b.add(b.mul(step1[8], b.c(16305)), b.mul(step1[15], b.c(1606)));
    step2[8] = rs14(b, temp1);
    step2[15] = rs14(b, temp2);
    temp1 = b.sub(b.mul(step1[9], b.c(12665)), b.mul(step1[14], b.c(10394)));
    temp2 = b.add(b.mul(step1[9], b.c(10394)), b.mul(step1[14], b.c(12665)));
    step2[9] = rs14(b, temp1);
    step2[14] = rs14(b, temp2);
    temp1 = b.sub(b.mul(step1[10], b.c(7723)), b.mul(step1[13], b.c(14449)));
    temp2 = b.add(b.mul(step1[10], b.c(14449)), b.mul(step1[13], b.c(7723)));
    step2[10] = rs14(b, temp1);
    step2[13] = rs14(b, temp2);
    temp1 = b.sub(b.mul(step1[11], b.c(15679)), b.mul(step1[12], b.c(4756)));
    temp2 = b.add(b.mul(step1[11], b.c(4756)), b.mul(step1[12], b.c(15679)));
    step2[11] = rs14(b, temp1);
    step2[12] = rs14(b, temp2);
    step1[0] = step2[0];
    step1[1] = step2[1];
    step1[2] = step2[2];
    step1[3] = step2[3];
    temp1 = b.sub(b.mul(step2[4], b.c(3196)), b.mul(step2[7], b.c(16069)));
    temp2 = b.add(b.mul(step2[4], b.c(16069)), b.mul(step2[7], b.c(3196)));
    step1[4] = rs14(b, temp1);
    step1[7] = rs14(b, temp2);
    temp1 = b.sub(b.mul(step2[5], b.c(13623)), b.mul(step2[6], b.c(9102)));
    temp2 = b.add(b.mul(step2[5], b.c(9102)), b.mul(step2[6], b.c(13623)));
    step1[5] = rs14(b, temp1);
    step1[6] = rs14(b, temp2);
    step1[8] = b.add(step2[8], step2[9]);
    step1[9] = b.sub(step2[8], step2[9]);
    step1[10] = b.add(b.neg(step2[10]), step2[11]);
    step1[11] = b.add(step2[10], step2[11]);
    step1[12] = b.add(step2[12], step2[13]);
    step1[13] = b.sub(step2[12], step2[13]);
    step1[14] = b.add(b.neg(step2[14]), step2[15]);
    step1[15] = b.add(step2[14], step2[15]);
    temp1 = b.mul(b.add(step1[0], step1[1]), b.c(11585));
    temp2 = b.mul(b.sub(step1[0], step1[1]), b.c(11585));
    step2[0] = rs14(b, temp1);
    step2[1] = rs14(b, temp2);
    temp1 = b.sub(b.mul(step1[2], b.c(6270)), b.mul(step1[3], b.c(15137)));
    temp2 = b.add(b.mul(step1[2], b.c(15137)), b.mul(step1[3], b.c(6270)));
    step2[2] = rs14(b, temp1);
    step2[3] = rs14(b, temp2);
    step2[4] = b.add(step1[4], step1[5]);
    step2[5] = b.sub(step1[4], step1[5]);
    step2[6] = b.add(b.neg(step1[6]), step1[7]);
    step2[7] = b.add(step1[6], step1[7]);
    step2[8] = step1[8];
    step2[15] = step1[15];
    temp1 = b.add(b.mul(b.neg(step1[9]), b.c(15137)), b.mul(step1[14], b.c(6270)));
    temp2 = b.add(b.mul(step1[9], b.c(6270)), b.mul(step1[14], b.c(15137)));
    step2[9] = rs14(b, temp1);
    step2[14] = rs14(b, temp2);
    temp1 = b.sub(b.mul(b.neg(step1[10]), b.c(6270)), b.mul(step1[13], b.c(15137)));
    temp2 = b.add(b.mul(b.neg(step1[10]), b.c(15137)), b.mul(step1[13], b.c(6270)));
    step2[10] = rs14(b, temp1);
    step2[13] = rs14(b, temp2);
    step2[11] = step1[11];
    step2[12] = step1[12];
    step1[0] = b.add(step2[0], step2[3]);
    step1[1] = b.add(step2[1], step2[2]);
    step1[2] = b.sub(step2[1], step2[2]);
    step1[3] = b.sub(step2[0], step2[3]);
    step1[4] = step2[4];
    temp1 = b.mul(b.sub(step2[6], step2[5]), b.c(11585));
    temp2 = b.mul(b.add(step2[5], step2[6]), b.c(11585));
    step1[5] = rs14(b, temp1);
    step1[6] = rs14(b, temp2);
    step1[7] = step2[7];
    step1[8] = b.add(step2[8], step2[11]);
    step1[9] = b.add(step2[9], step2[10]);
    step1[10] = b.sub(step2[9], step2[10]);
    step1[11] = b.sub(step2[8], step2[11]);
    step1[12] = b.add(b.neg(step2[12]), step2[15]);
    step1[13] = b.add(b.neg(step2[13]), step2[14]);
    step1[14] = b.add(step2[13], step2[14]);
    step1[15] = b.add(step2[12], step2[15]);
    step2[0] = b.add(step1[0], step1[7]);
    step2[1] = b.add(step1[1], step1[6]);
    step2[2] = b.add(step1[2], step1[5]);
    step2[3] = b.add(step1[3], step1[4]);
    step2[4] = b.sub(step1[3], step1[4]);
    step2[5] = b.sub(step1[2], step1[5]);
    step2[6] = b.sub(step1[1], step1[6]);
    step2[7] = b.sub(step1[0], step1[7]);
    step2[8] = step1[8];
    step2[9] = step1[9];
    temp1 = b.mul(b.add(b.neg(step1[10]), step1[13]), b.c(11585));
    temp2 = b.mul(b.add(step1[10], step1[13]), b.c(11585));
    step2[10] = rs14(b, temp1);
    step2[13] = rs14(b, temp2);
    temp1 = b.mul(b.add(b.neg(step1[11]), step1[12]), b.c(11585));
    temp2 = b.mul(b.add(step1[11], step1[12]), b.c(11585));
    step2[11] = rs14(b, temp1);
    step2[12] = rs14(b, temp2);
    step2[14] = step1[14];
    step2[15] = step1[15];
    output[0] = b.add(step2[0], step2[15]);
    output[1] = b.add(step2[1], step2[14]);
    output[2] = b.add(step2[2], step2[13]);
    output[3] = b.add(step2[3], step2[12]);
    output[4] = b.add(step2[4], step2[11]);
    output[5] = b.add(step2[5], step2[10]);
    output[6] = b.add(step2[6], step2[9]);
    output[7] = b.add(step2[7], step2[8]);
    output[8] = b.sub(step2[7], step2[8]);
    output[9] = b.sub(step2[6], step2[9]);
    output[10] = b.sub(step2[5], step2[10]);
    output[11] = b.sub(step2[4], step2[11]);
    output[12] = b.sub(step2[3], step2[12]);
    output[13] = b.sub(step2[2], step2[13]);
    output[14] = b.sub(step2[1], step2[14]);
    output[15] = b.sub(step2[0], step2[15]);
    _ = .{ &input, &step1, &step2, &temp1, &temp2 };
    return output;
}

pub fn iadst16(b: anytype, input_p: [16]@TypeOf(b.c(0))) [16]@TypeOf(b.c(0)) {
    const V = @TypeOf(b.c(0));
    var input = input_p;
    var output: [16]V = undefined;
    var s0: V = undefined;
    var s1: V = undefined;
    var s2: V = undefined;
    var s3: V = undefined;
    var s4: V = undefined;
    var s5: V = undefined;
    var s6: V = undefined;
    var s7: V = undefined;
    var s8: V = undefined;
    var s9: V = undefined;
    var s10: V = undefined;
    var s11: V = undefined;
    var s12: V = undefined;
    var s13: V = undefined;
    var s14: V = undefined;
    var s15: V = undefined;
    var x0: V = input[15];
    var x1: V = input[0];
    var x2: V = input[13];
    var x3: V = input[2];
    var x4: V = input[11];
    var x5: V = input[4];
    var x6: V = input[9];
    var x7: V = input[6];
    var x8: V = input[7];
    var x9: V = input[8];
    var x10: V = input[5];
    var x11: V = input[10];
    var x12: V = input[3];
    var x13: V = input[12];
    var x14: V = input[1];
    var x15: V = input[14];
    s0 = b.add(b.mul(x0, b.c(16364)), b.mul(x1, b.c(804)));
    s1 = b.sub(b.mul(x0, b.c(804)), b.mul(x1, b.c(16364)));
    s2 = b.add(b.mul(x2, b.c(15893)), b.mul(x3, b.c(3981)));
    s3 = b.sub(b.mul(x2, b.c(3981)), b.mul(x3, b.c(15893)));
    s4 = b.add(b.mul(x4, b.c(14811)), b.mul(x5, b.c(7005)));
    s5 = b.sub(b.mul(x4, b.c(7005)), b.mul(x5, b.c(14811)));
    s6 = b.add(b.mul(x6, b.c(13160)), b.mul(x7, b.c(9760)));
    s7 = b.sub(b.mul(x6, b.c(9760)), b.mul(x7, b.c(13160)));
    s8 = b.add(b.mul(x8, b.c(11003)), b.mul(x9, b.c(12140)));
    s9 = b.sub(b.mul(x8, b.c(12140)), b.mul(x9, b.c(11003)));
    s10 = b.add(b.mul(x10, b.c(8423)), b.mul(x11, b.c(14053)));
    s11 = b.sub(b.mul(x10, b.c(14053)), b.mul(x11, b.c(8423)));
    s12 = b.add(b.mul(x12, b.c(5520)), b.mul(x13, b.c(15426)));
