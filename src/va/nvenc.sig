// AV1's (clc9b7.h)
pub const SET_IN_AV1_PROBABILITY_DATA: u32 = 0x480;
pub const SET_OUT_AV1_PROBABILITY_DATA: u32 = 0x484;
pub const SET_IOENTROPY_ABOVE_CTX_DATA: u32 = 0x488;
pub const SET_IOENTROPY_ABOVE_MV_DATA: u32 = 0x48c;
pub const SET_IODEBLOCK_TOPROW: u32 = 0x490;
pub const SET_IODEBLOCK_LEFTCOLUMN: u32 = 0x494;
pub const SET_IOCDEF_LEFTCOLUMN: u32 = 0x498;
pub const SET_IOLR_LEFTCOLUMN: u32 = 0x49c;

pub const APPLICATION_ID_H264: u32 = 1;
pub const APPLICATION_ID_H265: u32 = 3;
pub const APPLICATION_ID_AV1: u32 = 7;

/// SET_CONTROL_PARAMS' CODEC_TYPE (3:0): clc9b7.h names only H264 (3),
/// NVDEC's number for it. HEVC's and AV1's are ASSUMED NVDEC's too (7,
/// 10).
pub const CODEC_TYPE_H264: u32 = 3;
pub const CODEC_TYPE_H265: u32 = 7;
pub const CODEC_TYPE_AV1: u32 = 10;
/// GPTIMER_ON (12): the watchdog, its timeout the setup's
/// gpTimer_timeout_val.
pub const CONTROL_GPTIMER_ON: u32 = 1 << 12;
/// RCMODE (31:24), nvenc_drv.h 3.1's list: constant QP; the firmware's
/// picture-level VBR and CBR (its state in the RC process buffer, used
/// when (rc_mode & 3) != 0). enc_rc.sig chooses.
pub const RCMODE_CONSTQP: u32 = 0;
pub const RCMODE_VBR: u32 = 1;
pub const RCMODE_CBR: u32 = 2;
pub const RCMODE_VBR_MINQP: u32 = 3;

pub const ENC_ERROR_H264_APPTIMER_EXPIRED: u32 = 0x3000_0001;
pub const ENC_ERROR_H264_INVALID_INPUT: u32 = 0x3000_0002;
pub const ENC_ERROR_H264_HWERR_INTERRUPT: u32 = 0x3000_0003;
pub const ENC_ERROR_H264_BAD_MAGIC: u32 = 0x3000_0004;

/// The setup's magic: the class in the high 16 bits, version 0, revision
/// 6, as every generation's NV_NVENC_DRV_MAGIC_VALUE (Ada's 0xc9b70006).
/// GB206's is ASSUMED to follow (GALAXY_VA_NVENC_MAGIC overrides it).
pub const MAGIC: u32 = (CLASS << 16) | 0x0006;
/// The watchdog's timeout, the decoder's (nvdec.GPTIMER_TIMEOUT).
pub const GPTIMER_TIMEOUT: u32 = nvdec.GPTIMER_TIMEOUT;

/// The engine's reference slots: SET_IN_REF_PIC{0..15}_{LUMA,CHROMA}.
pub const REF_SLOTS = 16;

pub const header = nvdec.header;
pub const shifted = nvdec.shifted;
pub const addressable = nvdec.addressable;

// ── Fields: where a setup struct's fields are ───────────────────────────────

/// A field: its first bit (from the struct's start, little endian) and
/// width.
pub const F = struct { bit: u32, width: u6 };

/// `v`'s low `f.width` bits into the field.
pub fn set(buf: []u8, f: F, v: u64) void {
    var k: u32 = 0;
    while (k < f.width) : (k += 1) {
        const b = f.bit + k;
        const mask = @as(u8, 1) << @intCast(b % 8);
        if ((v >> @intCast(k)) & 1 != 0) buf[b / 8] |= mask else buf[b / 8] &= ~mask;
    }
}

/// A signed value into the field (two's complement in its width).
pub fn setSigned(buf: []u8, f: F, v: i64) void {
    set(buf, f, @bitCast(v));
}

/// Element `i` of an array field whose elements are `f.width` bits.
pub fn at(f: F, i: u32) F {
    return .{ .bit = f.bit + i * f.width, .width = f.width };
}

pub fn get(buf: []const u8, f: F) u64 {
    var v: u64 = 0;
    var k: u32 = 0;
    while (k < f.width) : (k += 1) {
        const b = f.bit + k;
        if ((buf[b / 8] >> @intCast(b % 8)) & 1 != 0) v |= @as(u64, 1) << @intCast(k);
    }
    return v;
}

