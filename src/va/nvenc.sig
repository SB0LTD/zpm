pub const SET_WATCHDOG_TIMER: u32 = 0x204;
pub const EXECUTE: u32 = 0x300;
pub const SET_IN_REF_PIC0_LUMA: u32 = 0x400;
pub const SET_IN_REF_PIC0_CHROMA: u32 = 0x440;
