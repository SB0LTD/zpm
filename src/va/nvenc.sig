/// The ME control every picture uses: NVIDIA's own, byte for byte.
///
/// Where it is from: no open driver programs NVENC, but NVIDIA's closed
/// driver's jobs have been captured on hardware. switch-frame-tap
/// (github.com/TomasUribe/switch-frame-tap, MIT) recorded the Switch's
/// grc service (NVIDIA's Tegra encoder driver, NVENC 5.0, magic
/// 0xd0b70006) driving NVENC, and then encoded P frames itself with grc's
/// P setup (tier4/applet-mitm/source/nvenc_grc_p.h; "M85 Run K: P frames
/// in the live stream, no drift"; native 1080p P frames in "M92 Run S").
/// That setup's ME control (at its me_control_offset 0x600) is the bytes
/// below; nvenc_drv.h's nvenc_h264_me_control_s reads them as:
/// - qpel refinement, refine_on_search, constant lambda 0.5 (U8.3 4),
///   fps_mvcost, sps_mvcost, sps_cost_func;
/// - limit_mv on: x -2048..2047.75, y -512..511.75 (H.264's range);
/// - hints: spatial (stamp 1, search) and constant zero vector (stamp 2,
///   search), no temporal, co-located or external hint;
/// - stamps 0..4: 4, 9, 12, 13 and 20 points (not every point of 8x8);
/// - mbc_mb_size 110, partDecisionMadeByFPP, spatial_hint_pattern 0xf,
///   temporal_hint_pattern 0x3f, fbm_op_winner_num_p_frame 1 and _b_frame
///   l0/l1 1, fbm_select_best_cu32_parttype_num 3,
///   sps_evaluate_merge_cand_num 5, external/coloc hint order 1;
/// - hint types 0..4 in order.
///
/// This driver's own control before had every one of mbc_mb_size, the FBM
/// winner counts, the part-decision and merge-candidate counts zero (the
/// motion search configured to keep no winner). (pc-1111h was read then
/// as intra pictures encoding and inter ones failing; they did not: the
/// driver's "an encode failed" line for picture k comes after picture
/// k+1 is submitted, FFmpeg syncing one behind, and the first such line
/// was the IDR's. No NVENC picture of any codec has encoded on GB206 yet:
/// pc-1111h and pc-all.) HEVC's and AV1's setups name the same struct
/// (nvenc_me_control_s); these values are H.264's tuning, valid for them
/// too (the CU8/CU64 decisions left off).
pub const ME_NVIDIA = [Me.SIZE]u8{
    0x26, 0x40, 0x07, 0x00, 0x01, 0x40, 0x00, 0x08, 0xff, 0x1f, 0xff, 0x07, 0x00, 0x00, 0x90, 0x28,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x80, 0xa4, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x0c, 0x0c,
    0x00, 0x00, 0x00, 0x00, 0x03, 0x00, 0x00, 0x00, 0x00, 0x00, 0x1c, 0x1c, 0x1c, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x3e, 0x3e, 0x3e, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x08, 0x3e, 0x7f, 0x3e, 0x08, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x89, 0x1c, 0x1c, 0x7f,
    0x1c, 0x1c, 0x08, 0x81, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x6e, 0x04, 0xfe, 0x07, 0x49, 0x56, 0x00, 0x06, 0x00, 0x00, 0x88, 0x46, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
};

/// The ME control into `me` (Me.SIZE bytes): ME_NVIDIA.
pub fn meControl(me: []u8) void {
    @memcpy(me[0..Me.SIZE], &ME_NVIDIA);
}

/// The fields of the ME control past the hints (nvenc_h264_me_control_s,
/// generated as the rest): what ME_NVIDIA's test reads back.
pub const MeTail = struct {
    pub const mv_limit_enable: F = .{ .bit = 32, .width = 1 };
    pub const const_lambda: F = .{ .bit = 3, .width = 11 };
    pub const mbc_mb_size: F = .{ .bit = 1152, .width = 9 };
    pub const part_decision_by_fpp: F = .{ .bit = 1162, .width = 1 };
    pub const spatial_hint_pattern: F = .{ .bit = 1169, .width = 4 };
    pub const temporal_hint_pattern: F = .{ .bit = 1173, .width = 6 };
    pub const fbm_op_winner_num_p_frame: F = .{ .bit = 1184, .width = 3 };
    pub const fbm_op_winner_num_b_frame_l0: F = .{ .bit = 1187, .width = 3 };
    pub const fbm_op_winner_num_b_frame_l1: F = .{ .bit = 1190, .width = 3 };
    pub const fbm_select_best_cu32_parttype_num: F = .{ .bit = 1193, .width = 3 };
    pub const sps_evaluate_merge_cand_num: F = .{ .bit = 1196, .width = 3 };
};

/// The MEPRED buffers (SET_IN_MEPRED_DATA, SET_OUT_MEPRED_DATA): the
/// motion search's vectors of one picture, read by the next (nvenc_drv.h:
/// "vector hints produced by an earlier execute"). NVIDIA's driver binds
/// both on every inter picture, the two buffers swapping (grc: 128 KiB
/// each at 720p, 3600 macroblocks, under 37 bytes a macroblock); given
/// 256 bytes a macroblock here, for HEVC's and AV1's finer blocks.
pub const MEPRED_BYTES_PER_MB: usize = 256;

/// The history buffer (SET_IOHISTORY) a picture of `wmbs` x `hmbs`
/// macroblocks needs: NVIDIA's driver gives every macroblock of the
/// picture and a row more its block (grc: 80 x 46 x HIST_BLOCK_SIZE 192 =
/// 0xac800 at 720p), not nvenc_drv.h 2.3's one row; this driver gives
/// 256 bytes a block (H264_HIST_BLOCK_SIZE is 224).
pub fn historyBytes(wmbs: usize, hmbs: usize) usize {
    return std.mem.alignForward(usize, wmbs * (hmbs + 1) * 256, 4096);
}

/// surface_cfg's block_height for a block-linear input of 2^`gobs_log2`
/// GOBs a block: the number of GOBs. NVIDIA's Tegra driver writes 2 for
/// 16-row blocks, and NVENC read the input as 16-row blocks then
/// (switch-frame-tap's Run H: 42-48 dB with 16-row blocks, 9.5 dB or
/// less with any other reading); the GPU's other classes take log2, and
/// this driver wrote log2 (1) before. ASSUMED the same on GB206 (its
/// input_bl_mode 0 is the same "GPU BL").
pub fn blockHeightField(gobs_log2: u7) u7 {
    return @as(u7, 1) << @intCast(@min(gobs_log2, 5));
}

// ── The input picture, block linear ─────────────────────────────────────────

/// A GOB's lines for swizzle `s`: row y's line k (bytes k*lineBytes..) is
/// at lines[y][k] in the GOB (from tiling.gobOffset, the layouts' closed
/// forms).
fn Lines(comptime s: tiling.Swizzle) type {
    return [tiling.GOB_ROWS][tiling.GOB_WIDTH / s.lineBytes()]u16;
}

fn linesOf(comptime s: tiling.Swizzle) Lines(s) {
    @setEvalBranchQuota(20_000);
    var t: Lines(s) = undefined;
    const lw = s.lineBytes();
    for (0..tiling.GOB_ROWS) |y| {
        for (0..tiling.GOB_WIDTH / lw) |k| t[y][k] = tiling.gobOffset(s, k * lw, y);
    }
    return t;
}

const lines_turing = linesOf(.turing2d);
const lines_b8 = linesOf(.blackwell8);
const lines_b16 = linesOf(.blackwell16);

/// Rows [0, rows) and bytes [0, width) of the linear picture `src`
/// (`src_pitch` a row) into the block-linear plane `dst` (laid out as
/// `plane`, swizzled as `s`): tiling.tile's result, a GOB line at a time.
/// The encoder reads whole macroblocks and pads nothing itself
/// (nvenc_drv.h 2.1), so the picture is padded here to 16 bytes and 16
/// rows (within the plane) by repeating its last column and last row.
pub fn tile(dst: []u8, plane: tiling.Plane, s: tiling.Swizzle, src: []const u8, src_pitch: usize, width: usize, rows: usize) void {
    switch (s) {
        .turing2d => tileWith(.turing2d, &lines_turing, dst, plane, src, src_pitch, width, rows),
        .blackwell8 => tileWith(.blackwell8, &lines_b8, dst, plane, src, src_pitch, width, rows),
        .blackwell16 => tileWith(.blackwell16, &lines_b16, dst, plane, src, src_pitch, width, rows),
    }
}

fn tileWith(comptime s: tiling.Swizzle, lines: *const Lines(s), dst: []u8, plane: tiling.Plane, src: []const u8, src_pitch: usize, width: usize, rows: usize) void {
    const lw = comptime s.lineBytes();
    const across = plane.pitch / tiling.GOB_WIDTH;
    std.debug.assert(width <= plane.pitch and rows <= plane.rows and width > 0 and rows > 0);
    // (whole macroblocks, within the plane)
    const padded = @min(std.mem.alignForward(usize, width, 16), plane.pitch);
    const padded_rows = @min(std.mem.alignForward(usize, rows, 16), plane.rows);
    std.debug.assert(padded % lw == 0);
    for (0..padded_rows) |y| {
        const row_lines = &lines[y % tiling.GOB_ROWS];
        const gob = (y % tiling.BLOCK_ROWS) / tiling.GOB_ROWS;
        const first_block = (y / tiling.BLOCK_ROWS) * across;
        const in = src[@min(y, rows - 1) * src_pitch ..];
        var x: usize = 0;
        var col: usize = 0;
        while (x < padded) : (col += 1) {
            const base = (first_block + col) * tiling.BLOCK_BYTES + gob * tiling.GOB_BYTES;
            for (row_lines) |off| {
                if (x >= padded) break;
                const out = dst[base + off ..][0..lw];
                if (x + lw <= width) {
                    @memcpy(out, in[x..][0..lw]);
                } else if (x >= width) {
                    @memset(out, in[width - 1]);
                } else {
                    const n = width - x;
                    @memcpy(out[0..n], in[x..][0..n]);
                    @memset(out[n..], in[width - 1]);
                }
                x += lw;
            }
        }
    }
}

/// The app's linear NV12 picture (`lin`, `src`) into the encoder's input
/// (`layout`, block linear), the luma and chroma swizzles of `gob`.
pub fn tileNv12(dst: []u8, layout: tiling.Nv12, gob: tiling.Gob, src: []const u8, lin: tiling.Linear, width: u32, height: u32) void {
    tile(dst, layout.luma, gob.luma(), src, lin.pitch, width, height);
    const cw = 2 * ((width + 1) / 2);
    const ch = (height + 1) / 2;
    tile(dst[@intCast(layout.chroma_offset)..], layout.chroma, gob.chroma(), src[lin.uv_offset..], lin.pitch, cw, ch);
}

// ── One picture's pushbuffer ────────────────────────────────────────────────

/// Where one picture's inputs and outputs are (GPU addresses, 256-byte
/// aligned, below 1 << 40).
pub const PictureAddrs = struct {
    application_id: u32,
    codec_type: u32,
    setup: u64,
    status: u64,
    bitstream: u64,
    history: u64,
    rc_process: u64,
    /// the co-located motion buffers (0: the method left out, as
    /// nvenc_drv.h allows: the input for B pictures, the output for
    /// reference pictures)
    coloc_in: u64,
    coloc_out: u64,
    /// the motion search's vectors in and out (0: left out; NVIDIA's
    /// driver sends both on every inter picture: MEPRED_BYTES_PER_MB)
    mepred_in: u64 = 0,
    mepred_out: u64 = 0,
    /// the input picture's planes (block linear)
    cur_luma: u64,
    cur_chroma: u64,
    /// SET_IN_CUR_PIC_CHROMA_V (0: not sent): semi-planar, the same as
    /// cur_chroma, as NVIDIA's driver sends it on GB206 (HEVC, AV1)
    cur_chroma_v: u64 = 0,
    /// SET_IN_RCDATA (0: not sent): the rate control's statistics buffer
    /// (nvenc_rc_pic_stat_s, then a record a macroblock row), which NVIDIA's
    /// driver binds on every picture on GB206; without it AV1's engine read
    /// VA 0 and HEVC's faulted (pc-full13)
    rc_data: u64 = 0,
    /// the reconstructed picture's planes (the engine's layout)
    out_luma: u64,
    out_chroma: u64,
    /// the references' planes, by reference slot (0: unused)
    ref_luma: [REF_SLOTS]u64 = [_]u64{0} ** REF_SLOTS,
    ref_chroma: [REF_SLOTS]u64 = [_]u64{0} ** REF_SLOTS,
    picture_index: u32,
    /// SET_CONTROL_PARAMS' RCMODE
    rc_mode: u32 = RCMODE_CONSTQP,
    /// AV1's buffers
    av1: ?Av1Addrs = null,
};

/// AV1's own buffers (256-byte aligned).
pub const Av1Addrs = struct {
    /// the CDFs the picture starts from, and where its adapted ones go
    prob_in: u64,
    prob_out: u64,
    above_ctx: u64,
    above_mv: u64,
    deblock_top: u64,
    deblock_left: u64,
    cdef_left: u64,
    lr_left: u64,
};

/// The most dwords a picture takes.
pub const PUSH_DWORDS_MAX = 2 * (19 + 2 * REF_SLOTS + 8) + 2;

fn put(out: []u32, n: *usize, method: u32, value: u32) void {
    out[n.*] = header(0, method, 1);
    out[n.* + 1] = value;
    n.* += 2;
}

/// One picture's methods into `out`: the encoder bound, the application,
/// the controls, the setup, the status, the bitstream, the scratch
/// buffers, the pictures, then EXECUTE (the kernel's fence follows). Only
/// the references in use are sent (nvenc_drv.h 2.4), and only the motion
/// buffers given. Its length.
pub fn push(out: []u32, a: PictureAddrs) usize {
    var n: usize = 0;
    put(out, &n, SET_OBJECT, CLASS | SET_OBJECT_ENGINE_SW);
    put(out, &n, SET_APPLICATION_ID, a.application_id);
    put(out, &n, SET_CONTROL_PARAMS, a.codec_type | CONTROL_FORCE_OUT_PIC | CONTROL_GPTIMER_ON | (a.rc_mode << 24));
    put(out, &n, SET_PICTURE_INDEX, a.picture_index);
    put(out, &n, SET_IN_DRV_PIC_SETUP, shifted(a.setup));
    put(out, &n, SET_OUT_ENC_STATUS, shifted(a.status));
    put(out, &n, SET_OUT_BITSTREAM, shifted(a.bitstream));
    put(out, &n, SET_IOHISTORY, shifted(a.history));
    put(out, &n, SET_IO_RC_PROCESS, shifted(a.rc_process));
    if (a.coloc_in != 0) put(out, &n, SET_IN_COLOC_DATA, shifted(a.coloc_in));
    if (a.coloc_out != 0) put(out, &n, SET_OUT_COLOC_DATA, shifted(a.coloc_out));
    put(out, &n, SET_OUT_REF_PIC_LUMA, shifted(a.out_luma));
    put(out, &n, SET_OUT_REF_PIC_CHROMA, shifted(a.out_chroma));
    put(out, &n, SET_IN_CUR_PIC, shifted(a.cur_luma));
    put(out, &n, SET_IN_CUR_PIC_CHROMA_U, shifted(a.cur_chroma));
    if (a.cur_chroma_v != 0) put(out, &n, SET_IN_CUR_PIC_CHROMA_V, shifted(a.cur_chroma_v));
    if (a.rc_data != 0) put(out, &n, SET_IN_RCDATA, shifted(a.rc_data));
    // (semi-planar, input_cfg's memory_mode 0: V is interleaved with U,
    // and NVIDIA's driver sends no SET_IN_CUR_PIC_CHROMA_V: grc's jobs
    // bind CHROMA_U only)
    if (a.mepred_in != 0) put(out, &n, SET_IN_MEPRED_DATA, shifted(a.mepred_in));
    if (a.mepred_out != 0) put(out, &n, SET_OUT_MEPRED_DATA, shifted(a.mepred_out));
    for (0..REF_SLOTS) |i| {
        if (a.ref_luma[i] == 0) continue;
        const k: u32 = @intCast(i);
        put(out, &n, SET_IN_REF_PIC0_LUMA + 4 * k, shifted(a.ref_luma[i]));
        put(out, &n, SET_IN_REF_PIC0_CHROMA + 4 * k, shifted(a.ref_chroma[i]));
    }
    if (a.av1) |v| {
        put(out, &n, SET_IN_AV1_PROBABILITY_DATA, shifted(v.prob_in));
        put(out, &n, SET_OUT_AV1_PROBABILITY_DATA, shifted(v.prob_out));
        put(out, &n, SET_IOENTROPY_ABOVE_CTX_DATA, shifted(v.above_ctx));
        put(out, &n, SET_IOENTROPY_ABOVE_MV_DATA, shifted(v.above_mv));
        put(out, &n, SET_IODEBLOCK_TOPROW, shifted(v.deblock_top));
        put(out, &n, SET_IODEBLOCK_LEFTCOLUMN, shifted(v.deblock_left));
        put(out, &n, SET_IOCDEF_LEFTCOLUMN, shifted(v.cdef_left));
        put(out, &n, SET_IOLR_LEFTCOLUMN, shifted(v.lr_left));
    }
    put(out, &n, EXECUTE, 0);
    std.debug.assert(n <= PUSH_DWORDS_MAX);
    return n;
}

/// Whose status struct a picture's is.
pub const StatKind = enum { h264, hevc, av1 };

/// What the engine said of a picture (its status).
pub const Result = struct {
    /// the status's picture_index: SET_PICTURE_INDEX's value once the
    /// engine wrote the status (statusPoison's before)
    picture_index: u32 = 0,
    /// 2 on every picture of NVIDIA's own driver too, the encoded ones
    /// included (switch-frame-tap: grc's 129 jobs and its own live
    /// frames, decoded bit for bit): routine, not a failure. This driver
    /// took it for one before and dropped every picture's slices.
    error_status: u32,
    ucode_error: u32,
    bits: u32,
    slices: u32,
    avg_qp: u32,
    start: u32,
    last_valid: u32 = 0,
    cycles: u32 = 0,
    /// intra and inter macroblocks (H.264), 32x32 CUs (HEVC)
    intra_count: u32 = 0,
    inter_count: u32 = 0,
    /// the best intra and inter modes' summed SATDs (the rate control's
    /// complexity measure; 0 when the engine wrote none)
    intra_cost: u32 = 0,
    inter_cost: u32 = 0,
    /// AV1: the QP index and loop-filter level the engine used, and its
    /// CDEF damping, for the frame header
    av1_qindex: u32 = 0,
    av1_lf_level: u32 = 0,
    av1_cdef_damping_minus_3: u32 = 0,

    pub fn of(stat: []const u8) Result {
        return ofKind(stat, .h264);
    }

    pub fn ofKind(stat: []const u8, kind: StatKind) Result {
        if (kind == .av1) {
            return .{
                .picture_index = @intCast(get(stat, Stat.picture_index)),
                .error_status = @intCast(get(stat, Av1Stat.error_status)),
                .ucode_error = @intCast(get(stat, Av1Stat.ucode_error_status)),
                .bits = @intCast(get(stat, Av1Stat.total_bit_count)),
                .slices = @intCast(get(stat, Av1Stat.num_tiles)),
                .avg_qp = @intCast(get(stat, Av1Stat.avg_qp)),
                .start = @intCast(get(stat, Av1Stat.bitstream_start_pos)),
                .intra_cost = @intCast(get(stat, Av1Stat.total_intra_cost)),
                .inter_cost = @intCast(get(stat, Av1Stat.total_inter_cost)),
                .av1_qindex = @intCast(get(stat, Av1Stat.av1_start_qp)),
                .av1_lf_level = @intCast(get(stat, Av1Stat.loop_filter_level)),
                .av1_cdef_damping_minus_3 = @intCast(get(stat, Av1Stat.cdef_damping_minus_3)),
            };
        }
        const costs = if (kind == .hevc) [2]F{ H265Stat.total_intra_cost, H265Stat.total_inter_cost } else [2]F{ Stat.total_intra_cost, Stat.total_inter_cost };
        const counts = if (kind == .hevc) [2]F{ H265Stat.intra_cu32x32_count, H265Stat.inter_cu32x32_count } else [2]F{ Stat.intra_mb_count, Stat.inter_mb_count };
        return .{
            .picture_index = @intCast(get(stat, Stat.picture_index)),
            .error_status = @intCast(get(stat, Stat.error_status)),
            .ucode_error = @intCast(get(stat, Stat.ucode_error_status)),
            .bits = @intCast(get(stat, Stat.total_bit_count)),
            .slices = @intCast(get(stat, Stat.num_slices)),
            .avg_qp = @intCast(get(stat, Stat.avg_qp)),
            .start = @intCast(get(stat, Stat.bitstream_start_pos)),
            .last_valid = @intCast(get(stat, Stat.last_valid_byte_offset)),
            .cycles = @intCast(get(stat, Stat.cycle_count)),
            .intra_count = @intCast(get(stat, counts[0])),
            .inter_count = @intCast(get(stat, counts[1])),
            .intra_cost = @intCast(get(stat, costs[0])),
            .inter_cost = @intCast(get(stat, costs[1])),
        };
    }

    /// The picture is lost: the firmware said why (ucode_error_status), or
    /// wrote no bits. error_status is not looked at (2 is routine).
    pub fn failed(r: Result) bool {
        return r.ucode_error != 0 or r.bits == 0;
    }

    /// Whether the engine wrote this status (its picture index came back).
    pub fn written(r: Result, picture_index: u32) bool {
        return r.picture_index == picture_index;
    }

    /// The bytes of slices the engine wrote (its bit count, whole bytes).
    pub fn bytes(r: Result) u32 {
        return (r.bits + 7) / 8;
    }
};

// ── Tests ───────────────────────────────────────────────────────────────────

const testing = std.testing;

test "nvenc: fields set and read back, signed ones two's complement" {
    var b = [_]u8{0} ** H264.SIZE;
    set(&b, H264.magic, MAGIC);
    try testing.expectEqual(@as(u32, 0xcfb7_0006), std.mem.readInt(u32, b[0..4], .little));
    setSigned(&b, H264.pic_init_qp_minus26, -3);
    try testing.expectEqual(@as(u64, 0x3d), get(&b, H264.pic_init_qp_minus26));
    set(&b, H264.pic_type, 3);
    set(&b, H264.ref_pic_flag, 1);
    // pic_struct 0, pic_type 3, ref_pic_flag 1: bits 0..4 of byte 424
    try testing.expectEqual(@as(u8, 0x1c), b[3392 / 8]);
    set(&b, at(H264.l0, 2), 0xff);
    try testing.expectEqual(@as(u8, 0xff), b[1600 / 8 + 2]);
    // (neighbours untouched)
    try testing.expectEqual(@as(u64, 0x3d), get(&b, H264.pic_init_qp_minus26));
    try testing.expectEqual(@as(u64, 0), get(&b, H264.chroma_qp_index_offset));
}

var tile_src: [200 * 70]u8 = undefined;
var tile_a: [64 * 1024]u8 = undefined;
var tile_b: [64 * 1024]u8 = undefined;

test "nvenc: the input's tiling is tiling.tile's, padded at the right edge" {
    const cases = [_][2]u32{ .{ 64, 16 }, .{ 40, 24 }, .{ 130, 33 }, .{ 200, 70 }, .{ 17, 9 } };
    inline for (.{ tiling.Swizzle.turing2d, tiling.Swizzle.blackwell8, tiling.Swizzle.blackwell16 }) |s| {
        for (cases) |c| {
            const w = c[0];
            const h = c[1];
            const pitch: usize = 200;
            for (&tile_src, 0..) |*p, i| p.* = @truncate(i *% 2654435761 >> 9);
            const plane = tiling.Plane.of(w, h);
            @memset(tile_a[0..plane.bytes()], 0);
            @memset(tile_b[0..plane.bytes()], 0);
            tiling.tile(&tile_a, plane, s, &tile_src, pitch, w, h);
            tile(&tile_b, plane, s, &tile_src, pitch, w, h);
            for (0..std.mem.alignForward(usize, h, 16)) |y| {
                const sy = @min(y, h - 1);
                for (0..w) |x| try testing.expectEqual(tile_src[sy * pitch + x], tile_b[plane.offsetOf(s, x, y)]);
                if (y < h) {
                    for (0..w) |x| try testing.expectEqual(tile_a[plane.offsetOf(s, x, y)], tile_b[plane.offsetOf(s, x, y)]);
                }
                // past the width, to the macroblock's end: the last byte again
                for (w..std.mem.alignForward(usize, w, 16)) |x| try testing.expectEqual(tile_src[sy * pitch + w - 1], tile_b[plane.offsetOf(s, x, y)]);
            }
        }
    }
}

test "nvenc: a picture's pushbuffer, word by word" {
    var a = PictureAddrs{
        .application_id = APPLICATION_ID_H264,
        .codec_type = CODEC_TYPE_H264,
        .setup = 0x1_0000_0800,
        .status = 0x2_0000_0100,
        .bitstream = 0x2_0000_1100,
        .history = 0x1_0010_0000,
        .rc_process = 0x1_0020_0000,
        .coloc_in = 0x1_0030_0000,
        .coloc_out = 0x1_0040_0000,
        .cur_luma = 0x3_0000_0000,
        .cur_chroma = 0x3_0010_0000,
        .out_luma = 0x4_0000_0000,
        .out_chroma = 0x4_0010_0000,
        .picture_index = 9,
    };
    a.ref_luma[3] = 0x5_0000_0000;
    a.ref_chroma[3] = 0x5_0010_0000;
    var out: [PUSH_DWORDS_MAX]u32 = undefined;
    const n = push(&out, a);
    try testing.expectEqual(@as(usize, 2 * 18), n);
    const want = [_]u32{
        0x2001_0000, 0x001f_cfb7, // SET_OBJECT
        0x2001_0080, 1, // SET_APPLICATION_ID H264
        0x2001_01c0, 3 | (1 << 8) | (1 << 12), // SET_CONTROL_PARAMS: FORCE_OUT_PIC, GPTIMER_ON
        0x2001_01c1, 9, // SET_PICTURE_INDEX
        0x2001_01c4, 0x100_0008, // SET_IN_DRV_PIC_SETUP
        0x2001_01c6, 0x200_0001, // SET_OUT_ENC_STATUS
        0x2001_01c7, 0x200_0011, // SET_OUT_BITSTREAM
    };
    try testing.expectEqualSlices(u32, &want, out[0..want.len]);
    // the reference in slot 3, then EXECUTE; no CHROMA_V (semi-planar:
    // NVIDIA's driver sends CHROMA_U alone)
    try testing.expectEqual(header(0, SET_IN_REF_PIC0_LUMA + 12, 1), out[30]);
    try testing.expectEqual(@as(u32, 0x500_0000), out[31]);
    try testing.expectEqual(header(0, SET_IN_REF_PIC0_CHROMA + 12, 1), out[32]);
    try testing.expectEqual(@as(u32, 0x2001_00c0), out[34]);
    var k0: usize = 0;
    while (k0 < n) : (k0 += 2) try testing.expect(out[k0] != header(0, SET_IN_CUR_PIC_CHROMA_V, 1));

    // an inter picture as NVIDIA's driver sends it: the MEPRED buffers in
    // and out, no co-located motion (a P picture that is not a reference
    // here): two methods in, two out
    a.coloc_in = 0;
    a.coloc_out = 0;
    a.mepred_in = 0x1_0050_0000;
    a.mepred_out = 0x1_0060_0000;
    const m = push(&out, a);
    try testing.expectEqual(@as(usize, 2 * 18), m);
    var saw_in = false;
    var saw_out = false;
    var k: usize = 0;
    while (k < m) : (k += 2) {
        try testing.expect(out[k] != header(0, SET_IN_COLOC_DATA, 1) and out[k] != header(0, SET_OUT_COLOC_DATA, 1));
        if (out[k] == header(0, SET_IN_MEPRED_DATA, 1)) {
            try testing.expectEqual(@as(u32, 0x100_5000), out[k + 1]);
            saw_in = true;
        }
        if (out[k] == header(0, SET_OUT_MEPRED_DATA, 1)) {
            try testing.expectEqual(@as(u32, 0x100_6000), out[k + 1]);
            saw_out = true;
        }
    }
    try testing.expect(saw_in and saw_out);
}

test "nvenc: the ME control is NVIDIA's: winners kept, its cache, its hints" {
    var me = [_]u8{0} ** (Me.SIZE + 8);
    meControl(&me);
    try testing.expectEqualSlices(u8, &ME_NVIDIA, me[0..Me.SIZE]);
    // (nvenc_drv.h's fields, read back where gcc puts them)
    try testing.expectEqual(@as(u64, 1), get(&me, Me.refinement_mode));
    try testing.expectEqual(@as(u64, 1), get(&me, Me.lambda_mode));
    try testing.expectEqual(@as(u64, 4), get(&me, MeTail.const_lambda));
    try testing.expectEqual(@as(u64, 1), get(&me, MeTail.mv_limit_enable));
    try testing.expectEqual(@as(u64, 1), get(&me, Me.spatial_enable));
    try testing.expectEqual(@as(u64, 1), get(&me, Me.spatial_search));
    try testing.expectEqual(@as(u64, 0), get(&me, Me.temporal_enable));
    try testing.expectEqual(@as(u64, 1), get(&me, Me.const_mv_enable));
    try testing.expectEqual(@as(u64, 110), get(&me, MeTail.mbc_mb_size));
    try testing.expectEqual(@as(u64, 1), get(&me, MeTail.part_decision_by_fpp));
    try testing.expectEqual(@as(u64, 0xf), get(&me, MeTail.spatial_hint_pattern));
    try testing.expectEqual(@as(u64, 0x3f), get(&me, MeTail.temporal_hint_pattern));
    try testing.expectEqual(@as(u64, 1), get(&me, MeTail.fbm_op_winner_num_p_frame));
    try testing.expectEqual(@as(u64, 1), get(&me, MeTail.fbm_op_winner_num_b_frame_l0));
    try testing.expectEqual(@as(u64, 1), get(&me, MeTail.fbm_op_winner_num_b_frame_l1));
    try testing.expectEqual(@as(u64, 3), get(&me, MeTail.fbm_select_best_cu32_parttype_num));
    try testing.expectEqual(@as(u64, 5), get(&me, MeTail.sps_evaluate_merge_cand_num));
    const types = [_]F{ Me.hint_type0, Me.hint_type1, Me.hint_type2, Me.hint_type3, Me.hint_type4 };
    for (types, 0..) |f, i| try testing.expectEqual(@as(u64, i), get(&me, f));
    // stamp 0: the 4 points around the predictor
    try testing.expectEqual(@as(u64, 0x0c0c_0000), get(&me, Me.shape0));
    // (nothing past the struct)
    try testing.expectEqualSlices(u8, &[_]u8{0} ** 8, me[Me.SIZE..]);
}

test "nvenc: the history covers the picture, the input's block height counts GOBs" {
    // grc's 720p history: 80 x 46 blocks of 192; this driver's 256
    try testing.expect(historyBytes(80, 45) >= 0xac800);
    try testing.expectEqual(@as(usize, 0), historyBytes(120, 68) % 4096);
    try testing.expectEqual(@as(u7, 2), blockHeightField(1));
    try testing.expectEqual(@as(u7, 1), blockHeightField(0));
    try testing.expectEqual(@as(u7, 16), blockHeightField(4));
}

// NVIDIA's own driver's first setups on GB206 (captured in WSL, driver
// 592.15, FFmpeg's av1_nvenc and hevc_nvenc on 1080p testsrc2: a key frame,
// an IDR), their first 1024 bytes: the layout this file reads them with
// must make sense of them.

test "nvenc: NVIDIA's own GB206 AV1 setup reads right with Av1 (the fourth surface configuration, 800 bytes)" {
    const b = NV_AV1_KEY;
    const A = Av1;
    try testing.expectEqual(@as(u64, MAGIC), get(b, A.magic));
    try testing.expectEqual(@as(u64, 1919), get(b, A.outputpic_cfg_frame_width_minus1));
    // the fourth configuration: the reconstruction's
    try testing.expectEqual(@as(u64, 1919), get(b, A.extra_cfg_frame_width_minus1));
    try testing.expectEqual(@as(u64, 1079), get(b, A.extra_cfg_frame_height_minus1));
    try testing.expectEqual(@as(u64, 1920), get(b, A.extra_cfg_sfc_pitch));
    // the sequence header 4:2:0, 8 bits; the picture control's tiles,
    // sizes, type and codec field
    try testing.expectEqual(@as(u64, 1), get(b, A.chroma_format_idc));
    try testing.expectEqual(@as(u64, 0), get(b, A.bit_depth_minus_8));
    try testing.expectEqual(@as(u64, 0x400), get(b, A.tile_control_offset));
    try testing.expectEqual(@as(u64, 0x4f_bb00), get(b, A.bitstream_buf_size));
    try testing.expectEqual(@as(u64, 3), get(b, A.pic_type));
    try testing.expectEqual(@as(u64, 1), get(b, A.ref_pic_flag));
    try testing.expectEqual(@as(u64, PIC_CODEC_AV1), get(b, A.codec));
    try testing.expectEqual(@as(u64, 1), get(b, A.num_tile_cols));
    try testing.expectEqual(@as(u64, 1), get(b, A.strips_in_frame));
    // the ME control where it starts (its first word as H.264's) and the
    // GP timer after it (bit 31 set, as NVIDIA's driver sets it)
    try testing.expectEqual(@as(u32, 0x0007_4002), std.mem.readInt(u32, b[A.ME_CONTROL_OFF..][0..4], .little));
    try testing.expect(get(b, A.gp_timer_timeout_val) >> 31 == 1);
    try testing.expect(A.ME_CONTROL_OFF + Me.SIZE + 4 == A.SIZE);
}

test "nvenc: NVIDIA's own GB206 HEVC setup reads right with H265" {
    const b = NV_HEVC_IDR;
    const H = H265;
    try testing.expectEqual(@as(u64, MAGIC), get(b, H.magic));
    try testing.expectEqual(@as(u64, 1087), get(b, H.outputpic_cfg_frame_height_minus1));
    try testing.expectEqual(@as(u64, 3), get(b, H.pic_type));
    try testing.expectEqual(@as(u64, 19), get(b, H.nal_unit_type));
    try testing.expectEqual(@as(u64, PIC_CODEC_H265), get(b, H.codec));
    try testing.expectEqual(@as(u64, 11), get(b, H.ceil_log2_pic_size_in_ctbs));
    try testing.expectEqual(@as(u64, 0), get(b, H.sps_temporal_mvp_enabled_flag));
    try testing.expect(get(b, H.gp_timer_timeout_val) >> 31 == 1);
}
