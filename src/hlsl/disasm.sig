//! @zpm/hlsl disasm — a DXBC container as fxc's listing (what
//! D3DDisassemble gives): the signatures as comments, then the program,
//! one declaration or instruction per line in Shader Model 4/5 assembly.
//! Any container: ours or another compiler's.

const std = @import("std");
const ir = @import("ir.sig");
const ct = @import("container.sig");

pub const Error = error{ NotDxbc, NoShader, BadToken, NoSpace };

const W = std.Io.Writer;

/// The listing of `blob` into `out`; its length.
pub fn disassemble(blob: []const u8, out: []u8) Error!usize {
    var w = W.fixed(out);
    listing(blob, &w) catch |e| return switch (e) {
        error.WriteFailed => error.NoSpace,
        else => |x| x,
    };
    return w.end;
}

fn listing(blob: []const u8, w: *W) (Error || W.Error)!void {
    if (blob.len < 32 or !std.mem.eql(u8, blob[0..4], "DXBC")) return error.NotDxbc;
    const code = ct.findChunk(blob, "SHEX") orelse ct.findChunk(blob, "SHDR") orelse return error.NoShader;
    var refl: ct.Reflection = undefined;
    const creator = if (ct.findChunk(blob, "RDEF")) |r| blk: {
        if (!refl.read(r)) break :blk "";
        break :blk refl.creator;
    } else "";
    try w.print("//\n// Generated by {s}\n//\n//\n", .{if (creator.len > 0) creator else "an unknown compiler"});
    if (ct.findChunk(blob, "ISGN")) |s| try sigComment(w, "Input signature", s, false, false);
    if (ct.findChunk(blob, "OSGN")) |s| try sigComment(w, "Output signature", s, false, true) else if (ct.findChunk(blob, "OSG5")) |s| try sigComment(w, "Output signature", s, true, true);
    if (code.len < 8) return error.BadToken;
    const toks: []align(1) const u32 = @as([*]align(1) const u32, @ptrCast(code.ptr))[0 .. code.len / 4];
    const ver = toks[0];
    const stage: []const u8 = switch (ver >> 16) {
        0 => "ps",
        1 => "vs",
        2 => "gs",
        3 => "hs",
        4 => "ds",
        5 => "cs",
        else => "??",
    };
    try w.print("{s}_{d}_{d}\n", .{ stage, (ver >> 4) & 0xf, ver & 0xf });
    const len = @min(toks[1], toks.len);
    var at: usize = 2;
    var count: u32 = 0;
    while (at < len) {
        const tok = toks[at];
        const op: ir.Op = @enumFromInt(@as(u16, @truncate(tok & 0x7ff)));
        if (op == .customdata) {
            if (at + 1 >= len) return error.BadToken;
            const n = toks[at + 1];
            if (n < 2 or at + n > len) return error.BadToken;
            try w.writeAll("dcl_immediateConstantBuffer {");
            var k: usize = 2;
            while (k + 4 <= n) : (k += 4) {
                try w.print("{s} {{ {d}, {d}, {d}, {d}}}", .{ if (k > 2) "," else "", toks[at + k], toks[at + k + 1], toks[at + k + 2], toks[at + k + 3] });
            }
            try w.writeAll(" }\n");
            at += n;
            continue;
        }
        const n = (tok >> 24) & 0x7f;
        if (n == 0 or at + n > len) return error.BadToken;
        try inst(w, toks[at .. at + n], op);
        if (!isDcl(op)) count += 1;
        at += n;
    }
    try w.print("// Approximately {d} instruction slots used\n", .{count});
}

fn isDcl(op: ir.Op) bool {
    const n = @intFromEnum(op);
    return (n >= 88 and n <= 106) or n == 143 or op == .customdata;
}

fn sigComment(w: *W, title: []const u8, d: []const u8, streams: bool, output: bool) W.Error!void {
    try w.print("//\n// {s}:\n//\n// Name                 Index   Mask Register SysValue  Format   Used\n// -------------------- ----- ------ -------- -------- ------- ------\n", .{title});
    if (d.len < 8) return;
    const n = std.mem.readInt(u32, d[0..4], .little);
    const stride: usize = if (streams) 28 else 24;
    for (0..n) |k| {
        var at = 8 + k * stride + (stride - 24);
        if (at + 24 > d.len) break;
        const name_off = std.mem.readInt(u32, d[at..][0..4], .little);
        const name = if (name_off < d.len) std.mem.sliceTo(d[name_off..], 0) else "";
        at += 4;
        const index = std.mem.readInt(u32, d[at..][0..4], .little);
        const sys = std.mem.readInt(u32, d[at + 4 ..][0..4], .little);
        const comp = std.mem.readInt(u32, d[at + 8 ..][0..4], .little);
        const reg = std.mem.readInt(u32, d[at + 12 ..][0..4], .little);
        const mask = d[at + 16];
        // (an output's byte is its never-written mask)
        const rw = if (output) mask & ~d[at + 17] else d[at + 17];
        var mb: [4]u8 = undefined;
        var ub: [4]u8 = undefined;
        try w.print("// {s: <20} {d: >5}   {s} {d: >8} {s: >8} {s: >7}   {s}\n", .{ name, index, maskStr(mask, &mb), reg, sysName(sys), switch (comp) {
            1 => "uint",
            2 => "int",
            3 => "float",
            else => "unknown",
        }, maskStr(rw, &ub) });
    }
    try w.writeAll("//\n");
}

fn maskStr(m: u8, b: *[4]u8) []const u8 {
    const l = "xyzw";
    for (0..4) |c| b[c] = if (m & (@as(u8, 1) << @intCast(c)) != 0) l[c] else ' ';
    return b;
}

fn sysName(s: u32) []const u8 {
    return switch (s) {
        0 => "NONE",
        1 => "POS",
        2 => "CLIPDST",
        3 => "CULLDST",
        4 => "RTINDEX",
        5 => "VPINDEX",
        6 => "VERTID",
        7 => "PRIMID",
        8 => "INSTID",
        9 => "FFACE",
        10 => "SAMPLE",
        64 => "TARGET",
        65 => "DEPTH",
        66 => "COVERAGE",
        else => "?",
    };
}

const names = struct {
    fn of(op: ir.Op) []const u8 {
        return switch (op) {
            .@"and" => "and",
            .@"or" => "or",
            .@"break" => "break",
            .@"continue" => "continue",
            .@"else" => "else",
            .@"if" => "if",
            .@"switch" => "switch",
            .deriv_rtx => "deriv_rtx",
            .deriv_rty => "deriv_rty",
            .dcl_constant_buffer => "dcl_constantbuffer",
            .dcl_global_flags => "dcl_globalFlags",
            .dcl_indexable_temp => "dcl_indexableTemp",
            .dcl_gs_input_primitive => "dcl_inputprimitive",
            .dcl_gs_output_primitive_topology => "dcl_outputtopology",
            .dcl_max_output_vertex_count => "dcl_maxout",
            .firstbit_hi => "firstbit_hi",
            else => @tagName(op),
        };
    }
};

/// Float ops show their immediates as floats; the rest as integers.
fn floatImm(op: ir.Op) bool {
    return switch (op) {
        .add, .mul, .div, .mad, .min, .max, .eq, .ne, .lt, .ge, .frc, .round_ne, .round_ni, .round_pi, .round_z, .exp, .log, .rsq, .sqrt, .rcp, .dp2, .dp3, .dp4, .sincos, .sample_l, .sample_b, .sample_c, .sample_c_lz, .sample_d, .ftoi, .ftou, .deriv_rtx, .deriv_rty, .mov, .movc => true,
        else => false,
    };
}

fn inst(w: *W, t: []align(1) const u32, op: ir.Op) (Error || W.Error)!void {
    const tok = t[0];
    const ctl = (tok >> 11) & 0x1fff;
    var p: usize = 1;
    var ext = tok & 0x8000_0000 != 0;
    var offs: ?[3]i8 = null;
    while (ext and p < t.len) {
        const e = t[p];
        p += 1;
        ext = e & 0x8000_0000 != 0;
        if (e & 0x3f == 1) offs = .{ sx4(e >> 9), sx4(e >> 13), sx4(e >> 17) };
    }
    switch (op) {
        .dcl_temps => return w.print("dcl_temps {d}\n", .{if (t.len > 1) t[1] else 0}),
        .dcl_global_flags => return w.print("dcl_globalFlags{s}\n", .{if (ctl & 1 != 0) " refactoringAllowed" else ""}),
        .dcl_max_output_vertex_count => return w.print("dcl_maxout {d}\n", .{if (t.len > 1) t[1] else 0}),
        .dcl_gs_input_primitive => return w.print("dcl_inputprimitive {s}\n", .{switch (ctl & 0x3f) {
            1 => "point",
            2 => "line",
            3 => "triangle",
            6 => "lineadj",
            7 => "triangleadj",
            else => "?",
        }}),
        .dcl_gs_output_primitive_topology => return w.print("dcl_outputtopology {s}\n", .{switch (ctl & 0x3f) {
            1 => "pointlist",
            3 => "linestrip",
            5 => "trianglestrip",
            else => "?",
        }}),
        else => {},
    }
    // the mnemonic
    switch (op) {
        .dcl_resource => {
            const dim = ctl & 0x1f;
            try w.print("dcl_resource_{s} ", .{switch (dim) {
                1 => "buffer",
                2 => "texture1d",
                3 => "texture2d",
                4 => "texture2dms",
                5 => "texture3d",
                6 => "texturecube",
                7 => "texture1darray",
                8 => "texture2darray",
                9 => "texture2dmsarray",
                10 => "texturecubearray",
                else => "unknown",
            }});
            if (t.len >= 2) {
                const rt = t[t.len - 1];
                try w.writeAll("(");
                for (0..4) |c| try w.print("{s}{s}", .{ if (c > 0) "," else "", switch ((rt >> @intCast(c * 4)) & 0xf) {
                    1 => "unorm",
                    2 => "snorm",
                    3 => "sint",
                    4 => "uint",
                    5 => "float",
                    else => "mixed",
                } });
                try w.writeAll(") ");
            }
        },
        .dcl_input_ps, .dcl_input_ps_siv, .dcl_input_ps_sgv => {
            try w.print("{s} {s} ", .{ names.of(op), switch (ctl & 0xf) {
                1 => "constant",
                2 => "linear",
                3 => "linear centroid",
                4 => "linear noperspective",
                5 => "linear noperspective centroid",
                6 => "linear sample",
                7 => "linear noperspective sample",
                else => "",
            } });
        },
        .resinfo => try w.print("resinfo{s} ", .{switch (ctl & 3) {
            1 => "_rcpFloat",
            2 => "_uint",
            else => "",
        }}),
        else => {
            try w.writeAll(names.of(op));
            if (ctl & 0x4 != 0 and !isDcl(op)) try w.writeAll("_sat");
            switch (op) {
                .@"if", .breakc, .continuec, .discard, .retc => try w.writeAll(if (ctl & 0x80 != 0) "_nz" else "_z"),
                else => {},
            }
            if (offs) |o| try w.print("_aoffimmi({d},{d},{d})", .{ o[0], o[1], o[2] });
            try w.writeAll(" ");
        },
    }
    // the operands
    var first = true;
    const decl = isDcl(op);
    if (op == .dcl_constant_buffer and t.len >= p + 3) {
        // (fxc's form: CB0[7])
        try w.print("CB{d}[{d}]", .{ t[p + 1], t[p + 2] });
        p = t.len;
        first = false;
    }
    while (p < t.len) {
        if (decl and !first) break;
        if (!first) try w.writeAll(", ");
        first = false;
        p = try operand(w, t, p, floatImm(op));
    }
    switch (op) {
        .dcl_constant_buffer => try w.writeAll(if (ctl & 1 != 0) ", dynamicIndexed" else ", immediateIndexed"),
        .dcl_sampler => try w.writeAll(if (ctl & 0xf == 1) ", mode_comparison" else ", mode_default"),
        .dcl_input_siv, .dcl_input_sgv, .dcl_input_ps_siv, .dcl_input_ps_sgv, .dcl_output_siv, .dcl_output_sgv => if (t.len > p) try w.print(", {s}", .{switch (t[p]) {
            1 => "position",
            2 => "clip_distance",
            3 => "cull_distance",
            4 => "rendertarget_array_index",
            5 => "viewport_array_index",
            6 => "vertex_id",
            7 => "primitive_id",
            8 => "instance_id",
            9 => "is_front_face",
            10 => "sampleIndex",
            else => "?",
        }}),
        else => {},
    }
    try w.writeAll("\n");
}

fn sx4(v: u32) i8 {
    const n: u4 = @truncate(v);
    return @as(i8, @as(i4, @bitCast(n)));
}

fn operand(w: *W, t: []align(1) const u32, p0: usize, fl: bool) (Error || W.Error)!usize {
    var p = p0;
    if (p >= t.len) return error.BadToken;
    const tok = t[p];
    p += 1;
    var mods: u32 = 0;
    if (tok & 0x8000_0000 != 0) {
        if (p >= t.len) return error.BadToken;
        const e = t[p];
        p += 1;
        if (e & 0x3f == 1) mods = (e >> 6) & 0xff;
    }
    const reg: ir.Reg = @enumFromInt(@as(u8, @truncate(tok >> 12)));
    const comps = tok & 3;
    const dims = (tok >> 20) & 3;
    if (mods & 1 != 0) try w.writeAll("-");
    if (mods & 2 != 0) try w.writeAll("|");
    if (reg == .imm32) {
        const n: usize = if (comps == 1) 1 else 4;
        if (p + n > t.len) return error.BadToken;
        try w.writeAll("l(");
        for (0..n) |k| {
            const v = t[p + k];
            if (k > 0) try w.writeAll(", ");
            if (fl) try w.print("{d:.6}", .{@as(f32, @bitCast(v))}) else if (v > 0xffff and v < 0xffff0000) try w.print("0x{x:0>8}", .{v}) else try w.print("{d}", .{@as(i32, @bitCast(v))});
        }
        try w.writeAll(")");
        p += n;
    } else {
        const prefix: []const u8 = switch (reg) {
            .temp => "r",
            .input => "v",
            .output => "o",
            .indexable_temp => "x",
            .sampler => "s",
            .resource => "t",
            .cb => "cb",
            .icb => "icb",
            .label => "l",
            .input_primitive_id => "vPrim",
            .output_depth => "oDepth",
            .null => "null",
            .input_coverage_mask => "vCoverage",
            else => "?",
        };
        try w.writeAll(prefix);
        for (0..dims) |d| {
            const repr = (tok >> @intCast(22 + d * 3)) & 7;
            const bracket = !(d == 0 and (reg == .temp or reg == .output or reg == .sampler or reg == .resource or reg == .cb or reg == .indexable_temp or (reg == .input and dims == 1)));
            if (bracket) try w.writeAll("[");
            var imm: u32 = 0;
            if (repr == 0 or repr == 3) {
                if (p >= t.len) return error.BadToken;
                imm = t[p];
                p += 1;
            }
            if (repr == 2 or repr == 3) {
                p = try operand(w, t, p, false);
                try w.print(" + {d}", .{imm});
            } else try w.print("{d}", .{imm});
            if (bracket) try w.writeAll("]");
        }
        if (comps == 2) {
            const mode = (tok >> 2) & 3;
            const sel = (tok >> 4) & 0xff;
            const l = "xyzw";
            try w.writeAll(".");
            switch (mode) {
                0 => for (0..4) |c| {
                    if (sel & (@as(u32, 1) << @intCast(c)) != 0) try w.writeByte(l[c]);
                },
                1 => for (0..4) |c| try w.writeByte(l[(sel >> @intCast(c * 2)) & 3]),
                else => try w.writeByte(l[sel & 3]),
            }
        }
    }
    if (mods & 2 != 0) try w.writeAll("|");
    return p;
}

test "a listing of a compiled shader" {
    const hlsl = @import("hlsl.sig");
    const S = struct {
        var c: hlsl.Compiler = undefined;
        var out: [16 * 1024]u8 = undefined;
    };
    const r = S.c.compile("cbuffer B : register(b0) { float4 k; }; float4 main(float4 p : SV_Position, float2 uv : TEXCOORD0) : SV_Target { return k * uv.x + abs(-uv.y); }", .{ .target = "ps_4_0" });
    try std.testing.expect(r.ok);
    const n = try disassemble(r.blob, &S.out);
    const s = S.out[0..n];
    errdefer std.debug.print("{s}\n", .{s});
    try std.testing.expect(std.mem.indexOf(u8, s, "ps_4_0") != null);
    try std.testing.expect(std.mem.indexOf(u8, s, "dcl_constantbuffer CB0[1], immediateIndexed") != null);
    try std.testing.expect(std.mem.indexOf(u8, s, "TEXCOORD") != null);
    try std.testing.expect(std.mem.indexOf(u8, s, "ret") != null);
}
