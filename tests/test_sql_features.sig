.{ .id = "F312.merge", .ordered = false, .closed = true, .statements = &.{
    .{ .source = "CREATE TABLE t(id INT PRIMARY KEY, v INT)", .head = "C:CREATE TABLE;Z:I", .rows = &.{} },
    .{ .source = "CREATE TABLE s(id INT, v INT)", .head = "C:CREATE TABLE;Z:I", .rows = &.{} },
    .{ .source = "INSERT INTO t VALUES (1, 10), (2, 20)", .head = "C:INSERT 0 2;Z:I", .rows = &.{} },
    .{ .source = "INSERT INTO s VALUES (2, 200), (3, 300)", .head = "C:INSERT 0 2;Z:I", .rows = &.{} },
    .{ .source = "MERGE INTO t USING s ON t.id = s.id WHEN MATCHED THEN UPDATE SET v = s.v WHEN NOT MATCHED THEN INSERT VALUES (s.id, s.v)", .head = "C:MERGE 2;Z:I", .rows = &.{} },
    .{ .source = "SELECT id, v FROM t ORDER BY id", .head = "T:id/23/4/-1,v/23/4/-1;C:SELECT 3;Z:I", .rows = &.{"1|10", "2|200", "3|300"} },
} },
.{ .id = "F313.enhanced_merge", .ordered = false, .closed = true, .statements = &.{
    .{ .source = "CREATE TABLE t(id INT PRIMARY KEY, v INT)", .head = "C:CREATE TABLE;Z:I", .rows = &.{} },
    .{ .source = "CREATE TABLE s(id INT, v INT)", .head = "C:CREATE TABLE;Z:I", .rows = &.{} },
    .{ .source = "INSERT INTO t VALUES (1, 10), (2, 20), (3, 30)", .head = "C:INSERT 0 3;Z:I", .rows = &.{} },
    .{ .source = "INSERT INTO s VALUES (1, 1), (2, 2), (4, 4), (5, 5)", .head = "C:INSERT 0 4;Z:I", .rows = &.{} },
    .{ .source = "MERGE INTO t USING s ON t.id = s.id WHEN MATCHED AND s.v = 1 THEN UPDATE SET v = 100 WHEN MATCHED THEN UPDATE SET v = t.v + s.v WHEN NOT MATCHED AND s.v > 4 THEN INSERT (id, v) VALUES (s.id, s.v) WHEN NOT MATCHED THEN DO NOTHING", .head = "C:MERGE 3;Z:I", .rows = &.{} },
    .{ .source = "SELECT id, v FROM t ORDER BY id", .head = "T:id/23/4/-1,v/23/4/-1;C:SELECT 4;Z:I", .rows = &.{"1|100", "2|22", "3|30", "5|5"} },
} },
.{ .id = "F314.merge_delete", .ordered = false, .closed = true, .statements = &.{
    .{ .source = "CREATE TABLE t(id INT PRIMARY KEY, v INT)", .head = "C:CREATE TABLE;Z:I", .rows = &.{} },
    .{ .source = "CREATE TABLE s(id INT, del BOOLEAN)", .head = "C:CREATE TABLE;Z:I", .rows = &.{} },
    .{ .source = "INSERT INTO t VALUES (1, 10), (2, 20), (3, 30)", .head = "C:INSERT 0 3;Z:I", .rows = &.{} },
    .{ .source = "INSERT INTO s VALUES (1, true), (2, false)", .head = "C:INSERT 0 2;Z:I", .rows = &.{} },
    .{ .source = "MERGE INTO t USING s ON t.id = s.id WHEN MATCHED AND s.del THEN DELETE WHEN MATCHED THEN UPDATE SET v = 0", .head = "C:MERGE 2;Z:I", .rows = &.{} },
    .{ .source = "SELECT id, v FROM t ORDER BY id", .head = "T:id/23/4/-1,v/23/4/-1;C:SELECT 2;Z:I", .rows = &.{"2|0", "3|30"} },
} },
