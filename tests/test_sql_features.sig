    .{ .source = "SELECT g, v, percent_rank() OVER w, cume_dist() OVER w FROM t WINDOW w AS (PARTITION BY g ORDER BY v)", .head = "T:g/25/-1/-1,v/23/4/-1,percent_rank/701/8/-1,cume_dist/701/8/-1;C:SELECT 4;Z:I", .rows = &.{"a|10|0|0.3333333333333333", "a|20|0.5|0.6666666666666666", "a|30|1|1", "b|5|0|1"} },
    .{ .source = "SELECT v, sum(v) OVER (ORDER BY v RANGE BETWEEN 10 PRECEDING AND CURRENT ROW), max(v) OVER (ORDER BY v ROWS BETWEEN UNBOUNDED PRECEDING AND 1 FOLLOWING EXCLUDE CURRENT ROW) FROM t", .head = "T:v/23/4/-1,sum/20/8/-1,max/23/4/-1;C:SELECT 4;Z:I", .rows = &.{"5|5|10", "10|15|20", "20|30|30", "30|50|20"} },
