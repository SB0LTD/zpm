    .{ .source = "SELECT DISTINCT j FROM t", .head = "T:j/3802/-1/-1;C:SELECT 2;Z:I", .rows = &.{"[1]", "{\x22a\x22: 1\x5c, \x22b\x22: 2}"} },
    .{ .source = "SELECT count(DISTINCT j) FROM t", .head = "T:count/20/8/-1;C:SELECT 1;Z:I", .rows = &.{"2"} },
