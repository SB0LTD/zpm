.{ .id = "T879.json_equality", .ordered = false, .closed = true, .statements = &.{
    .{ .source = "SELECT '{\x22a\x22: 1, \x22b\x22: 2}'::jsonb = '{\x22b\x22: 2, \x22a\x22: 1}'::jsonb, '[1, 2]'::jsonb = '[2, 1]'::jsonb, '1.0'::jsonb = '1'::jsonb, '{\x22a\x22: 1}'::jsonb <> '{\x22a\x22: \x221\x22}'::jsonb", .head = "T:?column?/16/1/-1,?column?/16/1/-1,?column?/16/1/-1,?column?/16/1/-1;C:SELECT 1;Z:I", .rows = &.{"t|f|t|t"} },
    .{ .source = "CREATE TABLE t(j JSONB)", .head = "C:CREATE TABLE;Z:I", .rows = &.{} },
