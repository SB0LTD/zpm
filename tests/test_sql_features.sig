    .{ .source = "SELECT grantee, table_name, column_name, privilege_type FROM information_schema.column_privileges WHERE grantee = 'w4f_r' ORDER BY column_name, privilege_type", .head = "T:grantee/19/64/-1,table_name/19/64/-1,column_name/19/64/-1,privilege_type/1043/-1/-1;C:SELECT 3;Z:I", .rows = &.{"w4f_r|t|a|SELECT", "w4f_r|t|b|SELECT", "w4f_r|t|b|UPDATE"} },
