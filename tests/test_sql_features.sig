    .{ .source = "SELECT g, v, row_number() OVER (PARTITION BY g ORDER BY v), rank() OVER (PARTITION BY g ORDER BY v), dense_rank() OVER (ORDER BY v DESC) FROM t", .head = "T:g/25/-1/-1,v/23/4/-1,row_number/20/8/-1,rank/20/8/-1,dense_rank/20/8/-1;C:SELECT 4;Z:I", .rows = &.{"a|20|2|2|1", "a|20|3|2|1", "a|10|1|1|2", "b|5|1|1|3"} },
    .{ .source = "SELECT g, v, sum(v) OVER (PARTITION BY g), count(*) OVER (), avg(v) OVER (ORDER BY v ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) FROM t", .head = "T:g/25/-1/-1,v/23/4/-1,sum/20/8/-1,count/20/8/-1,avg/1700/-1/-1;C:SELECT 4;Z:I", .rows = &.{"a|10|50|4|7.5000000000000000", "a|20|50|4|15.0000000000000000", "a|20|50|4|20.0000000000000000", "b|5|5|4|5.0000000000000000"} },
