    .{ .source = "SELECT 1/0", .head = "E:22012;Z:E", .rows = &.{} },
    .{ .source = "ROLLBACK TO a", .head = "C:ROLLBACK;Z:T", .rows = &.{} },
    .{ .source = "INSERT INTO t VALUES (4)", .head = "C:INSERT 0 1;Z:T", .rows = &.{} },
    .{ .source = "COMMIT", .head = "C:COMMIT;Z:I", .rows = &.{} },
