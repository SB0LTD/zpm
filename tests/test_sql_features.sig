    .{ .source = "SELECT a, b, pg_typeof(a), pg_typeof(b) FROM t", .head = "T:a/23/4/-1,b/1043/-1/7,pg_typeof/2206/4/-1,pg_typeof/2206/4/-1;C:SELECT 1;Z:I", .rows = &.{"1|abc|pos|code"} },
    .{ .source = "SELECT CAST(5 AS pos), CAST(-5 AS pos)", .head = "E:23514;Z:I", .rows = &.{} },
