.{ .id = "F131-01.grouped_view_clauses", .ordered = false, .closed = true, .statements = &.{
    .{ .source = "CREATE TABLE t(g INT, v INT)", .head = "C:CREATE TABLE;Z:I", .rows = &.{} },
    .{ .source = "INSERT INTO t VALUES (1, 10), (1, 20), (2, 5), (3, 7), (3, 8)", .head = "C:INSERT 0 5;Z:I", .rows = &.{} },
    .{ .source = "CREATE VIEW gv AS SELECT g, sum(v) AS s, count(*) AS n FROM t GROUP BY g", .head = "C:CREATE VIEW;Z:I", .rows = &.{} },
    .{ .source = "SELECT g, s FROM gv WHERE s > 10", .head = "T:g/23/4/-1,s/20/8/-1;C:SELECT 2;Z:I", .rows = &.{"3|15", "1|30"} },
    .{ .source = "SELECT n, count(*) FROM gv GROUP BY n HAVING count(*) >= 1", .head = "T:n/20/8/-1,count/20/8/-1;C:SELECT 2;Z:I", .rows = &.{"2|2", "1|1"} },
} },
.{ .id = "F131-02.grouped_view_join", .ordered = false, .closed = true, .statements = &.{
    .{ .source = "CREATE TABLE t(g INT, v INT)", .head = "C:CREATE TABLE;Z:I", .rows = &.{} },
    .{ .source = "CREATE TABLE names(g INT, name TEXT)", .head = "C:CREATE TABLE;Z:I", .rows = &.{} },
    .{ .source = "INSERT INTO t VALUES (1, 10), (1, 20), (2, 5)", .head = "C:INSERT 0 3;Z:I", .rows = &.{} },
    .{ .source = "INSERT INTO names VALUES (1, 'one'), (2, 'two')", .head = "C:INSERT 0 2;Z:I", .rows = &.{} },
    .{ .source = "CREATE VIEW gv AS SELECT g, sum(v) AS s FROM t GROUP BY g", .head = "C:CREATE VIEW;Z:I", .rows = &.{} },
    .{ .source = "SELECT names.name, gv.s FROM gv JOIN names ON names.g = gv.g", .head = "T:name/25/-1/-1,s/20/8/-1;C:SELECT 2;Z:I", .rows = &.{"one|30", "two|5"} },
} },
.{ .id = "F131-03.grouped_view_aggregate", .ordered = false, .closed = true, .statements = &.{
    .{ .source = "CREATE TABLE t(g INT, v INT)", .head = "C:CREATE TABLE;Z:I", .rows = &.{} },
    .{ .source = "INSERT INTO t VALUES (1, 10), (1, 20), (2, 5)", .head = "C:INSERT 0 3;Z:I", .rows = &.{} },
    .{ .source = "CREATE VIEW gv AS SELECT g, sum(v) AS s FROM t GROUP BY g", .head = "C:CREATE VIEW;Z:I", .rows = &.{} },
    .{ .source = "SELECT max(s), min(s), sum(s), count(*) FROM gv", .head = "T:max/20/8/-1,min/20/8/-1,sum/1700/-1/-1,count/20/8/-1;C:SELECT 1;Z:I", .rows = &.{"30|5|35|2"} },
} },
.{ .id = "F131-04.grouped_view_subquery", .ordered = false, .closed = true, .statements = &.{
    .{ .source = "CREATE TABLE t(g INT, v INT)", .head = "C:CREATE TABLE;Z:I", .rows = &.{} },
    .{ .source = "INSERT INTO t VALUES (1, 10), (1, 20), (2, 5), (2, 1)", .head = "C:INSERT 0 4;Z:I", .rows = &.{} },
    .{ .source = "CREATE VIEW gv AS SELECT g, sum(v) AS s FROM t GROUP BY g HAVING count(*) > 1", .head = "C:CREATE VIEW;Z:I", .rows = &.{} },
    .{ .source = "SELECT g FROM gv WHERE s = (SELECT max(s) FROM gv)", .head = "T:g/23/4/-1;C:SELECT 1;Z:I", .rows = &.{"1"} },
    .{ .source = "SELECT g FROM t WHERE g IN (SELECT g FROM gv GROUP BY g HAVING max(s) > 6) GROUP BY g", .head = "T:g/23/4/-1;C:SELECT 1;Z:I", .rows = &.{"1"} },
} },
.{ .id = "F131-05.grouped_view_single_row", .ordered = false, .closed = true, .statements = &.{
    .{ .source = "CREATE TABLE t(g INT, v INT)", .head = "C:CREATE TABLE;Z:I", .rows = &.{} },
    .{ .source = "INSERT INTO t VALUES (1, 10), (1, 20), (2, 5)", .head = "C:INSERT 0 3;Z:I", .rows = &.{} },
    .{ .source = "CREATE VIEW gv AS SELECT g, sum(v) AS s FROM t GROUP BY g", .head = "C:CREATE VIEW;Z:I", .rows = &.{} },
    .{ .source = "SELECT s FROM gv WHERE g = 1", .head = "T:s/20/8/-1;C:SELECT 1;Z:I", .rows = &.{"30"} },
    .{ .source = "SELECT count(*) FROM gv GROUP BY s HAVING s = 30", .head = "T:count/20/8/-1;C:SELECT 1;Z:I", .rows = &.{"1"} },
} },
