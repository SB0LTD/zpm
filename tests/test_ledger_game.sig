const std = @import("std");
const game = @import("ledger_world");
const wire = @import("action_wire");
const funding = @import("action_funding");
const graphics = @import("scene3d");
const storage = @import("state_wire");
var assertions: usize = 0;
fn check(ok: bool) !void { assertions += 1; if (!ok) return error.ContractFailed; }
fn rejects(expected: anyerror, result: anytype) !void {
    if (result) |_| return error.InvalidAccepted else |actual| try check(actual == expected);
}
pub fn main(init: std.process.Init) !void {
    const owner: game.Key = @splat(1);
    const stranger: game.Key = @splat(2);
    const rules: game.Rules = .{};
    var player: game.Player = .{ .owner = owner };
    var nodes = [_]game.Node{.{ .position = .{ .x = 1 } }};
    var monsters = [_]game.Monster{.{ .position = .{ .z = 1 } }};
    var action: game.Action = .{ .world = 1, .nonce = 0, .actor = owner, .kind = .mine };
    try rejects(error.Unauthorized, game.apply(rules, &player, &nodes, &monsters, action, .{ .signer = stranger, .slot = 0 }));
    try check(player.nonce == 0 and nodes[0].remaining == 100);
    try game.apply(rules, &player, &nodes, &monsters, action, .{ .signer = owner, .slot = 0 });
    try check(player.ore == 1 and player.xp == 10 and player.nonce == 1);
    try rejects(error.Replay, game.apply(rules, &player, &nodes, &monsters, action, .{ .signer = owner, .slot = 4 }));
    action.nonce = 1;
    try rejects(error.Cooldown, game.apply(rules, &player, &nodes, &monsters, action, .{ .signer = owner, .slot = 1 }));
    try rejects(error.Cooldown, game.apply(rules, &player, &nodes, &monsters, action, .{ .signer = owner, .slot = 2 }));
    try game.apply(rules, &player, &nodes, &monsters, action, .{ .signer = owner, .slot = 4 });
    action.nonce = 2;
    try game.apply(rules, &player, &nodes, &monsters, action, .{ .signer = owner, .slot = 8 });
    action.nonce = 3; action.kind = .craft;
    try game.apply(rules, &player, &nodes, &monsters, action, .{ .signer = owner, .slot = 10 });
    try check(player.ore == 0 and player.bars == 1 and player.xp == 50);
    action.nonce = 4;
    try rejects(error.MissingResource, game.apply(rules, &player, &nodes, &monsters, action, .{ .signer = owner, .slot = 12 }));
    try check(player.nonce == 4 and player.bars == 1);
    action.kind = .attack;
    try game.apply(rules, &player, &nodes, &monsters, action, .{ .signer = owner, .slot = 12 });
    action.nonce = 5;
    try game.apply(rules, &player, &nodes, &monsters, action, .{ .signer = owner, .slot = 14 });
    try check(monsters[0].hp == 0 and player.xp == 100 and player.hp == 93);
    action.nonce = 6; action.kind = .move; action.position = .{ .x = 4 };
    try rejects(error.OutOfRange, game.apply(rules, &player, &nodes, &monsters, action, .{ .signer = owner, .slot = 16 }));
    action.position = .{ .x = 1 };
    try game.apply(rules, &player, &nodes, &monsters, action, .{ .signer = owner, .slot = 16 });
    try check(player.position.x == 1);
    action.nonce = 7; action.kind = .rest; action.position = .{};
    try game.apply(rules, &player, &nodes, &monsters, action, .{ .signer = owner, .slot = 18 });
    try check(player.hp == 100);
    action.nonce = 8; action.kind = .mine;
    player.ore = 999;
    try rejects(error.InventoryFull, game.apply(rules, &player, &nodes, &monsters, action, .{ .signer = owner, .slot = 20 }));
    try check(nodes[0].remaining == 97 and player.nonce == 8);
    player.ore = 0; player.xp = 0xffffffff;
    try rejects(error.Exhausted, game.apply(rules, &player, &nodes, &monsters, action, .{ .signer = owner, .slot = 20 }));
    try check(nodes[0].remaining == 97 and player.ore == 0);
    action.kind = .move; action.position = .{ .x = -32768, .z = 32767 };
    var bytes = wire.encode(action);
    const decoded = try wire.decode(&bytes);
    try check(decoded.position.x == -32768 and decoded.position.z == 32767 and decoded.nonce == 8 and game.sameKey(decoded.actor, owner));
    try check(bytes[0] == 1 and bytes[1] == 1 and bytes[4] == 1 and bytes[12] == 8 and bytes[53] == 128);
    try rejects(error.InvalidLength, wire.decode(bytes[0..59]));
    bytes[2] = 1; try rejects(error.NonCanonical, wire.decode(&bytes)); bytes[2] = 0;
    bytes[1] = 99; try rejects(error.InvalidKind, wire.decode(&bytes)); bytes[1] = 1;
    bytes[0] = 2; try rejects(error.InvalidVersion, wire.decode(&bytes));
    var pool: funding.Pool = .{ .available = 10000 };
    var reservation = try funding.reserve(&pool, .{ .fee_cap = 6000, .margin = 1000, .expires_slot = 10 }, 0);
    try check(pool.available == 3000 and pool.reserved == 7000);
    try rejects(error.Unfunded, funding.reserve(&pool, .{ .fee_cap = 6000, .margin = 0, .expires_slot = 10 }, 0));
    try rejects(error.FeeExceeded, funding.settle(&pool, &reservation, 6001));
    try check(reservation.active and pool.reserved == 7000);
    try funding.settle(&pool, &reservation, 5000);
    try check(pool.available == 4000 and pool.reserved == 0 and pool.spent == 5000 and pool.profit == 1000);
    try rejects(error.AlreadyConsumed, funding.settle(&pool, &reservation, 5000));
    try rejects(error.Expired, funding.reserve(&pool, .{ .fee_cap = 1, .margin = 0, .expires_slot = 10 }, 10));
    try rejects(error.Overflow, funding.total(.{ .fee_cap = 0xffffffffffffffff, .margin = 1, .expires_slot = 10 }));
    var cancelled = try funding.reserve(&pool, .{ .fee_cap = 1000, .margin = 100, .expires_slot = 10 }, 0);
    try funding.cancel(&pool, &cancelled);
    try check(pool.available == 4000 and pool.reserved == 0);
    try rejects(error.AlreadyConsumed, funding.cancel(&pool, &cancelled));
    var gate: funding.Gate = .{};
    var schedule: funding.RetrySchedule = .{};
    try check(schedule.ads == 1 and schedule.retry() and schedule.ads == 2);
    try check(schedule.retry() and schedule.ads == 4 and schedule.retry() and schedule.ads == 8 and !schedule.retry());
    schedule.reset(); try check(schedule.ads == 1);
    try check(!gate.submit() and !gate.verified());
    try check(gate.begin() and !gate.begin() and gate.watch());
    try check(!gate.submit() and gate.completed() and !gate.submit());
    try check(gate.verified() and gate.submit() and !gate.submit() and !gate.dismiss());
    try check(gate.resolved() and gate.begin() and gate.dismiss());
    try check(gate.begin() and gate.pay() and gate.submit() and gate.resolved());
    var scene: graphics.Scene(12) = .{};
    try scene.cube(.{ .x = 0, .y = 0, .z = 0 }, .{ .x = 1, .y = 1, .z = 1 }, .{ .r = 1, .g = 1, .b = 1 });
    try rejects(error.Capacity, scene.cube(.{ .x = 0, .y = 0, .z = 0 }, .{ .x = 1, .y = 1, .z = 1 }, .{ .r = 1, .g = 1, .b = 1 }));
    try check(scene.count == 12);
    const camera: graphics.Camera = .{};
    const projected = camera.project(.{ .x = 0, .y = 0, .z = 0 }, 1) orelse return error.InvisibleOrigin;
    try check(projected.depth > 0 and projected.x == 0);
    try check(camera.project(camera.position, 1) == null and camera.project(.{ .x = 0, .y = 0, .z = 0 }, 0) == null);
    var player_bytes = storage.encodePlayer(.{ .world = 0x123456789abcdef0, .player = player });
    const player_record = try storage.decodePlayer(&player_bytes);
    try check(player_record.world == 0x123456789abcdef0 and player_record.player.xp == player.xp and player_record.player.nonce == player.nonce and game.sameKey(player_record.player.owner,owner));
    try check(player_bytes[8] == 0xf0 and player_bytes[15] == 0x12);
    player_bytes[66] = 1; try rejects(error.NonCanonical,storage.decodePlayer(&player_bytes));
    try rejects(error.InvalidLength,storage.decodePlayer(player_bytes[0..79]));
    const node_bytes = storage.encodeNode(.{ .world = 7, .id = 3, .node = nodes[0] });
    const node_record = try storage.decodeNode(&node_bytes);
    try check(node_record.id == 3 and node_record.world == 7 and node_record.node.remaining == 97);
    var monster_bytes = storage.encodeMonster(.{ .world = 8, .id = 4, .monster = monsters[0] });
    const monster_record = try storage.decodeMonster(&monster_bytes);
    try check(monster_record.id == 4 and monster_record.monster.hp == 0);
    monster_bytes[0] = 'X'; try rejects(error.InvalidHeader,storage.decodeMonster(&monster_bytes));
    var buffer: [160]u8 = undefined;
    const report = try std.fmt.bufPrint(&buffer, "ZPM ledger-game contracts PASS: {d} assertions\n", .{assertions});
    try std.Io.File.stdout().writeStreamingAll(init.io, report);
}
