    try rejects("SELECT ('{\"bad\":\"\\ud800\",\"a\":1}'::json #> '{a,b,1}') AS value", error.InvalidTextRepresentation);
    try rejects("SELECT ('{\"bad\":\"\\ud800\",\"a\":1}'::json #>> '{a,b,1,x}') AS value", error.InvalidTextRepresentation);
    try rejects("SELECT ('{\"bad\":\"\\u0000\",\"a\":1}'::json -> 'a') AS value", error.UntranslatableCharacter);
    try rejects("SELECT ('{\"bad\":\"\\u0000\",\"a\":1}'::json ->> 'a') AS value", error.UntranslatableCharacter);
    try rejects("SELECT ('{\"bad\":\"\\u0000\",\"a\":1}'::json -> 0) AS value", error.UntranslatableCharacter);
    try rejects("SELECT ('{\"bad\":\"\\u0000\",\"a\":1}'::json -> -1) AS value", error.UntranslatableCharacter);
    try rejects("SELECT ('{\"bad\":\"\\u0000\",\"a\":1}'::json ->> 1) AS value", error.UntranslatableCharacter);
    try rejects("SELECT ('{\"bad\":\"\\u0000\",\"a\":1}'::json #> '{}') AS value", error.UntranslatableCharacter);
    try rejects("SELECT ('{\"bad\":\"\\u0000\",\"a\":1}'::json #>> '{}') AS value", error.UntranslatableCharacter);
    try rejects("SELECT ('{\"bad\":\"\\u0000\",\"a\":1}'::json #> '{a,b,1}') AS value", error.UntranslatableCharacter);
    try rejects("SELECT ('{\"bad\":\"\\u0000\",\"a\":1}'::json #>> '{a,b,1,x}') AS value", error.UntranslatableCharacter);
    try rejects("SELECT ('{\"bad\":\"\\ud800\",\"a\":1}'::json ->> 'bad' ) AS value", error.InvalidTextRepresentation);
    try rejects("SELECT ('{\"bad\":\"\\u0000\",\"a\":1}'::json ->> 'bad' ) AS value", error.UntranslatableCharacter);
    try row("SELECT (NULL::json -> 'a') AS value", null, .json);
    try row("SELECT ('{}'::json -> NULL::text) AS value", null, .json);
    try rejects("SELECT ('{}'::json -> 1::bigint) AS value", error.UndefinedFunction);
    try rejects("SELECT ('{}'::jsonb -> 1::bigint) AS value", error.UndefinedFunction);
    try row("SELECT ('[10,20]'::json #> '{+1}') AS value", "20", .json);
    try row("SELECT ('[10,20]'::jsonb #> '{+1}') AS value", "20", .jsonb);
    try row("SELECT ('[10,20]'::json #> '{ 1}') AS value", "20", .json);
    try row("SELECT ('[10,20]'::jsonb #> '{ 1}') AS value", "20", .jsonb);
    try row("SELECT ('1'::jsonb -> 0) AS value", "1", .jsonb);
    try row("SELECT ('1'::jsonb #> '{0}') AS value", null, .jsonb);
    try row("SELECT ('1'::jsonb #> '{}') AS value", "1", .jsonb);
    try row("SELECT ('[1]'::jsonb #> '{0,0}') AS value", null, .jsonb);
    try row("SELECT ('1'::json -> 0) AS value", null, .json);
    try row("SELECT ('1'::json #> '{0}') AS value", null, .json);
    try row("SELECT ('\"\\ud800\"'::json) AS value", "\"\\ud800\"", .json);
    try row("SELECT ('\"\\u0000\"'::json) AS value", "\"\\u0000\"", .json);
    std.debug.print("{{\"suite\":\"json-operators\",\"pass\":true,\"assertions\":{d}}}\n",.{assertions});
}
