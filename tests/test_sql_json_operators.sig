    try row("SELECT ('[ 1, 2.50, { \"x\" : true } ]'::json -> -1) AS value", "{ \"x\" : true }", .json);
    try row("SELECT ('[ 1, 2.50, { \"x\" : true } ]'::json ->> 1) AS value", "2.50", .text);
