//! Native PostgreSQL JSON/JSONB operator fixtures; value and type checked.
const std = @import("std");
const sql = @import("sql");
const DB = sql.Database(.{ .tables=2, .columns=6, .rows_per_table=8, .text_bytes=1024, .expr_nodes=512, .json_depth=16 });
var db: DB = .{};
var result: DB.Result = .{};
var assertions: usize = 0;
const Kind = enum { json, jsonb, text };
fn check(ok: bool) !void { assertions += 1; if (!ok) return error.JsonOperatorContractFailed; }
fn row(source: []const u8, wanted: ?[]const u8, ty: Kind) !void {
    db.execute(source, &result) catch |err| { std.debug.print("{s}: {s}\n", .{source,@errorName(err)}); return err; };
    try check(result.row_count==1 and result.column_count==1);
    try check(std.mem.eql(u8,result.column_names[0].slice(),"value"));
    try check(switch(ty){ .json=>result.column_types[0]==.json, .jsonb=>result.column_types[0]==.jsonb, .text=>result.column_types[0]==.text });
    const cell=&result.rows[0].cells[0];
    if(wanted) |expected| {
        try check(cell.*!=.null_value);
        var buffer:[DB.Io.format_bytes]u8=undefined;
        const got=try DB.Io.format(cell,false,&db.session,&buffer);
        if(!std.mem.eql(u8,got,expected)) std.debug.print("{s}\n got {s}\n expected {s}\n",.{source,got,expected});
        try check(std.mem.eql(u8,got,expected));
    } else try check(cell.*==.null_value);
    try check(db.usage().transactions==0 and db.usage().pending_versions==0);
}
fn rejects(source: []const u8, wanted: anyerror) !void {
    if(db.execute(source,&result)) |_| { std.debug.print("accepted: {s}\n",.{source});return error.InvalidSqlAccepted; } else |err| {
        if(err!=wanted) std.debug.print("{s}: got {s}, expected {s}\n",.{source,@errorName(err),@errorName(wanted)});
        try check(err==wanted);
    }
    try check(db.usage().transactions==0 and db.usage().pending_versions==0);
}
fn cancel(_: ?*anyopaque) sql.Error!void { return error.QueryCanceled; }
fn resources() !void {
    const doc = "{" ++ "\"x\":1," ** 35 ++ "\"y\":2}";
    var control: sql.ExecutionControl = .{ .max_work = 64 };
    db.session.control = &control;
    defer db.session.control = null;
    try rejects("SELECT '" ++ doc ++ "'::jsonb", error.QueryWorkLimit);
    control.reset(0); control.poll=cancel;
    try rejects("SELECT '{\"a\":1}'::jsonb", error.QueryCanceled);
    db.session.control=null;
    try db.execute("CREATE TABLE docs (id INTEGER PRIMARY KEY, doc JSONB)",&result);
    try db.execute("INSERT INTO docs VALUES (1,'{\"a\":1}'),(2,'{\"a\":1}')",&result);
    const update = "UPDATE docs SET doc = doc || '{\"b\":2}'";
    control.poll=null;control.reset(0);db.session.control=&control;
    try db.execute(update,&result);
    const work = control.used;
    db.session.control=null;
    try db.execute("UPDATE docs SET doc = '{\"a\":1}'",&result);
    // Fail at every charged work boundary, including after an earlier row
    // has changed. No failed statement may expose a partial write.
    var limit:u64=1;
    while(limit<work) : (limit+=1) {
        control.reset(limit);db.session.control=&control;
        try rejects(update,error.QueryWorkLimit);
        db.session.control=null;
        try row("SELECT doc AS value FROM docs WHERE id=1", "{\"a\": 1}", .jsonb);
        try row("SELECT doc AS value FROM docs WHERE id=2", "{\"a\": 1}", .jsonb);
    }
    // Concatenation must not create values deeper than replay accepts.
    try rejects("SELECT '" ++ "{\"a\":" ** 15 ++ "{}" ++ "}" ** 15 ++ "'::jsonb || '[]'::jsonb", error.StatementTooComplex);
}
pub fn main() !void {
    try resources();
    try row("SELECT ('{}'::jsonb || '{}'::jsonb) AS value", "{}", .jsonb);
    try row("SELECT ('{}'::jsonb || '[]'::jsonb) AS value", "[{}]", .jsonb);
    try row("SELECT ('{}'::jsonb || 'null'::jsonb) AS value", "[{}, null]", .jsonb);
    try row("SELECT ('{}'::jsonb || '1'::jsonb) AS value", "[{}, 1]", .jsonb);
    try row("SELECT ('{}'::jsonb || 'true'::jsonb) AS value", "[{}, true]", .jsonb);
    try row("SELECT ('{}'::jsonb || '\"s\"'::jsonb) AS value", "[{}, \"s\"]", .jsonb);
    try row("SELECT ('{}'::jsonb || '{\"a\":1}'::jsonb) AS value", "{\"a\": 1}", .jsonb);
    try row("SELECT ('{}'::jsonb || '[1,2]'::jsonb) AS value", "[{}, 1, 2]", .jsonb);
    try row("SELECT ('{}'::jsonb || '{\"a\":{\"x\":1}}'::jsonb) AS value", "{\"a\": {\"x\": 1}}", .jsonb);
    try row("SELECT ('[]'::jsonb || '{}'::jsonb) AS value", "[{}]", .jsonb);
    try row("SELECT ('[]'::jsonb || '[]'::jsonb) AS value", "[]", .jsonb);
    try row("SELECT ('[]'::jsonb || 'null'::jsonb) AS value", "[null]", .jsonb);
    try row("SELECT ('[]'::jsonb || '1'::jsonb) AS value", "[1]", .jsonb);
    try row("SELECT ('[]'::jsonb || 'true'::jsonb) AS value", "[true]", .jsonb);
    try row("SELECT ('[]'::jsonb || '\"s\"'::jsonb) AS value", "[\"s\"]", .jsonb);
    try row("SELECT ('[]'::jsonb || '{\"a\":1}'::jsonb) AS value", "[{\"a\": 1}]", .jsonb);
    try row("SELECT ('[]'::jsonb || '[1,2]'::jsonb) AS value", "[1, 2]", .jsonb);
    try row("SELECT ('[]'::jsonb || '{\"a\":{\"x\":1}}'::jsonb) AS value", "[{\"a\": {\"x\": 1}}]", .jsonb);
    try row("SELECT ('null'::jsonb || '{}'::jsonb) AS value", "[null, {}]", .jsonb);
    try row("SELECT ('null'::jsonb || '[]'::jsonb) AS value", "[null]", .jsonb);
    try row("SELECT ('null'::jsonb || 'null'::jsonb) AS value", "[null, null]", .jsonb);
    try row("SELECT ('null'::jsonb || '1'::jsonb) AS value", "[null, 1]", .jsonb);
    try row("SELECT ('null'::jsonb || 'true'::jsonb) AS value", "[null, true]", .jsonb);
    try row("SELECT ('null'::jsonb || '\"s\"'::jsonb) AS value", "[null, \"s\"]", .jsonb);
    try row("SELECT ('null'::jsonb || '{\"a\":1}'::jsonb) AS value", "[null, {\"a\": 1}]", .jsonb);
    try row("SELECT ('null'::jsonb || '[1,2]'::jsonb) AS value", "[null, 1, 2]", .jsonb);
    try row("SELECT ('null'::jsonb || '{\"a\":{\"x\":1}}'::jsonb) AS value", "[null, {\"a\": {\"x\": 1}}]", .jsonb);
    try row("SELECT ('1'::jsonb || '{}'::jsonb) AS value", "[1, {}]", .jsonb);
    try row("SELECT ('1'::jsonb || '[]'::jsonb) AS value", "[1]", .jsonb);
    try row("SELECT ('1'::jsonb || 'null'::jsonb) AS value", "[1, null]", .jsonb);
    try row("SELECT ('1'::jsonb || '1'::jsonb) AS value", "[1, 1]", .jsonb);
    try row("SELECT ('1'::jsonb || 'true'::jsonb) AS value", "[1, true]", .jsonb);
    try row("SELECT ('1'::jsonb || '\"s\"'::jsonb) AS value", "[1, \"s\"]", .jsonb);
    try row("SELECT ('1'::jsonb || '{\"a\":1}'::jsonb) AS value", "[1, {\"a\": 1}]", .jsonb);
    try row("SELECT ('1'::jsonb || '[1,2]'::jsonb) AS value", "[1, 1, 2]", .jsonb);
    try row("SELECT ('1'::jsonb || '{\"a\":{\"x\":1}}'::jsonb) AS value", "[1, {\"a\": {\"x\": 1}}]", .jsonb);
    try row("SELECT ('true'::jsonb || '{}'::jsonb) AS value", "[true, {}]", .jsonb);
    try row("SELECT ('true'::jsonb || '[]'::jsonb) AS value", "[true]", .jsonb);
    try row("SELECT ('true'::jsonb || 'null'::jsonb) AS value", "[true, null]", .jsonb);
    try row("SELECT ('true'::jsonb || '1'::jsonb) AS value", "[true, 1]", .jsonb);
    try row("SELECT ('true'::jsonb || 'true'::jsonb) AS value", "[true, true]", .jsonb);
    try row("SELECT ('true'::jsonb || '\"s\"'::jsonb) AS value", "[true, \"s\"]", .jsonb);
    try row("SELECT ('true'::jsonb || '{\"a\":1}'::jsonb) AS value", "[true, {\"a\": 1}]", .jsonb);
    try row("SELECT ('true'::jsonb || '[1,2]'::jsonb) AS value", "[true, 1, 2]", .jsonb);
    try row("SELECT ('true'::jsonb || '{\"a\":{\"x\":1}}'::jsonb) AS value", "[true, {\"a\": {\"x\": 1}}]", .jsonb);
    try row("SELECT ('\"s\"'::jsonb || '{}'::jsonb) AS value", "[\"s\", {}]", .jsonb);
    try row("SELECT ('\"s\"'::jsonb || '[]'::jsonb) AS value", "[\"s\"]", .jsonb);
    try row("SELECT ('\"s\"'::jsonb || 'null'::jsonb) AS value", "[\"s\", null]", .jsonb);
    try row("SELECT ('\"s\"'::jsonb || '1'::jsonb) AS value", "[\"s\", 1]", .jsonb);
    try row("SELECT ('\"s\"'::jsonb || 'true'::jsonb) AS value", "[\"s\", true]", .jsonb);
    try row("SELECT ('\"s\"'::jsonb || '\"s\"'::jsonb) AS value", "[\"s\", \"s\"]", .jsonb);
    try row("SELECT ('\"s\"'::jsonb || '{\"a\":1}'::jsonb) AS value", "[\"s\", {\"a\": 1}]", .jsonb);
    try row("SELECT ('\"s\"'::jsonb || '[1,2]'::jsonb) AS value", "[\"s\", 1, 2]", .jsonb);
    try row("SELECT ('\"s\"'::jsonb || '{\"a\":{\"x\":1}}'::jsonb) AS value", "[\"s\", {\"a\": {\"x\": 1}}]", .jsonb);
    try row("SELECT ('{\"a\":1}'::jsonb || '{}'::jsonb) AS value", "{\"a\": 1}", .jsonb);
    try row("SELECT ('{\"a\":1}'::jsonb || '[]'::jsonb) AS value", "[{\"a\": 1}]", .jsonb);
    try row("SELECT ('{\"a\":1}'::jsonb || 'null'::jsonb) AS value", "[{\"a\": 1}, null]", .jsonb);
    try row("SELECT ('{\"a\":1}'::jsonb || '1'::jsonb) AS value", "[{\"a\": 1}, 1]", .jsonb);
    try row("SELECT ('{\"a\":1}'::jsonb || 'true'::jsonb) AS value", "[{\"a\": 1}, true]", .jsonb);
    try row("SELECT ('{\"a\":1}'::jsonb || '\"s\"'::jsonb) AS value", "[{\"a\": 1}, \"s\"]", .jsonb);
    try row("SELECT ('{\"a\":1}'::jsonb || '{\"a\":1}'::jsonb) AS value", "{\"a\": 1}", .jsonb);
    try row("SELECT ('{\"a\":1}'::jsonb || '[1,2]'::jsonb) AS value", "[{\"a\": 1}, 1, 2]", .jsonb);
    try row("SELECT ('{\"a\":1}'::jsonb || '{\"a\":{\"x\":1}}'::jsonb) AS value", "{\"a\": {\"x\": 1}}", .jsonb);
