    try row("SELECT ('[1,2]'::jsonb || '1'::jsonb) AS value", "[1, 2, 1]", .jsonb);
    try row("SELECT ('[1,2]'::jsonb || 'true'::jsonb) AS value", "[1, 2, true]", .jsonb);
    try row("SELECT ('[1,2]'::jsonb || '\"s\"'::jsonb) AS value", "[1, 2, \"s\"]", .jsonb);
    try row("SELECT ('[1,2]'::jsonb || '{\"a\":1}'::jsonb) AS value", "[1, 2, {\"a\": 1}]", .jsonb);
    try row("SELECT ('[1,2]'::jsonb || '[1,2]'::jsonb) AS value", "[1, 2, 1, 2]", .jsonb);
    try row("SELECT ('[1,2]'::jsonb || '{\"a\":{\"x\":1}}'::jsonb) AS value", "[1, 2, {\"a\": {\"x\": 1}}]", .jsonb);
    try row("SELECT ('{\"a\":{\"x\":1}}'::jsonb || '{}'::jsonb) AS value", "{\"a\": {\"x\": 1}}", .jsonb);
    try row("SELECT ('{\"a\":{\"x\":1}}'::jsonb || '[]'::jsonb) AS value", "[{\"a\": {\"x\": 1}}]", .jsonb);
    try row("SELECT ('{\"a\":{\"x\":1}}'::jsonb || 'null'::jsonb) AS value", "[{\"a\": {\"x\": 1}}, null]", .jsonb);
    try row("SELECT ('{\"a\":{\"x\":1}}'::jsonb || '1'::jsonb) AS value", "[{\"a\": {\"x\": 1}}, 1]", .jsonb);
    try row("SELECT ('{\"a\":{\"x\":1}}'::jsonb || 'true'::jsonb) AS value", "[{\"a\": {\"x\": 1}}, true]", .jsonb);
    try row("SELECT ('{\"a\":{\"x\":1}}'::jsonb || '\"s\"'::jsonb) AS value", "[{\"a\": {\"x\": 1}}, \"s\"]", .jsonb);
    try row("SELECT ('{\"a\":{\"x\":1}}'::jsonb || '{\"a\":1}'::jsonb) AS value", "{\"a\": 1}", .jsonb);
    try row("SELECT ('{\"a\":{\"x\":1}}'::jsonb || '[1,2]'::jsonb) AS value", "[{\"a\": {\"x\": 1}}, 1, 2]", .jsonb);
    try row("SELECT ('{\"a\":{\"x\":1}}'::jsonb || '{\"a\":{\"x\":1}}'::jsonb) AS value", "{\"a\": {\"x\": 1}}", .jsonb);
    try row("SELECT ('{\"aa\":1,\"b\":2,\"a\":3}'::jsonb || '{\"a\":4,\"b\":null,\"z\":9}'::jsonb) AS value", "{\"a\": 4, \"b\": null, \"z\": 9, \"aa\": 1}", .jsonb);
    try row("SELECT ('{\"a\":{\"x\":1}}'::jsonb || '{\"a\":{\"y\":2}}'::jsonb) AS value", "{\"a\": {\"y\": 2}}", .jsonb);
    try row("SELECT ('{\"a\":1}'::jsonb || '{\"b\":2}') AS value", "{\"a\": 1, \"b\": 2}", .jsonb);
    try row("SELECT ('{\"a\":1}' || '{\"b\":2}'::jsonb) AS value", "{\"a\": 1, \"b\": 2}", .jsonb);
    try row("SELECT ('1'::jsonb || 'x'::text) AS value", "1x", .text);
    try row("SELECT ('x'::text || '1'::jsonb) AS value", "x1", .text);
    try row("SELECT (NULL::jsonb || '{}'::jsonb) AS value", null, .jsonb);
    try row("SELECT ('{}'::jsonb || NULL) AS value", null, .jsonb);
