    try rejects("SELECT ('{\"a\":1}'::json @> '{}'::json) AS value", error.UndefinedFunction);
    try row("SELECT (' { \"b\" : 2, \"a\" : 1, \"a\" : 3 } '::json -> 'a') AS value", "3", .json);
