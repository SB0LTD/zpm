        .{ .source = "SELECT * FROM information_schema.column_domain_usage WHERE table_name IN ('sql_features', 'schemata', '_pg_foreign_servers') ORDER BY table_name, column_name", .head = "T:domain_catalog/19/64/-1,domain_schema/19/64/-1,domain_name/19/64/-1,table_catalog/19/64/-1,table_schema/19/64/-1,table_name/19/64/-1,column_name/19/64/-1;C:SELECT 21;Z:I", .rows = &.{"catalog_views_probe|information_schema|sql_identifier|catalog_views_probe|information_schema|_pg_foreign_servers|authorization_identifier", "catalog_views_probe|information_schema|sql_identifier|catalog_views_probe|information_schema|_pg_foreign_servers|foreign_data_wrapper_catalog", "catalog_views_probe|information_schema|sql_identifier|catalog_views_probe|information_schema|_pg_foreign_servers|foreign_data_wrapper_name", "catalog_views_probe|information_schema|sql_identifier|catalog_views_probe|information_schema|_pg_foreign_servers|foreign_server_catalog", "catalog_views_probe|information_schema|sql_identifier|catalog_views_probe|information_schema|_pg_foreign_servers|foreign_server_name", "catalog_views_probe|information_schema|character_data|catalog_views_probe|information_schema|_pg_foreign_servers|foreign_server_type", "catalog_views_probe|information_schema|character_data|catalog_views_probe|information_schema|_pg_foreign_servers|foreign_server_version", "catalog_views_probe|information_schema|sql_identifier|catalog_views_probe|information_schema|schemata|catalog_name", "catalog_views_probe|information_schema|sql_identifier|catalog_views_probe|information_schema|schemata|default_character_set_catalog", "catalog_views_probe|information_schema|sql_identifier|catalog_views_probe|information_schema|schemata|default_character_set_name", "catalog_views_probe|information_schema|sql_identifier|catalog_views_probe|information_schema|schemata|default_character_set_schema", "catalog_views_probe|information_schema|sql_identifier|catalog_views_probe|information_schema|schemata|schema_name", "catalog_v