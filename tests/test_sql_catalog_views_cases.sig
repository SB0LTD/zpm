    } },
    .{ .name = "03_privileges", .statements = &.{
        .{ .source = "CREATE ROLE w5c_a", .head = "C:CREATE ROLE;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "CREATE ROLE w5c_b", .head = "C:CREATE ROLE;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "CREATE ROLE w5c_g", .head = "C:CREATE ROLE;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "GRANT w5c_g TO w5c_a WITH ADMIN OPTION", .head = "C:GRANT ROLE;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "GRANT w5c_g TO w5c_b", .head = "C:GRANT ROLE;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "CREATE TABLE ta(id INT PRIMARY KEY, v TEXT)", .head = "C:CREATE TABLE;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "CREATE TABLE tb(id INT PRIMARY KEY, a_id INT REFERENCES ta, CONSTRAINT tb_chk CHECK (id > 0))", .head = "C:CREATE TABLE;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "CREATE TABLE tc(id INT)", .head = "C:CREATE TABLE;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "CREATE VIEW va AS SELECT id FROM ta", .head = "C:CREATE VIEW;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "GRANT SELECT ON ta TO w5c_a", .head = "C:GRANT;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "GRANT INSERT, UPDATE ON tb TO w5c_g WITH GRANT OPTION", .head = "C:GRANT;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "GRANT SELECT ON va TO PUBLIC", .head = "C:GRANT;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "GRANT TRIGGER ON tc TO w5c_b", .head = "C:GRANT;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "CREATE FUNCTION fa(x INT) RETURNS INT LANGUAGE SQL AS 'SELECT x'", .head = "C:CREATE FUNCTION;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "CREATE FUNCTION fb() RETURNS INT LANGUAGE SQL AS 'SELECT 1'", .head = "C:CREATE FUNCTION;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "REVOKE EXECUTE ON FUNCTION fb() FROM PUBLIC", .head = "C:REVOKE;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "GRANT EXECUTE ON FUNCTION fb() TO w5c_a WITH GRANT OPTION", .head = "C:GRANT;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "CREATE SEQUENCE sq", .head = "C:CREATE SEQUENCE;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "SELECT grantor, grantee, table_schema, table_name, privilege_type, is_grantable, with_hierarchy FROM information_schema.table_privileges WHERE table_schema = 'public' ORDER BY table_name, grantee, privilege_type", .head = "T:grantor/19/64/-1,grantee/19/64/-1,table_schema/19/64/-1,table_name/19/64/-1,privilege_type/1043/-1/-1,is_grantable/1043/-1/7,with_hierarchy/1043/-1/7;C:SELECT 33;Z:I", .rows = &.{"ramsql|ramsql|public|ta|DELETE|YES|NO", "ramsql|ramsql|public|ta|INSERT|YES|NO", "ramsql|ramsql|public|ta|REFERENCES|YES|NO", "ramsql|ramsql|public|ta|SELECT|YES|YES", "ramsql|ramsql|public|ta|TRIGGER|YES|NO", "ramsql|ramsql|public|ta|TRUNCATE|YES|NO", "ramsql|ramsql|public|ta|UPDATE|YES|NO", "ramsql|w5c_a|public|ta|SELECT|NO|YES", "ramsql|ramsql|public|tb|DELETE|YES|NO", "ramsql|ramsql|public|tb|INSERT|YES|NO", "ramsql|ramsql|public|tb|REFERENCES|YES|NO", "ramsql|ramsql|public|tb|SELECT|YES|YES", "ramsql|ramsql|public|tb|TRIGGER|YES|NO", "ramsql|ramsql|public|tb|TRUNCATE|YES|NO", "ramsql|ramsql|public|tb|UPDATE|YES|NO", "ramsql|w5c_g|public|tb|INSERT|YES|NO", "ramsql|w5c_g|public|tb|UPDATE|YES|NO", "ramsql|ramsql|public|tc|DELETE|YES|NO", "ramsql|ramsql|public|tc|INSERT|YES|NO", "ramsql|ramsql|public|tc|REFERENCES|YES|NO", "ramsql|ramsql|public|tc|SELECT|YES|YES", "ramsql|ramsql|public|tc|TRIGGER|YES|NO", "ramsql|ramsql|public|tc|TRUNCATE|YES|NO", "ramsql|ramsql|public|tc|UPDATE|YES|NO", "ramsql|w5c_b|public|tc|TRIGGER|NO|NO", "ramsql|PUBLIC|public|va|SELECT|NO|YES", "ramsql|ramsql|public|va|DELETE|YES|NO", "ramsql|ramsql|public|va|INSERT|YES|NO", "ramsql|ramsql|public|va|REFERENCES|YES|NO", "ramsql|ramsql|public|va|SELECT|YES|YES", "ramsql|ramsql|public|va|TRIGGER|YES|NO", "ramsql|ramsql|public|va|TRUNCATE|YES|NO", "ramsql|ramsql|public|va|UPDATE|YES|NO"}, .ordered = true },
        .{ .source = "SELECT grantor, grantee, table_name, column_name, privilege_type, is_grantable FROM information_schema.column_privileges WHERE table_schema = 'public' ORDER BY table_name, column_name, grantee, privilege_type", .head = "T:grantor/19/64/-1,grantee/19/64/-1,table_name/19/64/-1,column_name/19/64/-1,privilege_type/1043/-1/-1,is_grantable/1043/-1/7;C:SELECT 31;Z:I", .rows = &.{"ramsql|ramsql|ta|id|INSERT|YES", "ramsql|ramsql|ta|id|REFERENCES|YES", "ramsql|ramsql|ta|id|SELECT|YES", "ramsql|ramsql|ta|id|UPDATE|YES", "ramsql|w5c_a|ta|id|SELECT|NO", "ramsql|ramsql|ta|v|INSERT|YES", "ramsql|ramsql|ta|v|REFERENCES|YES", "ramsql|ramsql|ta|v|SELECT|YES", "ramsql|ramsql|ta|v|UPDATE|YES", "ramsql|w5c_a|ta|v|SELECT|NO", "ramsql|ramsql|tb|a_id|INSERT|YES", "ramsql|ramsql|tb|a_id|REFERENCES|YES", "ramsql|ramsql|tb|a_id|SELECT|YES", "ramsql|ramsql|tb|a_id|UPDATE|YES", "ramsql|w5c_g|tb|a_id|INSERT|YES", "ramsql|w5c_g|tb|a_id|UPDATE|YES", "ramsql|ramsql|tb|id|INSERT|YES", "ramsql|ramsql|tb|id|REFERENCES|YES", "ramsql|ramsql|tb|id|SELECT|YES", "ramsql|ramsql|tb|id|UPDATE|YES", "ramsql|w5c_g|tb|id|INSERT|YES", "ramsql|w5c_g|tb|id|UPDATE|YES", "ramsql|ramsql|tc|id|INSERT|YES", "ramsql|ramsql|tc|id|REFERENCES|YES", "ramsql|ramsql|tc|id|SELECT|YES", "ramsql|ramsql|tc|id|UPDATE|YES", "ramsql|PUBLIC|va|id|SELECT|NO", "ramsql|ramsql|va|id|INSERT|YES", "ramsql|ramsql|va|id|REFERENCES|YES", "ramsql|ramsql|va|id|SELECT|YES", "ramsql|ramsql|va|id|UPDATE|YES"}, .ordered = true },
        .{ .source = "SELECT grantor, grantee, routine_schema, routine_name, privilege_type, is_grantable FROM information_schema.routine_privileges WHERE routine_schema = 'public' ORDER BY routine_name, grantee", .head = "T:grantor/19/64/-1,grantee/19/64/-1,routine_schema/19/64/-1,routine_name/19/64/-1,privilege_type/1043/-1/-1,is_grantable/1043/-1/7;C:SELECT 4;Z:I", .rows = &.{"ramsql|PUBLIC|public|fa|EXECUTE|NO", "ramsql|ramsql|public|fa|EXECUTE|YES", "ramsql|ramsql|public|fb|EXECUTE|YES", "ramsql|w5c_a|public|fb|EXECUTE|YES"}, .ordered = true },
        .{ .source = "SELECT * FROM information_schema.applicable_roles WHERE grantee LIKE 'w5c%' ORDER BY grantee, role_name", .head = "T:grantee/19/64/-1,role_name/19/64/-1,is_grantable/1043/-1/7;C:SELECT 2;Z:I", .rows = &.{"w5c_a|w5c_g|YES", "w5c_b|w5c_g|NO"}, .ordered = true },
        .{ .source = "SELECT * FROM information_schema.administrable_role_authorizations WHERE grantee LIKE 'w5c%' ORDER BY grantee, role_name", .head = "T:grantee/19/64/-1,role_name/19/64/-1,is_grantable/1043/-1/7;C:SELECT 1;Z:I", .rows = &.{"w5c_a|w5c_g|YES"}, .ordered = true },
        .{ .source = "SET ROLE w5c_a", .head = "C:SET;Z:I", .rows = &.{}, .ordered = false },
