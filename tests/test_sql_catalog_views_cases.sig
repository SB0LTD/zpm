        .{ .source = "SELECT * FROM information_schema.usage_privileges WHERE object_type LIKE 'FOREIGN%' ORDER BY object_name, grantee", .head = "T:grantor/19/64/-1,grantee/19/64/-1,object_catalog/19/64/-1,object_schema/19/64/-1,object_name/19/64/-1,object_type/1043/-1/-1,privilege_type/1043/-1/-1,is_grantable/1043/-1/7;C:SELECT 3;Z:I", .rows = &.{"ramsql|ramsql|catalog_views_probe||w5c_fdw|FOREIGN DATA WRAPPER|USAGE|YES", "ramsql|ramsql|catalog_views_probe||w5c_srv|FOREIGN SERVER|USAGE|YES", "ramsql|ramsql|catalog_views_probe||w5c_srv2|FOREIGN SERVER|USAGE|YES"}, .ordered = true },
    } },
    .{ .name = "06_current", .statements = &.{
        .{ .source = "SELECT CURRENT_CATALOG, current_database() = CURRENT_CATALOG, pg_typeof(CURRENT_CATALOG)", .head = "T:current_catalog/19/64/-1,?column?/16/1/-1,pg_typeof/2206/4/-1;C:SELECT 1;Z:I", .rows = &.{"catalog_views_probe|t|name"}, .ordered = false },
        .{ .source = "SELECT CURRENT_SCHEMA, current_schema(), pg_typeof(CURRENT_SCHEMA), current_catalog = current_database()", .head = "T:current_schema/19/64/-1,current_schema/19/64/-1,pg_typeof/2206/4/-1,?column?/16/1/-1;C:SELECT 1;Z:I", .rows = &.{"public|public|name|t"}, .ordered = false },
        .{ .source = "SELECT current_catalog AS c, current_schema AS s, CURRENT_CATALOG || '/' || CURRENT_SCHEMA AS both", .head = "T:c/19/64/-1,s/19/64/-1,both/25/-1/-1;C:SELECT 1;Z:I", .rows = &.{"catalog_views_probe|public|catalog_views_probe\\/public"}, .ordered = false },
        .{ .source = "CREATE SCHEMA s", .head = "C:CREATE SCHEMA;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "SET search_path TO s, public", .head = "C:SET;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "SELECT CURRENT_SCHEMA, current_schema()", .head = "T:current_schema/19/64/-1,current_schema/19/64/-1;C:SELECT 1;Z:I", .rows = &.{"s|s"}, .ordered = false },
        .{ .source = "CREATE TABLE s.k(id INT)", .head = "C:CREATE TABLE;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "SELECT table_schema FROM information_schema.tables WHERE table_name = 'k' AND table_schema = CURRENT_SCHEMA", .head = "T:table_schema/19/64/-1;C:SELECT 1;Z:I", .rows = &.{"s"}, .ordered = false },
        .{ .source = "SET search_path TO nonexistent", .head = "C:SET;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "SELECT CURRENT_SCHEMA IS NULL, current_schema() IS NULL", .head = "T:?column?/16/1/-1,?column?/16/1/-1;C:SELECT 1;Z:I", .rows = &.{"t|t"}, .ordered = false },
        .{ .source = "SET search_path TO nonexistent, public", .head = "C:SET;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "SELECT CURRENT_SCHEMA", .head = "T:current_schema/19/64/-1;C:SELECT 1;Z:I", .rows = &.{"public"}, .ordered = false },
        .{ .source = "RESET search_path", .head = "C:RESET;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "SELECT CURRENT_SCHEMA", .head = "T:current_schema/19/64/-1;C:SELECT 1;Z:I", .rows = &.{"public"}, .ordered = false },
        .{ .source = "SELECT current_catalog()", .head = "E:42601;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "SELECT current_schema(1)", .head = "E:42883;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "SELECT pg_function_is_visible(0)", .head = "T:pg_function_is_visible/16/1/-1;C:SELECT 1;Z:I", .rows = &.{"\\N"}, .ordered = false },
        .{ .source = "CREATE FUNCTION fv(x INT) RETURNS INT LANGUAGE SQL AS 'SELECT x'", .head = "C:CREATE FUNCTION;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "CREATE FUNCTION s.fv(x INT) RETURNS INT LANGUAGE SQL AS 'SELECT x'", .head = "C:CREATE FUNCTION;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "CREATE FUNCTION s.only_s() RETURNS INT LANGUAGE SQL AS 'SELECT 1'", .head = "C:CREATE FUNCTION;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "SELECT p.proname, n.nspname, pg_function_is_visible(p.oid) FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace WHERE p.proname IN ('fv', 'only_s') ORDER BY 2, 1", .head = "T:proname/19/64/-1,nspname/19/64/-1,pg_function_is_visible/16/1/-1;C:SELECT 3;Z:I", .rows = &.{"fv|public|t", "fv|s|f", "only_s|s|f"}, .ordered = true },
        .{ .source = "SET search_path TO s, public", .head = "C:SET;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "SELECT p.proname, n.nspname, pg_function_is_visible(p.oid) FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace WHERE p.proname IN ('fv', 'only_s') ORDER BY 2, 1", .head = "T:proname/19/64/-1,nspname/19/64/-1,pg_function_is_visible/16/1/-1;C:SELECT 3;Z:I", .rows = &.{"fv|public|f", "fv|s|t", "only_s|s|t"}, .ordered = true },
        .{ .source = "RESET search_path", .head = "C:RESET;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "SELECT pg_function_is_visible('lo_create'::regproc), pg_typeof(pg_function_is_visible('lo_create'::regproc))", .head = "T:pg_function_is_visible/16/1/-1,pg_typeof/2206/4/-1;C:SELECT 1;Z:I", .rows = &.{"t|boolean"}, .ordered = false },
        .{ .source = "SELECT CASE WHEN 1 = 0 THEN '' ELSE relname::text END FROM pg_class WHERE relname = 'k'", .head = "T:relname/25/-1/-1;C:SELECT 1;Z:I", .rows = &.{"k"}, .ordered = false },
        .{ .source = "SELECT CASE WHEN 1 = 0 THEN 1 ELSE abs(-2) END, CASE WHEN 1 = 0 THEN 1 END, CASE WHEN 1 = 1 THEN 'a' ELSE 'b' END", .head = "T:abs/23/4/-1,case/23/4/-1,case/25/-1/-1;C:SELECT 1;Z:I", .rows = &.{"2|\\N|a"}, .ordered = false },
        .{ .source = "SELECT n.nspname as \"Schema\", p.proname as \"Name\", pg_catalog.pg_get_function_result(p.oid) as \"Result data type\", pg_catalog.pg_get_function_arguments(p.oid) as \"Argument data types\", CASE p.prokind WHEN 'a' THEN 'agg' WHEN 'w' THEN 'window' WHEN 'p' THEN 'proc' ELSE 'func' END as \"Type\" FROM pg_catalog.pg_proc p LEFT JOIN pg_catalog.pg_namespace n ON n.oid = p.pronamespace WHERE pg_catalog.pg_function_is_visible(p.oid) AND n.nspname <> 'pg_catalog' AND n.nspname <> 'information_schema' ORDER BY 1, 2, 4", .head = "T:Schema/19/64/-1,Name/19/64/-1,Result data type/25/-1/-1,Argument data types/25/-1/-1,Type/25/-1/-1;C:SELECT 1;Z:I", .rows = &.{"public|fv|integer|x integer|func"}, .ordered = true },
        .{ .source = "SELECT relpersistence, relreplident, pg_typeof(relpersistence), pg_typeof(relreplident) FROM pg_class WHERE relname = 'k'", .head = "T:relpersistence/18/1/-1,relreplident/18/1/-1,pg_typeof/2206/4/-1,pg_typeof/2206/4/-1;C:SELECT 1;Z:I", .rows = &.{"p|d|\"char\"|\"char\""}, .ordered = false },
        .{ .source = "SELECT relpersistence, relreplident FROM pg_class WHERE relname = 'k'", .head = "T:relpersistence/18/1/-1,relreplident/18/1/-1;C:SELECT 1;Z:I", .rows = &.{"p|d"}, .ordered = false },
        .{ .source = "CREATE TABLE ck(id INT PRIMARY KEY, x INT REFERENCES ck ON DELETE CASCADE, y INT CHECK (y > 0))", .head = "C:CREATE TABLE;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "SELECT conname, contype, confupdtype, confdeltype, confmatchtype FROM pg_constraint WHERE conrelid = 'ck'::regclass AND contype <> 'n' ORDER BY conname", .head = "T:conname/19/64/-1,contype/18/1/-1,confupdtype/18/1/-1,confdeltype/18/1/-1,confmatchtype/18/1/-1;C:SELECT 3;Z:I", .rows = &.{"ck_pkey|p| | | ", "ck_x_fkey|f|a|c|s", "ck_y_check|c| | | "}, .ordered = true },
        .{ .source = "SELECT typname, typcategory, typdelim FROM pg_type WHERE oid IN (16, 1007, 25) ORDER BY oid", .head = "T:typname/19/64/-1,typcategory/18/1/-1,typdelim/18/1/-1;C:SELECT 3;Z:I", .rows = &.{"bool|B|\\,", "text|S|\\,", "_int4|A|\\,"}, .ordered = true },
        .{ .source = "SELECT collname, collprovider FROM pg_collation WHERE oid IN (100, 950) ORDER BY oid", .head = "T:collname/19/64/-1,collprovider/18/1/-1;C:SELECT 2;Z:I", .rows = &.{"default|d", "C|c"}, .ordered = true },
        .{ .source = "SELECT version() LIKE 'PostgreSQL %', pg_typeof(version()), pg_catalog.version() = version()", .head = "T:?column?/16/1/-1,pg_typeof/2206/4/-1,?column?/16/1/-1;C:SELECT 1;Z:I", .rows = &.{"t|text|t"}, .ordered = false },
        .{ .source = "SELECT version(1)", .head = "E:42883;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "CREATE TABLE kp(id INT PRIMARY KEY, u INT UNIQUE, name TEXT NOT NULL, c INT CHECK (c > id AND u IS NOT NULL))", .head = "C:CREATE TABLE;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "CREATE TABLE kf(x INT CONSTRAINT kf_fk REFERENCES kp ON DELETE CASCADE, y INT, CONSTRAINT kf_u UNIQUE (y, x), CONSTRAINT kf_fk2 FOREIGN KEY (y) REFERENCES kp (u))", .head = "C:CREATE TABLE;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "SELECT conname, contype, conkey, confkey FROM pg_constraint WHERE conrelid IN ('kp'::regclass, 'kf'::regclass) AND contype <> 'n' ORDER BY conname", .head = "T:conname/19/64/-1,contype/18/1/-1,conkey/1005/-1/-1,confkey/1005/-1/-1;C:SELECT 6;Z:I", .rows = &.{"kf_fk|f|{1}|{1}", "kf_fk2|f|{2}|{2}", "kf_u|u|{2\\,1}|\\N", "kp_check|c|{4\\,1\\,2}|\\N", "kp_pkey|p|{1}|\\N", "kp_u_key|u|{2}|\\N"}, .ordered = true },
        .{ .source = "SELECT pg_catalog.pg_class.relname, pg_catalog.pg_class.relkind FROM pg_catalog.pg_class JOIN pg_catalog.pg_namespace ON pg_catalog.pg_namespace.oid = pg_catalog.pg_class.relnamespace WHERE pg_catalog.pg_class.relname IN ('kp', 'kf') AND pg_catalog.pg_table_is_visible(pg_catalog.pg_class.oid) AND pg_catalog.pg_namespace.nspname != 'pg_catalog' ORDER BY 1", .head = "T:relname/19/64/-1,relkind/18/1/-1;C:SELECT 2;Z:I", .rows = &.{"kf|r", "kp|r"}, .ordered = true },
        .{ .source = "SELECT information_schema.tables.table_name, information_schema.tables.table_type FROM information_schema.tables WHERE information_schema.tables.table_name = 'kp'", .head = "T:table_name/19/64/-1,table_type/1043/-1/-1;C:SELECT 1;Z:I", .rows = &.{"kp|BASE TABLE"}, .ordered = false },
        .{ .source = "SELECT k.conname, array_agg(CAST(a.attname AS TEXT) ORDER BY a.attnum) FROM pg_catalog.pg_constraint k JOIN pg_catalog.pg_attribute a ON a.attrelid = k.conrelid AND a.attnum = ANY (k.conkey) WHERE k.conrelid = 'kf'::regclass AND k.contype IN ('u', 'f') GROUP BY k.conname ORDER BY 1", .head = "T:conname/19/64/-1,array_agg/1009/-1/-1;C:SELECT 3;Z:I", .rows = &.{"kf_fk|{x}", "kf_fk2|{y}", "kf_u|{x\\,y}"}, .ordered = true },
    } },
};
