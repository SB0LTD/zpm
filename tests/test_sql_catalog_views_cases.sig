    .{ .name = "04_routines", .statements = &.{
        .{ .source = "CREATE FUNCTION f1(a INT, INOUT b TEXT, OUT c DATE) LANGUAGE SQL AS $$SELECT b, CURRENT_DATE$$", .head = "C:CREATE FUNCTION;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "CREATE FUNCTION f2(x INT, y INT DEFAULT 5, z TEXT DEFAULT 'q') RETURNS INT LANGUAGE SQL IMMUTABLE STRICT AS 'SELECT x + y'", .head = "C:CREATE FUNCTION;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "CREATE FUNCTION f3(VARIADIC xs INT[]) RETURNS INT LANGUAGE SQL AS 'SELECT 1'", .head = "C:CREATE FUNCTION;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "CREATE FUNCTION f4(n INT) RETURNS TABLE(k INT, v TEXT) LANGUAGE SQL AS 'SELECT n, ''a'''", .head = "C:CREATE FUNCTION;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "CREATE FUNCTION f5() RETURNS SETOF INT LANGUAGE SQL STABLE SECURITY DEFINER AS 'SELECT 1'", .head = "C:CREATE FUNCTION;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "CREATE FUNCTION f6(INT, TEXT) RETURNS TEXT[] LANGUAGE SQL AS 'SELECT ARRAY[$2]'", .head = "C:CREATE FUNCTION;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "CREATE FUNCTION f7(a INT, OUT r1 INT, OUT r2 INT) LANGUAGE SQL AS 'SELECT a, a'", .head = "C:CREATE FUNCTION;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "CREATE PROCEDURE p1(IN a INT, INOUT b INT) LANGUAGE SQL AS 'SELECT 1'", .head = "C:CREATE PROCEDURE;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "CREATE PROCEDURE p2() LANGUAGE plpgsql AS $$BEGIN NULL; END$$", .head = "C:CREATE PROCEDURE;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "CREATE FUNCTION tf() RETURNS TRIGGER LANGUAGE plpgsql AS $$BEGIN RETURN NEW; END$$", .head = "C:CREATE FUNCTION;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "SELECT routine_schema, routine_name, routine_type, data_type, type_udt_schema, type_udt_name, dtd_identifier, routine_body, routine_definition, external_name, external_language, parameter_style, is_deterministic, sql_data_access, is_null_call, sql_path, schema_level_routine, max_dynamic_result_sets, security_type, as_locator, is_udt_dependent FROM information_schema.routines WHERE routine_schema = 'public' ORDER BY routine_name", .head = "T:routine_schema/19/64/-1,routine_name/19/64/-1,routine_type/1043/-1/-1,data_type/1043/-1/-1,type_udt_schema/19/64/-1,type_udt_name/19/64/-1,dtd_identifier/19/64/-1,routine_body/1043/-1/-1,routine_definition/1043/-1/-1,external_name/1043/-1/-1,external_language/1043/-1/-1,parameter_style/1043/-1/-1,is_deterministic/1043/-1/7,sql_data_access/1043/-1/-1,is_null_call/1043/-1/7,sql_path/1043/-1/-1,schema_level_routine/1043/-1/7,max_dynamic_result_sets/23/4/-1,security_type/1043/-1/-1,as_locator/1043/-1/7,is_udt_dependent/1043/-1/7;C:SELECT 10;Z:I", .rows = &.{"public|f1|FUNCTION|record|pg_catalog|record|0|SQL|SELECT b\\, CURRENT_DATE|\\N|SQL|GENERAL|NO|MODIFIES|NO|\\N|YES|0|INVOKER|NO|NO", "public|f2|FUNCTION|integer|pg_catalog|int4|0|SQL|SELECT x + y|\\N|SQL|GENERAL|YES|MODIFIES|YES|\\N|YES|0|INVOKER|NO|NO", "public|f3|FUNCTION|integer|pg_catalog|int4|0|SQL|SELECT 1|\\N|SQL|GENERAL|NO|MODIFIES|NO|\\N|YES|0|INVOKER|NO|NO", "public|f4|FUNCTION|record|pg_catalog|record|0|SQL|SELECT n\\, 'a'|\\N|SQL|GENERAL|NO|MODIFIES|NO|\\N|YES|0|INVOKER|NO|NO", "public|f5|FUNCTION|integer|pg_catalog|int4|0|SQL|SELECT 1|\\N|SQL|GENERAL|NO|MODIFIES|NO|\\N|YES|0|DEFINER|NO|NO", "public|f6|FUNCTION|ARRAY|pg_catalog|_text|0|SQL|SELECT ARRAY[$2]|\\N|SQL|GENERAL|NO|MODIFIES|NO|\\N|YES|0|INVOKER|NO|NO", "public|f7|FUNCTION|record|pg_catalog|record|0|SQL|SELECT a\\, a|\\N|SQL|GENERAL|NO|MODIFIES|NO|\\N|YES|0|INVOKER|NO|NO", "public|p1|PROCEDURE|\\N|\\N|\\N|\\N|SQL|SELECT 1|\\N|SQL|GENERAL|NO|MODIFIES|\\N|\\N|YES|0|INVOKER|NO|NO", "public|p2|PROCEDURE|\\N|\\N|\\N|\\N|EXTERNAL|BEGIN NULL\\; END|\\N|PLPGSQL|GENERAL|NO|MODIFIES|\\N|\\N|YES|0|INVOKER|NO|NO", "public|tf|FUNCTION|trigger|pg_catalog|trigger|0|EXTERNAL|BEGIN RETURN NEW\\; END|\\N|PLPGSQL|GENERAL|NO|MODIFIES|NO|\\N|YES|0|INVOKER|NO|NO"}, .ordered = true },
        .{ .source = "SELECT ordinal_position, parameter_mode, is_result, as_locator, parameter_name, data_type, udt_schema, udt_name, dtd_identifier, parameter_default FROM information_schema.parameters WHERE specific_schema = 'public' ORDER BY specific_name, ordinal_position", .head = "T:ordinal_position/23/4/-1,parameter_mode/1043/-1/-1,is_result/1043/-1/7,as_locator/1043/-1/7,parameter_name/19/64/-1,data_type/1043/-1/-1,udt_schema/19/64/-1,udt_name/19/64/-1,dtd_identifier/19/64/-1,parameter_default/1043/-1/-1;C:SELECT 17;Z:I", .rows = &.{"1|IN|NO|NO|a|integer|pg_catalog|int4|1|\\N", "2|INOUT|NO|NO|b|text|pg_catalog|text|2|\\N", "3|OUT|NO|NO|c|date|pg_catalog|date|3|\\N", "1|IN|NO|NO|x|integer|pg_catalog|int4|1|\\N", "2|IN|NO|NO|y|integer|pg_catalog|int4|2|5", "3|IN|NO|NO|z|text|pg_catalog|text|3|'q'::text", "1|IN|NO|NO|xs|ARRAY|pg_catalog|_int4|1|\\N", "1|IN|NO|NO|n|integer|pg_catalog|int4|1|\\N", "2|OUT|NO|NO|k|integer|pg_catalog|int4|2|\\N", "3|OUT|NO|NO|v|text|pg_catalog|text|3|\\N", "1|IN|NO|NO|\\N|integer|pg_catalog|int4|1|\\N", "2|IN|NO|NO|\\N|text|pg_catalog|text|2|\\N", "1|IN|NO|NO|a|integer|pg_catalog|int4|1|\\N", "2|OUT|NO|NO|r1|integer|pg_catalog|int4|2|\\N", "3|OUT|NO|NO|r2|integer|pg_catalog|int4|3|\\N", "1|IN|NO|NO|a|integer|pg_catalog|int4|1|\\N", "2|INOUT|NO|NO|b|integer|pg_catalog|int4|2|\\N"}, .ordered = true },
        .{ .source = "SELECT e.object_type, e.collection_type_identifier, e.data_type, e.udt_name, e.dtd_identifier FROM information_schema.element_types e WHERE e.object_schema = 'public' ORDER BY e.object_name, e.collection_type_identifier", .head = "T:object_type/1043/-1/-1,collection_type_identifier/19/64/-1,data_type/1043/-1/-1,udt_name/19/64/-1,dtd_identifier/19/64/-1;C:SELECT 2;Z:I", .rows = &.{"ROUTINE|1|integer|int4|a1", "ROUTINE|0|text|text|a0"}, .ordered = true },
        .{ .source = "SELECT object_type, dtd_identifier FROM information_schema.data_type_privileges WHERE object_schema = 'public' ORDER BY object_name, dtd_identifier", .head = "T:object_type/1043/-1/-1,dtd_identifier/19/64/-1;C:SELECT 27;Z:I", .rows = &.{"ROUTINE|0", "ROUTINE|1", "ROUTINE|2", "ROUTINE|3", "ROUTINE|0", "ROUTINE|1", "ROUTINE|2", "ROUTINE|3", "ROUTINE|0", "ROUTINE|1", "ROUTINE|0", "ROUTINE|1", "ROUTINE|2", "ROUTINE|3", "ROUTINE|0", "ROUTINE|0", "ROUTINE|1", "ROUTINE|2", "ROUTINE|0", "ROUTINE|1", "ROUTINE|2", "ROUTINE|3", "ROUTINE|1", "ROUTINE|2", "ROUTINE|\\N", "ROUTINE|\\N", "ROUTINE|0"}, .ordered = true },
        .{ .source = "SELECT routine_name, data_type, type_udt_name, external_language, routine_body FROM information_schema.routines WHERE routine_schema = 'pg_catalog' AND routine_name IN ('lo_create', 'lo_import', 'date_bin', 'bthandler', 'int48eq') ORDER BY routine_name, data_type", .head = "T:routine_name/19/64/-1,data_type/1043/-1/-1,type_udt_name/19/64/-1,external_language/1043/-1/-1,routine_body/1043/-1/-1;C:SELECT 7;Z:I", .rows = &.{"bthandler|index_am_handler|index_am_handler|INTERNAL|EXTERNAL", "date_bin|timestamp with time zone|timestamptz|INTERNAL|EXTERNAL", "date_bin|timestamp without time zone|timestamp|INTERNAL|EXTERNAL", "int48eq|boolean|bool|INTERNAL|EXTERNAL", "lo_create|oid|oid|INTERNAL|EXTERNAL", "lo_import|oid|oid|INTERNAL|EXTERNAL", "lo_import|oid|oid|INTERNAL|EXTERNAL"}, .ordered = true },
        .{ .source = "SELECT grantee, routine_name, privilege_type, is_grantable FROM information_schema.routine_privileges WHERE routine_schema = 'pg_catalog' AND routine_name IN ('lo_create', 'lo_import') ORDER BY routine_name, grantee", .head = "T:grantee/19/64/-1,routine_name/19/64/-1,privilege_type/1043/-1/-1,is_grantable/1043/-1/7;C:SELECT 4;Z:I", .rows = &.{"PUBLIC|lo_create|EXECUTE|NO", "ramsql|lo_create|EXECUTE|YES", "ramsql|lo_import|EXECUTE|YES", "ramsql|lo_import|EXECUTE|YES"}, .ordered = true },
        .{ .source = "CREATE TABLE t(a INT, b INT, c TEXT)", .head = "C:CREATE TABLE;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "CREATE VIEW tv AS SELECT a, b FROM t", .head = "C:CREATE VIEW;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "CREATE FUNCTION tv_ins() RETURNS TRIGGER LANGUAGE plpgsql AS $$BEGIN RETURN NEW; END$$", .head = "C:CREATE FUNCTION;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "CREATE TRIGGER tr1 BEFORE INSERT OR UPDATE OF a, b ON t FOR EACH ROW EXECUTE FUNCTION tf()", .head = "C:CREATE TRIGGER;Z:I", .rows = &.{}, .ordered = false },
