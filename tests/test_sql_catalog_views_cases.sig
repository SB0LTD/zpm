        .{ .source = "SELECT constraint_schema, constraint_name, check_clause FROM information_schema.check_constraints WHERE constraint_schema IN ('public', 's1') ORDER BY constraint_schema, constraint_name", .head = "T:constraint_schema/19/64/-1,constraint_name/19/64/-1,check_clause/1043/-1/-1;C:SELECT 10;Z:I", .rows = &.{"public|c_pos|(c > 0)", "public|f_z_not_null|z IS NOT NULL", "public|longtablenamexxxxxxxxxxxxxx_longcolumnnameyyyyyyyyyyyy_not_null|longcolumnnameyyyyyyyyyyyyyyyyyyyyyyyy IS NOT NULL", "public|nn_a_not_null|a IS NOT NULL", "public|p_id_not_null|id IS NOT NULL", "public|p_n_not_null|n IS NOT NULL", "public|pk2_a_not_null|a IS NOT NULL", "public|pk2_b_not_null|b IS NOT NULL", "public|w_range|(w <> c)", "s1|g_id_not_null|id IS NOT NULL"}, .ordered = true },
