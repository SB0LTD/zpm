    .{ .name = "02_constraints", .statements = &.{
        .{ .source = "CREATE SCHEMA s1", .head = "C:CREATE SCHEMA;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "CREATE TABLE p(id INT PRIMARY KEY, u INT UNIQUE, c INT CONSTRAINT c_pos CHECK (c > 0), n TEXT NOT NULL, w INT, CONSTRAINT w_range CHECK (w <> c))", .head = "C:CREATE TABLE;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "CREATE TABLE pk2(a INT, b INT, z INT, PRIMARY KEY (a, b), CONSTRAINT pk2_bz UNIQUE (b, z) DEFERRABLE INITIALLY DEFERRED)", .head = "C:CREATE TABLE;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "CREATE TABLE f(x INT CONSTRAINT f_fk REFERENCES p ON DELETE CASCADE ON UPDATE SET NULL, y INT, z INT NOT NULL, q INT REFERENCES p (u), CONSTRAINT f_pk2 FOREIGN KEY (z, y) REFERENCES pk2 (b, a) ON DELETE RESTRICT)", .head = "C:CREATE TABLE;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "CREATE TABLE s1.g(id INT CONSTRAINT g_key PRIMARY KEY, pid INT REFERENCES p)", .head = "C:CREATE TABLE;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "CREATE TABLE nn(a INT NOT NULL, b INT, CONSTRAINT nn_b UNIQUE NULLS NOT DISTINCT (b))", .head = "C:CREATE TABLE;Z:I", .rows = &.{}, .ordered = false },
        .{ .source = "CREATE TABLE longtablenamexxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx(longcolumnnameyyyyyyyyyyyyyyyyyyyyyyyy INT NOT NULL)", .head = "C:CREATE TABLE;Z:I", .rows = &.{}, .ordered = false },
