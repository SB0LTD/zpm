    .{ .name = "composite_type_usage", .statements = &.{
        .{ .source = "CREATE ROLE w5p_a", .head = "C:CREATE ROLE;Z:I", .rows = &.{} },
        .{ .source = "CREATE ROLE w5p_b", .head = "C:CREATE ROLE;Z:I", .rows = &.{} },
        .{ .source = "GRANT CREATE ON SCHEMA public TO w5p_a, w5p_b", .head = "C:GRANT;Z:I", .rows = &.{} },
        .{ .source = "CREATE TYPE comp AS (p INT, q TEXT)", .head = "C:CREATE TYPE;Z:I", .rows = &.{} },
        .{ .source = "REVOKE USAGE ON TYPE comp FROM PUBLIC", .head = "C:REVOKE;Z:I", .rows = &.{} },
        .{ .source = "GRANT USAGE ON TYPE comp TO w5p_a", .head = "C:GRANT;Z:I", .rows = &.{} },
        .{ .source = "SET ROLE w5p_b", .head = "C:SET;Z:I", .rows = &.{} },
        .{ .source = "CREATE TABLE tb(c comp)", .head = "E:42501;Z:I", .rows = &.{} },
        .{ .source = "CREATE FUNCTION fb(x comp) RETURNS INT LANGUAGE sql AS 'SELECT 1'", .head = "E:42501;Z:I", .rows = &.{} },
        .{ .source = "CREATE FUNCTION fr(x INT) RETURNS comp LANGUAGE sql AS 'SELECT ROW(x, ''r'')::comp'", .head = "E:42501;Z:I", .rows = &.{} },
        .{ .source = "CREATE TABLE tb(i INT)", .head = "C:CREATE TABLE;Z:I", .rows = &.{} },
        .{ .source = "ALTER TABLE tb ADD COLUMN c comp", .head = "E:42501;Z:I", .rows = &.{} },
        .{ .source = "SELECT ROW(1, 'b')::comp", .head = "T:row/#/-1/-1;C:SELECT 1;Z:I", .rows = &.{"(1\\,b)"} },
        .{ .source = "RESET ROLE", .head = "C:RESET;Z:I", .rows = &.{} },
        .{ .source = "SET ROLE w5p_a", .head = "C:SET;Z:I", .rows = &.{} },
        .{ .source = "CREATE TABLE ta(c comp)", .head = "C:CREATE TABLE;Z:I", .rows = &.{} },
        .{ .source = "INSERT INTO ta VALUES (ROW(1, 'x'))", .head = "C:INSERT 0 1;Z:I", .rows = &.{} },
        .{ .source = "SELECT (c).p, (c).q FROM ta", .head = "T:p/23/4/-1,q/25/-1/-1;C:SELECT 1;Z:I", .rows = &.{"1|x"} },
        .{ .source = "CREATE FUNCTION fa(x comp) RETURNS INT LANGUAGE sql AS 'SELECT (x).p'", .head = "C:CREATE FUNCTION;Z:I", .rows = &.{} },
        .{ .source = "SELECT fa(c) FROM ta", .head = "T:fa/23/4/-1;C:SELECT 1;Z:I", .rows = &.{"1"} },
        .{ .source = "CREATE FUNCTION fa2(x INT) RETURNS comp LANGUAGE sql AS 'SELECT ROW(x, ''y'')::comp'", .head = "C:CREATE FUNCTION;Z:I", .rows = &.{} },
        .{ .source = "SELECT (fa2(3)).q", .head = "T:q/25/-1/-1;C:SELECT 1;Z:I", .rows = &.{"y"} },
        .{ .source = "CREATE TYPE mine AS (z INT)", .head = "C:CREATE TYPE;Z:I", .rows = &.{} },
        .{ .source = "CREATE FUNCTION mine_to_comp(m mine) RETURNS comp LANGUAGE sql AS 'SELECT ROW((m).z, ''c'')::comp'", .head = "C:CREATE FUNCTION;Z:I", .rows = &.{} },
        .{ .source = "CREATE CAST (mine AS comp) WITH FUNCTION mine_to_comp(mine)", .head = "C:CREATE CAST;Z:I", .rows = &.{} },
        .{ .source = "RESET ROLE", .head = "C:RESET;Z:I", .rows = &.{} },
        .{ .source = "REVOKE USAGE ON TYPE comp FROM w5p_a", .head = "C:REVOKE;Z:I", .rows = &.{} },
        .{ .source = "SET ROLE w5p_a", .head = "C:SET;Z:I", .rows = &.{} },
        .{ .source = "CREATE TABLE ta2(c comp)", .head = "E:42501;Z:I", .rows = &.{} },
        .{ .source = "SELECT (c).p FROM ta", .head = "T:p/23/4/-1;C:SELECT 1;Z:I", .rows = &.{"1"} },
        .{ .source = "SELECT fa(c) FROM ta", .head = "T:fa/23/4/-1;C:SELECT 1;Z:I", .rows = &.{"1"} },
        .{ .source = "ALTER TABLE ta ADD COLUMN d INT", .head = "C:ALTER TABLE;Z:I", .rows = &.{} },
        .{ .source = "CREATE FUNCTION fa3(x comp) RETURNS INT LANGUAGE sql AS 'SELECT 3'", .head = "E:42501;Z:I", .rows = &.{} },
        .{ .source = "DROP CAST (mine AS comp)", .head = "C:DROP CAST;Z:I", .rows = &.{} },
        .{ .source = "CREATE CAST (mine AS comp) WITH FUNCTION mine_to_comp(mine)", .head = "E:42501;Z:I", .rows = &.{} },
        .{ .source = "RESET ROLE", .head = "C:RESET;Z:I", .rows = &.{} },
        .{ .source = "REVOKE USAGE ON TYPE mine FROM w5p_a", .head = "C:REVOKE;Z:I", .rows = &.{} },
        .{ .source = "SET ROLE w5p_a", .head = "C:SET;Z:I", .rows = &.{} },
        .{ .source = "CREATE TABLE ta3(m mine)", .head = "C:CREATE TABLE;Z:I", .rows = &.{} },
        .{ .source = "SELECT has_type_privilege('mine', 'USAGE'), has_type_privilege('comp', 'USAGE')", .head = "T:has_type_privilege/16/1/-1,has_type_privilege/16/1/-1;C:SELECT 1;Z:I", .rows = &.{"t|f"} },
        .{ .source = "RESET ROLE", .head = "C:RESET;Z:I", .rows = &.{} },
        .{ .source = "SELECT typname, typacl FROM pg_type WHERE typname IN ('comp', 'mine') ORDER BY 1", .head = "T:typname/19/64/-1,typacl/1034/-1/-1;C:SELECT 2;Z:I", .rows = &.{"comp|{ramsql=U\\/ramsql}", "mine|{=U\\/w5p_a}"} },
        .{ .source = "SELECT grantor, grantee, udt_name, is_grantable FROM information_schema.udt_privileges WHERE udt_name IN ('comp', 'mine') ORDER BY 3, 2", .head = "T:grantor/19/64/-1,grantee/19/64/-1,udt_name/19/64/-1,is_grantable/1043/-1/7;C:SELECT 2;Z:I", .rows = &.{"ramsql|ramsql|comp|YES", "w5p_a|PUBLIC|mine|NO"} },
        .{ .source = "DROP TABLE tb", .head = "C:DROP TABLE;Z:I", .rows = &.{} },
        .{ .source = "DROP TABLE ta", .head = "C:DROP TABLE;Z:I", .rows = &.{} },
