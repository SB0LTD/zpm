    } },
    .{ .name = "predefined_roles", .statements = &.{
        .{ .source = "CREATE ROLE w5p_reader", .head = "C:CREATE ROLE;Z:I", .rows = &.{} },
        .{ .source = "CREATE ROLE w5p_writer", .head = "C:CREATE ROLE;Z:I", .rows = &.{} },
        .{ .source = "CREATE ROLE w5p_monitor", .head = "C:CREATE ROLE;Z:I", .rows = &.{} },
        .{ .source = "CREATE TABLE t(a INT)", .head = "C:CREATE TABLE;Z:I", .rows = &.{} },
        .{ .source = "INSERT INTO t VALUES (1)", .head = "C:INSERT 0 1;Z:I", .rows = &.{} },
        .{ .source = "SELECT rolname, rolinherit, rolcanlogin FROM pg_roles WHERE rolname IN ('pg_read_all_data', 'pg_write_all_data', 'pg_monitor', 'pg_database_owner', 'pg_maintain') ORDER BY rolname", .head = "T:rolname/19/64/-1,rolinherit/16/1/-1,rolcanlogin/16/1/-1;C:SELECT 5;Z:I", .rows = &.{"pg_database_owner|t|f", "pg_maintain|t|f", "pg_monitor|t|f", "pg_read_all_data|t|f", "pg_write_all_data|t|f"} },
        .{ .source = "GRANT pg_read_all_data TO w5p_reader", .head = "C:GRANT ROLE;Z:I", .rows = &.{} },
        .{ .source = "GRANT pg_write_all_data TO w5p_writer", .head = "C:GRANT ROLE;Z:I", .rows = &.{} },
        .{ .source = "GRANT pg_monitor TO w5p_monitor", .head = "C:GRANT ROLE;Z:I", .rows = &.{} },
        .{ .source = "SET ROLE w5p_reader", .head = "C:SET;Z:I", .rows = &.{} },
        .{ .source = "SELECT a FROM t", .head = "T:a/23/4/-1;C:SELECT 1;Z:I", .rows = &.{"1"} },
        .{ .source = "INSERT INTO t VALUES (2)", .head = "E:42501;Z:I", .rows = &.{} },
        .{ .source = "RESET ROLE", .head = "C:RESET;Z:I", .rows = &.{} },
        .{ .source = "SET ROLE w5p_writer", .head = "C:SET;Z:I", .rows = &.{} },
        .{ .source = "INSERT INTO t VALUES (3)", .head = "C:INSERT 0 1;Z:I", .rows = &.{} },
        .{ .source = "SELECT a FROM t", .head = "E:42501;Z:I", .rows = &.{} },
        .{ .source = "DELETE FROM t", .head = "C:DELETE 2;Z:I", .rows = &.{} },
        .{ .source = "UPDATE t SET a = 4", .head = "C:UPDATE 0;Z:I", .rows = &.{} },
        .{ .source = "RESET ROLE", .head = "C:RESET;Z:I", .rows = &.{} },
        .{ .source = "SELECT a FROM t ORDER BY a", .head = "T:a/23/4/-1;C:SELECT 0;Z:I", .rows = &.{} },
        .{ .source = "SELECT pg_has_role('w5p_monitor', 'pg_read_all_stats', 'USAGE'), pg_has_role('w5p_monitor', 'pg_read_all_settings', 'MEMBER'), has_table_privilege('w5p_reader', 't', 'SELECT'), has_table_privilege('w5p_writer', 't', 'INSERT')", .head = "T:pg_has_role/16/1/-1,pg_has_role/16/1/-1,has_table_privilege/16/1/-1,has_table_privilege/16/1/-1;C:SELECT 1;Z:I", .rows = &.{"t|t|t|t"} },
        .{ .source = "SELECT has_schema_privilege('w5p_reader', 'public', 'USAGE')", .head = "T:has_schema_privilege/16/1/-1;C:SELECT 1;Z:I", .rows = &.{"t"} },
        .{ .source = "SELECT count(*) FROM pg_roles WHERE rolname LIKE 'pg\\_%'", .head = "T:count/20/8/-1;C:SELECT 1;Z:I", .rows = &.{"16"} },
        .{ .source = "CREATE ROLE pg_mine", .head = "E:42939;Z:I", .rows = &.{} },
        .{ .source = "REVOKE pg_read_all_data FROM w5p_reader", .head = "C:REVOKE ROLE;Z:I", .rows = &.{} },
        .{ .source = "REVOKE pg_write_all_data FROM w5p_writer", .head = "C:REVOKE ROLE;Z:I", .rows = &.{} },
        .{ .source = "REVOKE pg_monitor FROM w5p_monitor", .head = "C:REVOKE ROLE;Z:I", .rows = &.{} },
        .{ .source = "DROP TABLE t", .head = "C:DROP TABLE;Z:I", .rows = &.{} },
        .{ .source = "DROP ROLE w5p_reader, w5p_writer, w5p_monitor", .head = "C:DROP ROLE;Z:I", .rows = &.{} },
    } },
    .{ .name = "session_authorization", .statements = &.{
        .{ .source = "CREATE ROLE w5p_a", .head = "C:CREATE ROLE;Z:I", .rows = &.{} },
        .{ .source = "CREATE ROLE w5p_b", .head = "C:CREATE ROLE;Z:I", .rows = &.{} },
        .{ .source = "GRANT w5p_b TO w5p_a", .head = "C:GRANT ROLE;Z:I", .rows = &.{} },
        .{ .source = "DROP ROLE pg_monitor", .head = "E:2BP01;Z:I", .rows = &.{} },
        .{ .source = "ALTER ROLE pg_monitor LOGIN", .head = "E:42939;Z:I", .rows = &.{} },
        .{ .source = "SET SESSION AUTHORIZATION w5p_a", .head = "C:SET;Z:I", .rows = &.{} },
        .{ .source = "SELECT session_user, current_user", .head = "T:session_user/19/64/-1,current_user/19/64/-1;C:SELECT 1;Z:I", .rows = &.{"w5p_a|w5p_a"} },
        .{ .source = "SHOW session_authorization", .head = "T:session_authorization/25/-1/-1;C:SHOW;Z:I", .rows = &.{"w5p_a"} },
        .{ .source = "SET ROLE w5p_b", .head = "C:SET;Z:I", .rows = &.{} },
        .{ .source = "SELECT session_user, current_user", .head = "T:session_user/19/64/-1,current_user/19/64/-1;C:SELECT 1;Z:I", .rows = &.{"w5p_a|w5p_b"} },
        .{ .source = "CREATE ROLE w5p_c", .head = "E:42501;Z:I", .rows = &.{} },
        .{ .source = "SET SESSION AUTHORIZATION w5p_b", .head = "C:SET;Z:I", .rows = &.{} },
        .{ .source = "SELECT session_user, current_user", .head = "T:session_user/19/64/-1,current_user/19/64/-1;C:SELECT 1;Z:I", .rows = &.{"w5p_b|w5p_b"} },
        .{ .source = "RESET SESSION AUTHORIZATION", .head = "C:RESET;Z:I", .rows = &.{} },
        .{ .source = "SELECT session_user, current_user", .head = "T:session_user/19/64/-1,current_user/19/64/-1;C:SELECT 1;Z:I", .rows = &.{"ramsql|ramsql"} },
        .{ .source = "SET SESSION AUTHORIZATION nosuch", .head = "E:22023;Z:I", .rows = &.{} },
        .{ .source = "BEGIN", .head = "C:BEGIN;Z:T", .rows = &.{} },
        .{ .source = "SET LOCAL SESSION AUTHORIZATION w5p_a", .head = "C:SET;Z:T", .rows = &.{} },
        .{ .source = "SELECT current_user", .head = "T:current_user/19/64/-1;C:SELECT 1;Z:T", .rows = &.{"w5p_a"} },
        .{ .source = "COMMIT", .head = "C:COMMIT;Z:I", .rows = &.{} },
        .{ .source = "SELECT current_user", .head = "T:current_user/19/64/-1;C:SELECT 1;Z:I", .rows = &.{"ramsql"} },
        .{ .source = "DROP ROLE w5p_a", .head = "C:DROP ROLE;Z:I", .rows = &.{} },
        .{ .source = "DROP ROLE w5p_b", .head = "C:DROP ROLE;Z:I", .rows = &.{} },
    } },
    .{ .name = "maintain_privilege", .statements = &.{
        .{ .source = "CREATE ROLE w5p_a", .head = "C:CREATE ROLE;Z:I", .rows = &.{} },
        .{ .source = "CREATE ROLE w5p_b", .head = "C:CREATE ROLE;Z:I", .rows = &.{} },
        .{ .source = "CREATE TABLE t(a INT)", .head = "C:CREATE TABLE;Z:I", .rows = &.{} },
        .{ .source = "CREATE MATERIALIZED VIEW mv AS SELECT a FROM t", .head = "C:SELECT 0;Z:I", .rows = &.{} },
        .{ .source = "SET ROLE w5p_a", .head = "C:SET;Z:I", .rows = &.{} },
        .{ .source = "REFRESH MATERIALIZED VIEW mv", .head = "E:42501;Z:I", .rows = &.{} },
        .{ .source = "RESET ROLE", .head = "C:RESET;Z:I", .rows = &.{} },
        .{ .source = "GRANT MAINTAIN ON mv TO w5p_a", .head = "C:GRANT;Z:I", .rows = &.{} },
        .{ .source = "SET ROLE w5p_a", .head = "C:SET;Z:I", .rows = &.{} },
        .{ .source = "REFRESH MATERIALIZED VIEW mv", .head = "C:REFRESH MATERIALIZED VIEW;Z:I", .rows = &.{} },
        .{ .source = "RESET ROLE", .head = "C:RESET;Z:I", .rows = &.{} },
        .{ .source = "GRANT pg_maintain TO w5p_b", .head = "C:GRANT ROLE;Z:I", .rows = &.{} },
        .{ .source = "SET ROLE w5p_b", .head = "C:SET;Z:I", .rows = &.{} },
        .{ .source = "REFRESH MATERIALIZED VIEW mv", .head = "C:REFRESH MATERIALIZED VIEW;Z:I", .rows = &.{} },
        .{ .source = "RESET ROLE", .head = "C:RESET;Z:I", .rows = &.{} },
        .{ .source = "SELECT relacl FROM pg_class WHERE relname = 'mv'", .head = "T:relacl/1034/-1/-1;C:SELECT 1;Z:I", .rows = &.{"{ramsql=arwdDxtm\\/ramsql\\,w5p_a=m\\/ramsql}"} },
        .{ .source = "REVOKE pg_maintain FROM w5p_b", .head = "C:REVOKE ROLE;Z:I", .rows = &.{} },
        .{ .source = "DROP MATERIALIZED VIEW mv", .head = "C:DROP MATERIALIZED VIEW;Z:I", .rows = &.{} },
        .{ .source = "DROP TABLE t", .head = "C:DROP TABLE;Z:I", .rows = &.{} },
        .{ .source = "DROP ROLE w5p_a", .head = "C:DROP ROLE;Z:I", .rows = &.{} },
        .{ .source = "DROP ROLE w5p_b", .head = "C:DROP ROLE;Z:I", .rows = &.{} },
    } },
    .{ .name = "acl_order_and_quirks", .statements = &.{
        .{ .source = "CREATE ROLE w5p_a", .head = "C:CREATE ROLE;Z:I", .rows = &.{} },
        .{ .source = "CREATE ROLE w5p_b", .head = "C:CREATE ROLE;Z:I", .rows = &.{} },
        .{ .source = "CREATE ROLE w5p_c", .head = "C:CREATE ROLE;Z:I", .rows = &.{} },
        .{ .source = "CREATE TABLE t(x INT, y INT)", .head = "C:CREATE TABLE;Z:I", .rows = &.{} },
        .{ .source = "GRANT SELECT ON t TO w5p_a", .head = "C:GRANT;Z:I", .rows = &.{} },
        .{ .source = "GRANT SELECT ON t TO w5p_b", .head = "C:GRANT;Z:I", .rows = &.{} },
