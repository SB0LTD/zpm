    } },
    .{ .name = "column_reads_and_locks", .statements = &.{
        .{ .source = "CREATE ROLE w5p_r", .head = "C:CREATE ROLE;Z:I", .rows = &.{} },
        .{ .source = "CREATE TABLE t(a INT, b INT)", .head = "C:CREATE TABLE;Z:I", .rows = &.{} },
        .{ .source = "INSERT INTO t VALUES (1, 2)", .head = "C:INSERT 0 1;Z:I", .rows = &.{} },
        .{ .source = "GRANT SELECT (a) ON t TO w5p_r", .head = "C:GRANT;Z:I", .rows = &.{} },
        .{ .source = "CREATE VIEW v AS SELECT a, b FROM t", .head = "C:CREATE VIEW;Z:I", .rows = &.{} },
        .{ .source = "GRANT SELECT ON v TO w5p_r", .head = "C:GRANT;Z:I", .rows = &.{} },
        .{ .source = "SET ROLE w5p_r", .head = "C:SET;Z:I", .rows = &.{} },
        .{ .source = "SELECT count(a) FROM t", .head = "T:count/20/8/-1;C:SELECT 1;Z:I", .rows = &.{"1"} },
        .{ .source = "SELECT b FROM v", .head = "T:b/23/4/-1;C:SELECT 1;Z:I", .rows = &.{"2"} },
        .{ .source = "SELECT a FROM t WHERE EXISTS (SELECT 1 FROM t x WHERE x.b = 2)", .head = "E:42501;Z:I", .rows = &.{} },
        .{ .source = "SELECT a FROM t t1 WHERE a IN (SELECT a FROM t)", .head = "T:a/23/4/-1;C:SELECT 1;Z:I", .rows = &.{"1"} },
        .{ .source = "WITH c AS (SELECT b FROM t) SELECT * FROM c", .head = "E:42501;Z:I", .rows = &.{} },
        .{ .source = "SELECT a FROM (SELECT * FROM t) s", .head = "E:42501;Z:I", .rows = &.{} },
        .{ .source = "SELECT a FROM t FOR UPDATE", .head = "E:42501;Z:I", .rows = &.{} },
        .{ .source = "SELECT a FROM t FOR SHARE", .head = "E:42501;Z:I", .rows = &.{} },
        .{ .source = "RESET ROLE", .head = "C:RESET;Z:I", .rows = &.{} },
        .{ .source = "GRANT UPDATE (b) ON t TO w5p_r", .head = "C:GRANT;Z:I", .rows = &.{} },
        .{ .source = "SET ROLE w5p_r", .head = "C:SET;Z:I", .rows = &.{} },
        .{ .source = "SELECT a FROM t FOR UPDATE", .head = "T:a/23/4/-1;C:SELECT 1;Z:I", .rows = &.{"1"} },
        .{ .source = "RESET ROLE", .head = "C:RESET;Z:I", .rows = &.{} },
        .{ .source = "DROP VIEW v", .head = "C:DROP VIEW;Z:I", .rows = &.{} },
        .{ .source = "DROP TABLE t", .head = "C:DROP TABLE;Z:I", .rows = &.{} },
        .{ .source = "DROP ROLE w5p_r", .head = "C:DROP ROLE;Z:I", .rows = &.{} },
    } },
    .{ .name = "xml_mapping_visibility", .statements = &.{
        .{ .source = "CREATE ROLE w5p_r", .head = "C:CREATE ROLE;Z:I", .rows = &.{} },
        .{ .source = "CREATE TABLE t1(a INT)", .head = "C:CREATE TABLE;Z:I", .rows = &.{} },
        .{ .source = "CREATE TABLE t2(b INT)", .head = "C:CREATE TABLE;Z:I", .rows = &.{} },
        .{ .source = "INSERT INTO t1 VALUES (1)", .head = "C:INSERT 0 1;Z:I", .rows = &.{} },
        .{ .source = "INSERT INTO t2 VALUES (2)", .head = "C:INSERT 0 1;Z:I", .rows = &.{} },
        .{ .source = "CREATE SCHEMA hidden", .head = "C:CREATE SCHEMA;Z:I", .rows = &.{} },
        .{ .source = "CREATE TABLE hidden.h(x INT)", .head = "C:CREATE TABLE;Z:I", .rows = &.{} },
