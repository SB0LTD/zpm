        .{ .source = "SELECT attname, attacl FROM pg_attribute WHERE attrelid = 't'::regclass AND attnum > 0 AND NOT attisdropped ORDER BY attnum", .head = "T:attname/19/64/-1,attacl/1034/-1/-1;C:SELECT 2;Z:I", .rows = &.{"a|\\N", "b|{w5p_b=w\\/w5p_a}"} },
        .{ .source = "SET ROLE w5p_a", .head = "C:SET;Z:I", .rows = &.{} },
