        .{ .source = "SELECT schema_to_xml('public', true, false, '')", .head = "T:schema_to_xml/142/-1/-1;C:SELECT 1;Z:I", .rows = &.{"<public xmlns:xsi=\"http:\\/\\/www.w3.org\\/2001\\/XMLSchema-instance\">\\x0a\\x0a<t1>\\x0a\\x0a<row>\\x0a  <a>1<\\/a>\\x0a<\\/row>\\x0a\\x0a<\\/t1>\\x0a\\x0a<\\/public>\\x0a"} },
        .{ .source = "SELECT database_to_xml(true, false, '')", .head = "T:database_to_xml/142/-1/-1;C:SELECT 1;Z:I", .rows = &.{"<w5_privileges_probe xmlns:xsi=\"http:\\/\\/www.w3.org\\/2001\\/XMLSchema-instance\">\\x0a\\x0a<public>\\x0a\\x0a<t1>\\x0a\\x0a<row>\\x0a  <a>1<\\/a>\\x0a<\\/row>\\x0a\\x0a<\\/t1>\\x0a\\x0a<\\/public>\\x0a\\x0a<\\/w5_privileges_probe>\\x0a"} },
        .{ .source = "RESET ROLE", .head = "C:RESET;Z:I", .rows = &.{} },
        .{ .source = "GRANT USAGE ON SCHEMA hidden TO w5p_r", .head = "C:GRANT;Z:I", .rows = &.{} },
        .{ .source = "SET ROLE w5p_r", .head = "C:SET;Z:I", .rows = &.{} },
        .{ .source = "SELECT database_to_xml(true, false, '')", .head = "T:database_to_xml/142/-1/-1;C:SELECT 1;Z:I", .rows = &.{"<w5_privileges_probe xmlns:xsi=\"http:\\/\\/www.w3.org\\/2001\\/XMLSchema-instance\">\\x0a\\x0a<hidden>\\x0a\\x0a<h>\\x0a\\x0a<\\/h>\\x0a\\x0a<\\/hidden>\\x0a\\x0a<public>\\x0a\\x0a<t1>\\x0a\\x0a<row>\\x0a  <a>1<\\/a>\\x0a<\\/row>\\x0a\\x0a<\\/t1>\\x0a\\x0a<\\/public>\\x0a\\x0a<\\/w5_privileges_probe>\\x0a"} },
        .{ .source = "RESET ROLE", .head = "C:RESET;Z:I", .rows = &.{} },
        .{ .source = "DROP TABLE hidden.h", .head = "C:DROP TABLE;Z:I", .rows = &.{} },
        .{ .source = "DROP SCHEMA hidden", .head = "C:DROP SCHEMA;Z:I", .rows = &.{} },
        .{ .source = "DROP TABLE t1", .head = "C:DROP TABLE;Z:I", .rows = &.{} },
        .{ .source = "DROP TABLE t2", .head = "C:DROP TABLE;Z:I", .rows = &.{} },
        .{ .source = "DROP ROLE w5p_r", .head = "C:DROP ROLE;Z:I", .rows = &.{} },
    } },
    .{ .name = "information_schema_grants", .statements = &.{
        .{ .source = "CREATE ROLE w5p_a", .head = "C:CREATE ROLE;Z:I", .rows = &.{} },
        .{ .source = "CREATE ROLE w5p_b", .head = "C:CREATE ROLE;Z:I", .rows = &.{} },
        .{ .source = "CREATE ROLE w5p_c", .head = "C:CREATE ROLE;Z:I", .rows = &.{} },
        .{ .source = "CREATE TABLE t(a INT PRIMARY KEY, b INT, c INT)", .head = "C:CREATE TABLE;Z:I", .rows = &.{} },
        .{ .source = "CREATE TABLE u(x INT REFERENCES t(a), y INT)", .head = "C:CREATE TABLE;Z:I", .rows = &.{} },
        .{ .source = "GRANT SELECT, UPDATE ON t TO w5p_a WITH GRANT OPTION", .head = "C:GRANT;Z:I", .rows = &.{} },
        .{ .source = "GRANT SELECT (a, b) ON t TO w5p_a", .head = "C:GRANT;Z:I", .rows = &.{} },
        .{ .source = "GRANT INSERT (c), REFERENCES (a) ON t TO w5p_b", .head = "C:GRANT;Z:I", .rows = &.{} },
        .{ .source = "GRANT UPDATE ON u TO w5p_b", .head = "C:GRANT;Z:I", .rows = &.{} },
        .{ .source = "GRANT UPDATE (y) ON u TO w5p_b", .head = "C:GRANT;Z:I", .rows = &.{} },
        .{ .source = "SET ROLE w5p_a", .head = "C:SET;Z:I", .rows = &.{} },
        .{ .source = "GRANT SELECT ON t TO w5p_c", .head = "C:GRANT;Z:I", .rows = &.{} },
        .{ .source = "GRANT UPDATE (b) ON t TO w5p_c WITH GRANT OPTION", .head = "E:0LP01;Z:I", .rows = &.{} },
        .{ .source = "RESET ROLE", .head = "C:RESET;Z:I", .rows = &.{} },
        .{ .source = "SELECT grantor, grantee, table_name, privilege_type, is_grantable, with_hierarchy FROM information_schema.table_privileges WHERE table_schema = 'public' ORDER BY table_name, grantee, grantor, privilege_type", .head = "T:grantor/19/64/-1,grantee/19/64/-1,table_name/19/64/-1,privilege_type/1043/-1/-1,is_grantable/1043/-1/7,with_hierarchy/1043/-1/7;C:SELECT 18;Z:I", .rows = &.{"ramsql|ramsql|t|DELETE|YES|NO", "ramsql|ramsql|t|INSERT|YES|NO", "ramsql|ramsql|t|REFERENCES|YES|NO", "ramsql|ramsql|t|SELECT|YES|YES", "ramsql|ramsql|t|TRIGGER|YES|NO", "ramsql|ramsql|t|TRUNCATE|YES|NO", "ramsql|ramsql|t|UPDATE|YES|NO", "ramsql|w5p_a|t|SELECT|YES|YES", "ramsql|w5p_a|t|UPDATE|YES|NO", "w5p_a|w5p_c|t|SELECT|NO|YES", "ramsql|ramsql|u|DELETE|YES|NO", "ramsql|ramsql|u|INSERT|YES|NO", "ramsql|ramsql|u|REFERENCES|YES|NO", "ramsql|ramsql|u|SELECT|YES|YES", "ramsql|ramsql|u|TRIGGER|YES|NO", "ramsql|ramsql|u|TRUNCATE|YES|NO", "ramsql|ramsql|u|UPDATE|YES|NO", "ramsql|w5p_b|u|UPDATE|NO|NO"} },
        .{ .source = "SELECT grantor, grantee, table_name, column_name, privilege_type, is_grantable FROM information_schema.column_privileges WHERE table_schema = 'public' AND grantee LIKE 'w5p%' ORDER BY table_name, column_name, grantee, grantor, privilege_type, is_grantable", .head = "T:grantor/19/64/-1,grantee/19/64/-1,table_name/19/64/-1,column_name/19/64/-1,privilege_type/1043/-1/-1,is_grantable/1043/-1/7;C:SELECT 15;Z:I", .rows = &.{"ramsql|w5p_a|t|a|SELECT|NO", "ramsql|w5p_a|t|a|SELECT|YES", "ramsql|w5p_a|t|a|UPDATE|YES", "ramsql|w5p_b|t|a|REFERENCES|NO", "w5p_a|w5p_c|t|a|SELECT|NO", "ramsql|w5p_a|t|b|SELECT|NO", "ramsql|w5p_a|t|b|SELECT|YES", "ramsql|w5p_a|t|b|UPDATE|YES", "w5p_a|w5p_c|t|b|SELECT|NO", "ramsql|w5p_a|t|c|SELECT|YES", "ramsql|w5p_a|t|c|UPDATE|YES", "ramsql|w5p_b|t|c|INSERT|NO", "w5p_a|w5p_c|t|c|SELECT|NO", "ramsql|w5p_b|u|x|UPDATE|NO", "ramsql|w5p_b|u|y|UPDATE|NO"} },
        .{ .source = "SELECT table_name, column_name, count(*) FROM information_schema.column_privileges WHERE table_schema = 'public' GROUP BY 1, 2 ORDER BY 1, 2", .head = "T:table_name/19/64/-1,column_name/19/64/-1,count/20/8/-1;C:SELECT 5;Z:I", .rows = &.{"t|a|9", "t|b|8", "t|c|8", "u|x|5", "u|y|5"} },
        .{ .source = "SELECT attname, attacl FROM pg_attribute WHERE attrelid = 't'::regclass AND attnum > 0 ORDER BY attnum", .head = "T:attname/19/64/-1,attacl/1034/-1/-1;C:SELECT 3;Z:I", .rows = &.{"a|{w5p_a=r\\/ramsql\\,w5p_b=x\\/ramsql}", "b|{w5p_a=r\\/ramsql}", "c|{w5p_b=a\\/ramsql}"} },
        .{ .source = "SET ROLE w5p_b", .head = "C:SET;Z:I", .rows = &.{} },
        .{ .source = "SELECT table_name, table_type FROM information_schema.tables WHERE table_schema = 'public' ORDER BY 1", .head = "T:table_name/19/64/-1,table_type/1043/-1/-1;C:SELECT 2;Z:I", .rows = &.{"t|BASE TABLE", "u|BASE TABLE"} },
        .{ .source = "SELECT table_name, column_name FROM information_schema.columns WHERE table_schema = 'public' ORDER BY 1, 2", .head = "T:table_name/19/64/-1,column_name/19/64/-1;C:SELECT 4;Z:I", .rows = &.{"t|a", "t|c", "u|x", "u|y"} },
        .{ .source = "SELECT constraint_name, table_name, constraint_type FROM information_schema.table_constraints WHERE table_schema = 'public' ORDER BY 1", .head = "T:constraint_name/19/64/-1,table_name/19/64/-1,constraint_type/1043/-1/-1;C:SELECT 3;Z:I", .rows = &.{"t_a_not_null|t|CHECK", "t_pkey|t|PRIMARY KEY", "u_x_fkey|u|FOREIGN KEY"} },
