    .{ .name = "duplicates_and_discovery", .statements = &.{
        .{ .source = "CREATE ROLE w5p_a", .head = "C:CREATE ROLE;Z:I", .rows = &.{} },
        .{ .source = "CREATE ROLE w5p_b", .head = "C:CREATE ROLE;Z:I", .rows = &.{} },
        .{ .source = "CREATE TABLE t(x INT, y INT)", .head = "C:CREATE TABLE;Z:I", .rows = &.{} },
        .{ .source = "GRANT SELECT ON t, t TO w5p_a, w5p_a", .head = "C:GRANT;Z:I", .rows = &.{} },
        .{ .source = "GRANT USAGE ON SCHEMA public, public TO w5p_a", .head = "C:GRANT;Z:I", .rows = &.{} },
        .{ .source = "SELECT relacl FROM pg_class WHERE relname = 't'", .head = "T:relacl/1034/-1/-1;C:SELECT 1;Z:I", .rows = &.{"{ramsql=arwdDxtm\\/ramsql\\,w5p_a=r\\/ramsql}"} },
        .{ .source = "SELECT nspacl FROM pg_namespace WHERE nspname = 'public'", .head = "T:nspacl/1034/-1/-1;C:SELECT 1;Z:I", .rows = &.{"{pg_database_owner=UC\\/pg_database_owner\\,=U\\/pg_database_owner\\,w5p_a=U\\/pg_database_owner}"} },
        .{ .source = "SELECT grantor, grantee, privilege_type::text, is_grantable::text FROM information_schema.table_privileges WHERE table_name = 't' ORDER BY grantee, privilege_type", .head = "T:grantor/19/64/-1,grantee/19/64/-1,privilege_type/25/-1/-1,is_grantable/25/-1/-1;C:SELECT 8;Z:I", .rows = &.{"ramsql|ramsql|DELETE|YES", "ramsql|ramsql|INSERT|YES", "ramsql|ramsql|REFERENCES|YES", "ramsql|ramsql|SELECT|YES", "ramsql|ramsql|TRIGGER|YES", "ramsql|ramsql|TRUNCATE|YES", "ramsql|ramsql|UPDATE|YES", "ramsql|w5p_a|SELECT|NO"} },
        .{ .source = "GRANT UPDATE (y) ON t TO w5p_b", .head = "C:GRANT;Z:I", .rows = &.{} },
        .{ .source = "SET ROLE w5p_b", .head = "C:SET;Z:I", .rows = &.{} },
        .{ .source = "SELECT table_name FROM information_schema.tables WHERE table_name = 't'", .head = "T:table_name/19/64/-1;C:SELECT 1;Z:I", .rows = &.{"t"} },
        .{ .source = "RESET ROLE", .head = "C:RESET;Z:I", .rows = &.{} },
        .{ .source = "REVOKE USAGE ON SCHEMA public FROM w5p_a", .head = "C:REVOKE;Z:I", .rows = &.{} },
        .{ .source = "DROP TABLE t", .head = "C:DROP TABLE;Z:I", .rows = &.{} },
