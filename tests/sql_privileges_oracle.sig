        .{ .source = "CREATE TABLE t(a INT)", .head = "C:CREATE TABLE;Z:I", .rows = &.{} },
        .{ .source = "GRANT SELECT ON t TO w5p_a", .head = "C:GRANT;Z:I", .rows = &.{} },
        .{ .source = "GRANT w5p_a TO w5p_b WITH ADMIN OPTION", .head = "C:GRANT ROLE;Z:I", .rows = &.{} },
        .{ .source = "SET ROLE w5p_b", .head = "C:SET;Z:I", .rows = &.{} },
        .{ .source = "GRANT w5p_a TO w5p_c", .head = "C:GRANT ROLE;Z:I", .rows = &.{} },
        .{ .source = "GRANT w5p_a TO w5p_c", .head = "N:00000:role \"w5p_c\" has already been granted membership in role \"w5p_a\" by role \"w5p_b\";C:GRANT ROLE;Z:I", .rows = &.{} },
        .{ .source = "GRANT w5p_a TO w5p_d WITH ADMIN OPTION", .head = "C:GRANT ROLE;Z:I", .rows = &.{} },
        .{ .source = "RESET ROLE", .head = "C:RESET;Z:I", .rows = &.{} },
        .{ .source = "GRANT w5p_a TO w5p_c", .head = "C:GRANT ROLE;Z:I", .rows = &.{} },
        .{ .source = "SELECT r.rolname, m.rolname, g.rolname, a.admin_option, a.inherit_option, a.set_option FROM pg_auth_members a JOIN pg_roles r ON r.oid = a.roleid JOIN pg_roles m ON m.oid = a.member JOIN pg_roles g ON g.oid = a.grantor WHERE r.rolname LIKE 'w5p%' ORDER BY m.rolname, g.rolname", .head = "T:rolname/19/64/-1,rolname/19/64/-1,rolname/19/64/-1,admin_option/16/1/-1,inherit_option/16/1/-1,set_option/16/1/-1;C:SELECT 4;Z:I", .rows = &.{"w5p_a|w5p_b|ramsql|t|t|t", "w5p_a|w5p_c|ramsql|f|t|t", "w5p_a|w5p_c|w5p_b|f|t|t", "w5p_a|w5p_d|w5p_b|t|t|t"} },
        .{ .source = "REVOKE w5p_a FROM w5p_c GRANTED BY w5p_b", .head = "C:REVOKE ROLE;Z:I", .rows = &.{} },
        .{ .source = "REVOKE w5p_a FROM w5p_d", .head = "N:01000:role \"w5p_d\" has not been granted membership in role \"w5p_a\" by role \"ramsql\";C:REVOKE ROLE;Z:I", .rows = &.{} },
        .{ .source = "SET ROLE w5p_c", .head = "C:SET;Z:I", .rows = &.{} },
        .{ .source = "SELECT count(*) FROM t", .head = "T:count/20/8/-1;C:SELECT 1;Z:I", .rows = &.{"0"} },
        .{ .source = "RESET ROLE", .head = "C:RESET;Z:I", .rows = &.{} },
        .{ .source = "REVOKE w5p_a FROM w5p_b", .head = "E:2BP01;Z:I", .rows = &.{} },
        .{ .source = "REVOKE ADMIN OPTION FOR w5p_a FROM w5p_b CASCADE", .head = "C:REVOKE ROLE;Z:I", .rows = &.{} },
        .{ .source = "SELECT r.rolname, m.rolname, g.rolname, a.admin_option, a.inherit_option, a.set_option FROM pg_auth_members a JOIN pg_roles r ON r.oid = a.roleid JOIN pg_roles m ON m.oid = a.member JOIN pg_roles g ON g.oid = a.grantor WHERE r.rolname LIKE 'w5p%' ORDER BY m.rolname, g.rolname", .head = "T:rolname/19/64/-1,rolname/19/64/-1,rolname/19/64/-1,admin_option/16/1/-1,inherit_option/16/1/-1,set_option/16/1/-1;C:SELECT 2;Z:I", .rows = &.{"w5p_a|w5p_b|ramsql|f|t|t", "w5p_a|w5p_c|ramsql|f|t|t"} },
        .{ .source = "REVOKE INHERIT OPTION FOR w5p_a FROM w5p_c", .head = "C:REVOKE ROLE;Z:I", .rows = &.{} },
        .{ .source = "REVOKE SET OPTION FOR w5p_a FROM w5p_b", .head = "C:REVOKE ROLE;Z:I", .rows = &.{} },
        .{ .source = "SELECT r.rolname, m.rolname, g.rolname, a.admin_option, a.inherit_option, a.set_option FROM pg_auth_members a JOIN pg_roles r ON r.oid = a.roleid JOIN pg_roles m ON m.oid = a.member JOIN pg_roles g ON g.oid = a.grantor WHERE r.rolname LIKE 'w5p%' ORDER BY m.rolname, g.rolname", .head = "T:rolname/19/64/-1,rolname/19/64/-1,rolname/19/64/-1,admin_option/16/1/-1,inherit_option/16/1/-1,set_option/16/1/-1;C:SELECT 2;Z:I", .rows = &.{"w5p_a|w5p_b|ramsql|f|t|f", "w5p_a|w5p_c|ramsql|f|f|t"} },
        .{ .source = "SET ROLE w5p_c", .head = "C:SET;Z:I", .rows = &.{} },
        .{ .source = "SELECT count(*) FROM t", .head = "E:42501;Z:I", .rows = &.{} },
        .{ .source = "RESET ROLE", .head = "C:RESET;Z:I", .rows = &.{} },
        .{ .source = "SET ROLE w5p_b", .head = "C:SET;Z:I", .rows = &.{} },
        .{ .source = "SET ROLE w5p_a", .head = "C:SET;Z:I", .rows = &.{} },
        .{ .source = "RESET ROLE", .head = "C:RESET;Z:I", .rows = &.{} },
        .{ .source = "SELECT pg_has_role('w5p_c', 'w5p_a', 'MEMBER'), pg_has_role('w5p_c', 'w5p_a', 'USAGE'), pg_has_role('w5p_b', 'w5p_a', 'SET'), pg_has_role('w5p_b', 'w5p_a', 'MEMBER WITH ADMIN OPTION')", .head = "T:pg_has_role/16/1/-1,pg_has_role/16/1/-1,pg_has_role/16/1/-1,pg_has_role/16/1/-1;C:SELECT 1;Z:I", .rows = &.{"t|f|f|f"} },
        .{ .source = "GRANT w5p_a TO w5p_c GRANTED BY w5p_d", .head = "E:42501;Z:I", .rows = &.{} },
        .{ .source = "GRANT pg_database_owner TO w5p_c", .head = "E:0A000;Z:I", .rows = &.{} },
        .{ .source = "GRANT w5p_a TO pg_database_owner", .head = "E:0A000;Z:I", .rows = &.{} },
        .{ .source = "REVOKE w5p_a FROM w5p_c CASCADE", .head = "C:REVOKE ROLE;Z:I", .rows = &.{} },
        .{ .source = "DROP TABLE t", .head = "C:DROP TABLE;Z:I", .rows = &.{} },
