pub const contract_mixed_battery = [_][2][]const u8{
    .{ "SELECT to_tsvector('The Fat Rats'), plainto_tsquery('the rats'), current_setting('default_text_search_config')", "'fat':2 'rat':3|'rat'|pg_catalog.english" },
    .{ "SHOW default_text_search_config", "pg_catalog.english" },
    .{ "SELECT to_tsvector('english', 'Water, water, every where, And all the boards did shrink; Water, water, every where, Nor any drop to drink. Day after day, day after day, We stuck, nor breath nor motion; As idle as a painted ship Upon a painted ocean.') @@ to_tsquery('english', 'painted <-> ships & drinking')", "t" },
    .{ "SELECT * FROM jsonb_path_query('{\"a\": [1, {\"b\": \"abc\"}, \"xyz\"]}', 'strict $.a[*] ? (@ like_regex \"^x\" || @.b like_regex \"b\")') WITH ORDINALITY", "{\"b\": \"abc\"}|1;\"xyz\"|2" },
    .{ "SELECT jsonb_path_query_array('[\"ab\", \"Ab\", \"aB\", \"ba\", \"abab\", \"xaby\", \"AB\"]', '$[*] ? (@ like_regex \"^a.*b$\" flag \"i\")')", "[\"ab\", \"Ab\", \"aB\", \"abab\", \"AB\"]" },
    .{ "SELECT JSON_VALUE(jsonb '{\"a\": \"abcdef\"}', '$.a' RETURNING varchar(3)), JSON_QUERY(jsonb '{\"a\": [1]}', '$.a'), JSON_EXISTS(jsonb '{\"a\": 1}', '$.a'), '{}' IS JSON OBJECT", "NULL|[1]|t|t" },
    .{ "SELECT JSON_OBJECT('a' VALUE 1), JSON_ARRAY(1, 2 RETURNING jsonb), JSON_SCALAR(1), JSON_SERIALIZE('[1]')", "{\"a\" : 1}|[1, 2]|1|[1]" },
    .{ "CREATE TABLE tj(id INT PRIMARY KEY, doc JSONB, v TSVECTOR, t TEXT, j JSON)", "" },
    .{ "INSERT INTO tj VALUES (1, '{\"name\": \"Ada\", \"tags\": [\"x\", \"y\"], \"n\": 3}', to_tsvector('english', 'The quick brown foxes jumped'), 'elan', JSON_OBJECT('k' VALUE 1))", "" },
    .{ "INSERT INTO tj VALUES (2, '{\"name\": \"Bob\", \"tags\": [], \"n\": \"x\"}', to_tsvector('Running dogs'), 'x', JSON_ARRAY(1, NULL NULL ON NULL))", "" },
    .{ "INSERT INTO tj SELECT 2 + ordinality::int, jsonb_path_query_first(doc, '$.tags'), to_tsvector('simple', value #>> '{}'), JSON_VALUE(value, '$'), JSON_ARRAY(value) FROM tj, jsonb_path_query(doc, '$.tags[*]') WITH ORDINALITY WHERE id = 1", "!42703" },
    .{ "UPDATE tj SET t = JSON_VALUE(doc, '$.n' RETURNING int DEFAULT -1 ON ERROR)::text WHERE id = 2", "" },
    .{ "SELECT id, doc, v, t, j FROM tj ORDER BY id", "1|{\"n\": 3, \"name\": \"Ada\", \"tags\": [\"x\", \"y\"]}|'brown':3 'fox':4 'jump':5 'quick':2|elan|{\"k\" : 1};2|{\"n\": \"x\", \"name\": \"Bob\", \"tags\": []}|'dog':2 'run':1|-1|[1, null]" },
    .{ "SELECT JSON_OBJECTAGG(t VALUE id) FILTER (WHERE id = 1), JSON_ARRAYAGG(id ORDER BY id DESC RETURNING jsonb), json_agg_strict(NULLIF(id, 2) ORDER BY id) FROM tj", "{ \"elan\" : 1 }|[2, 1]|[1]" },
    .{ "SELECT id FROM tj WHERE v @@ to_tsquery('english', 'jumping & fox') OR v @@ 'dog'", "1;2" },
    .{ "SELECT id FROM tj WHERE doc IS JSON OBJECT WITH UNIQUE KEYS AND JSON_EXISTS(doc, '$.tags ? (@ like_regex \"x\")') ORDER BY id", "1" },
    .{ "SET default_text_search_config = 'simple'", "" },
